# Normalise text files to LF in the repository; each checkout uses the platform's line endings.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.slnx    text
*.props   text
*.md      text
*.json    text

# Binary test data: QuickDraw pictures, screenshots, fonts.
*.pict    binary
*.pct     binary
*.png     binary
*.rsrc    binary

# Binary test data: resource forks and containers.
*.rsrc    binary
*.bin     binary
*.hqx     binary
*.dsk     binary
*.img     binary
*.png     binary
*.wav     binary

# Golden decoder outputs are compared byte for byte: never convert their line endings.
tests/ClassicMac.Resources.Decoders.Tests/Golden/** -text

# Original-application archives and their source forks: byte for byte.
tests/ClassicMac.Files.Tests/TestData/StuffIt151/** -text
