    <Compile Include="..\ClassicMac.Files.Tests\Fixtures.cs" Link="Builders\Fixtures.cs" />
    <Compile Include="..\ClassicMac.Files.Tests\MacPathFixtures.cs" Link="Builders\MacPathFixtures.cs" />
    <Compile Include="..\ClassicMac.Files.Tests\AliasBuilder.cs" Link="Builders\AliasBuilder.cs" />
    <Compile Include="..\ClassicMac.Files.Tests\AliasFixtures.cs" Link="Builders\AliasFixtures.cs" />
    <Compile Include="..\ClassicMac.Files.Tests\NdifBuilder.cs" Link="Builders\NdifBuilder.cs" />
    <Compile Include="..\ClassicMac.Resources.Decoders.Tests\DocumentFixtures.cs" Link="Builders\DocumentFixtures.cs" />
    <Compile Include="..\ClassicMac.Resources.Decoders.Tests\MacWordFixtures.cs" Link="Builders\MacWordFixtures.cs" />
    <Compile Include="..\ClassicMac.Resources.Decoders.Tests\CodeFixtures.cs" Link="Builders\CodeFixtures.cs" />
    <Compile Include="..\ClassicMac.Resources.Decoders.Tests\XlsxBuilder.cs" Link="Builders\XlsxBuilder.cs" />
    <Compile Include="..\ClassicMac.Code.Tests\PefBuilder.cs" Link="Builders\PefBuilder.cs" />
    <Compile Include="..\ClassicMac.Files.Tests\HfsPlusBuilder.cs" Link="Builders\HfsPlusBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClassicMac.Cli\ClassicMac.Cli.csproj" />
    <ProjectReference Include="..\..\tools\Fuzz\Fuzz.csproj" />
  </ItemGroup>

</Project>
