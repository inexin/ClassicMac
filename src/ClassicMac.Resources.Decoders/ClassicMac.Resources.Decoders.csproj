<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Packed inside the ClassicMac.Formats package (src/ClassicMac.Formats), not on its own. -->
    <IsPackable>false</IsPackable>
    <!-- Its symbols travel inside the DLL: a package that carries other projects' assemblies has no symbol package. -->
    <DebugType>embedded</DebugType>
    <Description>Decoders that turn classic Mac OS resources and documents into modern files for ClassicMac's exporter: pictures, icons, cursors and patterns (PNG or WebP), sounds (WAV), text and styled text (UTF-8, RTF, JSON), fonts (PNG strikes, TrueType), dialogs, menus and Finder windows drawn as the Mac drew them, DOCMaker, SimpleText and Word documents (HTML), code listings, and resource templates.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassicMac.Resources\ClassicMac.Resources.csproj" />
    <ProjectReference Include="..\ClassicMac.Graphics\ClassicMac.Graphics.csproj" />
    <ProjectReference Include="..\ClassicMac.Code\ClassicMac.Code.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TCDB's records as ClassicMac's TSV, gzipped (tools/TcdbData; docs/formats/resources/finder.md §2.6). -->
    <EmbeddedResource Include="Finder\tcdb.tsv.gz" LogicalName="ClassicMac.Resources.Decoders.Finder.tcdb.tsv.gz" Condition="Exists('Finder\tcdb.tsv.gz')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClassicMac.Resources.Decoders.Tests" />
    <InternalsVisibleTo Include="ClassicMac.Graphics.Tests" />
  </ItemGroup>

</Project>
