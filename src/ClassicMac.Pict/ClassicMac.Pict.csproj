<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ClassicMac.Pict</PackageId>
    <Description>Reader and writer for Apple QuickDraw PICT pictures (version 1, 2 and extended 2): PictReader plays a picture through ClassicMac.QuickDraw into an RGBA bitmap; PictWriter writes indexed, 16-bit and 32-bit pictures with resolution and ICC profiles.</Description>
    <PackageTags>macintosh;classic-mac;pict;quickdraw;image;decoder;encoder</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassicMac.Graphics\ClassicMac.Graphics.csproj" />
    <ProjectReference Include="..\ClassicMac.QuickTime\ClassicMac.QuickTime.csproj" />
    <ProjectReference Include="..\ClassicMac.QuickDraw\ClassicMac.QuickDraw.csproj" />
  </ItemGroup>

  <!-- Until the renderer has a public drawing API (the merge's stage 3), the layers above share internals. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ClassicMac.ImageSharp" />
    <InternalsVisibleTo Include="ClassicMac.SkiaSharp" />
    <InternalsVisibleTo Include="ClassicMac.Pict.Tests" />
  </ItemGroup>

</Project>
