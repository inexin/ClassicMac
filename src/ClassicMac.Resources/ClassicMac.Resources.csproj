<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ClassicMac.Resources</PackageId>
    <Description>Dependency-free reader and writer for classic Mac OS resource forks, as the Resource Manager reads and compacts them: the System's compressed-resource decompressors (dcmp 0-3), edits with undo, export to files with a JSON manifest and back, and Rez and DeRez.</Description>
    <PackageTags>macintosh;classic-mac;resource-fork;rsrc;dcmp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassicMac.Core\ClassicMac.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClassicMac.Resources.Tests" />
  </ItemGroup>

</Project>
