<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClassicMac.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <!-- The bundled fonts (AppFonts; design/TOKENS.md "Type"). -->
    <FontFamily x:Key="CmFontSans">avares://ClassicMac/Assets/Fonts#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="CmFontMono">avares://ClassicMac/Assets/Fonts#IBM Plex Mono</FontFamily>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
