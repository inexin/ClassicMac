<!--
  The Details tab (boards/details.md, P4): a two-column grid of cards, the full-width chain card under it, Copy all in
  the header.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClassicMac.App.ViewModels"
             xmlns:controls="using:ClassicMac.App.Controls"
             x:Class="ClassicMac.App.Views.DetailsTab"
             x:DataType="vm:MainViewModel">
  <ScrollViewer x:Name="DetailsScroll" Padding="16,12">
    <ScrollViewer.Resources>
      <DataTemplate x:Key="DetailCard" DataType="vm:DetailGroup">
        <Border Classes="detail-card" Margin="7">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="detail-card-header">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasVolume}">
                  <Button Classes="link" Padding="0" Content="Defragment…" FontSize="{DynamicResource CmFontSizeMeta}"
                          IsVisible="{Binding Volume.CanDefragment, FallbackValue=False}"
                          Command="{Binding $parent[TabItem].((vm:MainViewModel)DataContext).VolumeActions.DefragmentCommand, FallbackValue={x:Null}}" />
                  <Button Classes="link" Padding="0" Content="First Aid…" FontSize="{DynamicResource CmFontSizeMeta}"
                          Command="{Binding $parent[TabItem].((vm:MainViewModel)DataContext).VolumeActions.FirstAidCommand, FallbackValue={x:Null}}" />
                </StackPanel>
                <TextBlock Classes="caption" Text="{Binding Caption}" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <StackPanel Classes="detail-rows">
              <StackPanel Spacing="6" IsVisible="{Binding HasVolume}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock TextTrimming="CharacterEllipsis">
                    <Run FontWeight="{DynamicResource CmFontWeightStrong}" Text="{Binding Volume.Size, FallbackValue={x:Null}}" />
                    <Run Text=" " /><Run Text="{Binding Volume.Kind, FallbackValue={x:Null}}" />
                  </TextBlock>
                  <TextBlock Grid.Column="1" Classes="mono muted" Margin="8,0,0,0" FontSize="{DynamicResource CmFontSizeMeta}"
                             Text="{Binding Volume.FreeText, FallbackValue={x:Null}}" VerticalAlignment="Center" />
                </Grid>
                <controls:ShareBar Classes="volume-bar" Value="{Binding Volume.UsedShare, FallbackValue=0}"
                                   AutomationProperties.Name="{Binding Volume.UsedLabel, FallbackValue={x:Null}}" />
                <StackPanel Spacing="6" IsVisible="{Binding HasMap}" Margin="0,6,0,0">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Classes="muted" Text="Where the free space lies" VerticalAlignment="Top" />
                    <TextBlock Classes="mono muted" Margin="8,1,0,0" FontSize="{DynamicResource CmFontSizeMeta}" TextAlignment="Right" TextWrapping="Wrap"
                               Text="{Binding Volume.RunsText, FallbackValue={x:Null}}" />
                  </DockPanel>
                  <controls:AllocationMap x:Name="AllocationMap" Classes="volume-map" Layout="{Binding Volume.Layout, FallbackValue={x:Null}}" />
                  <WrapPanel Classes="map-legend">
                    <StackPanel Orientation="Horizontal"><Border Classes="swatch used" /><TextBlock Text="Used" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Classes="swatch split" /><TextBlock Text="Split file" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Classes="swatch partial" /><TextBlock Text="Partly free" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Classes="swatch free" /><TextBlock Text="Free" /></StackPanel>
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
              <ItemsControl Classes="flags" ItemsSource="{Binding Flags}" IsVisible="{Binding HasFlags}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:FinderFlagChip">
                    <Panel Classes="chip" Classes.set="{Binding IsSet}" Classes.unset="{Binding !IsSet}">
                      <Border />
                      <Rectangle />
                      <TextBlock Text="{Binding Name}" />
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel IsVisible="{Binding HasChain}">
                <Panel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,2,0,0">
                  <TextBlock Classes="muted problems" FontSize="{DynamicResource CmFontSizeMeta}"
                             Text="{Binding $parent[TabItem].((vm:MainViewModel)DataContext).Details.ProblemsText, FallbackValue={x:Null}}"
                             IsVisible="{Binding !$parent[TabItem].((vm:MainViewModel)DataContext).Details.HasProblems, FallbackValue=False}" />
                  <Button Classes="link problems" Padding="0" FontSize="{DynamicResource CmFontSizeMeta}"
                          Content="{Binding $parent[TabItem].((vm:MainViewModel)DataContext).Details.ProblemsText, FallbackValue={x:Null}}"
                          IsVisible="{Binding $parent[TabItem].((vm:MainViewModel)DataContext).Details.HasProblems, FallbackValue=False}"
                          Command="{Binding $parent[TabItem].((vm:MainViewModel)DataContext).DetailsActions.ShowProblemsCommand, FallbackValue={x:Null}}"
                          ToolTip.Tip="Show them in the diagnostics" />
                </Panel>
                <ItemsControl Classes="chain" ItemsSource="{Binding Chain}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ReadStep">
                      <StackPanel Orientation="Horizontal">
                        <Panel Classes="chip step" Classes.last="{Binding IsLast}">
                          <Border />
                          <SelectableTextBlock Text="{Binding Text}" Margin="8,2" FontSize="{DynamicResource CmFontSizeMeta}" />
                        </Panel>
                        <TextBlock Classes="muted" Text="→" Margin="0,2,6,0" IsVisible="{Binding !IsLast}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Rows}" Classes.volume="{Binding HasVolume}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:DetailRow">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                      <TextBlock Text="{Binding Label}" Classes="muted row-label" />
                      <StackPanel Grid.Column="1" Spacing="4">
                        <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" Classes.mono="{Binding Mono}" Classes.muted="{Binding Muted}" IsVisible="{Binding !Link}" />
                        <Button Classes="link in" Padding="0" FontSize="{DynamicResource CmFontSizeBody}" HorizontalAlignment="Left" Content="{Binding Value}" IsVisible="{Binding Link}"
                                Command="{Binding $parent[TabItem].((vm:MainViewModel)DataContext).DetailsActions.GoToInCommand, FallbackValue={x:Null}}"
                                ToolTip.Tip="Select it in the tree" />
                        <controls:ShareBar Classes="fork-bar" Value="{Binding Bar, FallbackValue=0}" IsVisible="{Binding HasBar}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap"
                         FontSize="{DynamicResource CmFontSizeMeta}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </DataTemplate>
    </ScrollViewer.Resources>
    <StackPanel Spacing="4">
      <DockPanel Margin="0,0,0,4">
        <Button x:Name="CopyDetails" DockPanel.Dock="Right" Content="Copy all" Command="{Binding DetailsActions.CopyDetailsCommand}"
                VerticalAlignment="Center" ToolTip.Tip="Copy the details as plain text" />
        <TextBlock Text="{Binding Details.Heading}" FontSize="{DynamicResource CmFontSizeHeading}"
                   FontWeight="{DynamicResource CmFontWeightStrong}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
      <ItemsControl x:Name="DetailCards" ItemsSource="{Binding Details.Cards}" ItemTemplate="{StaticResource DetailCard}" Margin="-7,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <ItemsControl x:Name="DetailWideCards" ItemsSource="{Binding Details.WideCards}" ItemTemplate="{StaticResource DetailCard}" Margin="-7,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
