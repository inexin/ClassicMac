<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClassicMac.App.ViewModels"
        xmlns:views="using:ClassicMac.App.Views"
        xmlns:editing="using:ClassicMac.Files.Editing"
        xmlns:app="using:ClassicMac.App"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="ClassicMac.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding ShellActions.WindowTitle}"
        Width="1200" Height="780" MinWidth="700" MinHeight="450"
        Icon="/Assets/icon/classicmac.ico"
        DragDrop.AllowDrop="True">

  <Window.Resources>
    <!-- With the client area extended, Avalonia 12 draws the title bar on Windows itself (the Win32 backend requests
         PlatformRequestedDrawnDecoration.TitleBar): Fluent's WindowDrawnDecorations template puts the window's Title in
         its overlay (Panel PART_TitleTextPanel), over the app's own title bar, beside its caption buttons. This theme is
         Fluent's with that title hidden: the caption buttons (minimize, maximize with snap layouts, close in red on
         hover) and the drag and resize areas stay. -->
    <ControlTheme x:Key="CmWindowDecorations" TargetType="chrome:WindowDrawnDecorations"
                  BasedOn="{StaticResource {x:Type chrome:WindowDrawnDecorations}}">
      <!-- The text, not its panel: the panel's IsVisible is a template binding (HasTitleBar), which outranks a style. -->
      <Style Selector="^ /template/ Panel#PART_TitleTextPanel > TextBlock">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ControlTheme>
  </Window.Resources>

  <Window.Styles>
    <StyleInclude Source="avares://ClassicMac/Styles/MainWindow.axaml" />
  </Window.Styles>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Shift+D" Command="{Binding DiagnosticsPanel.ToggleCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <!-- The custom title bar (S1) on Windows and macOS, where the window extends into its decorations; a drag area for
         the platform; the caption buttons are drawn over it (see CmWindowDecorations). Linux keeps the system's. -->
    <views:TitleBarView x:Name="TitleBarView" DockPanel.Dock="Top" />
    <views:MenuBarView x:Name="MenuBarView" DockPanel.Dock="Top" />

    <!-- The toolbar (design/boards/main-window.md, S2): each button follows its command's enabled state. -->
    <views:ToolbarView x:Name="ToolbarView" DockPanel.Dock="Top" />

    <!-- The status bar (boards/main-window.md, S4): the selected file's summary with its error and warning counts; on the
         right, while work runs, what it does, how far and a progress bar, else the status text. -->
    <views:StatusBarView x:Name="StatusBarView" DockPanel.Dock="Bottom" />

    <Grid x:Name="Body" RowDefinitions="*,6,196">
      <Grid ColumnDefinitions="380,5,*">
        <DockPanel>
        <Border DockPanel.Dock="Top" Classes="tree-bar" Padding="6,6,4,6" BorderThickness="0,0,0,1">
          <DockPanel>
          <Button x:Name="TreeDisplayButton" DockPanel.Dock="Right" Classes="flat" Margin="4,0,0,0" ToolTip.Tip="Tree display" AutomationProperties.Name="Tree display">
            <PathIcon Width="12" Height="12" Data="M1,2 H15 V4 H1 Z M1,7 H15 V9 H1 Z M1,12 H15 V14 H1 Z" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="tree-display">
                <StackPanel x:Name="TreeDisplayPanel" Spacing="8" MinWidth="220">
                  <TextBlock Text="Tree display" FontWeight="SemiBold" />
                  <CheckBox Content="Group files with no name" IsChecked="{Binding TreeDisplay.GroupNoName}" />
                  <CheckBox Content="Hide invisible files" IsChecked="{Binding TreeDisplay.HideInvisible}" />
                  <CheckBox Content="Show details column" IsChecked="{Binding TreeDisplay.ShowDetails}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <TextBox x:Name="TreeFilter" Classes="filter" PlaceholderText="Filter tree" Text="{Binding TreeSearch.FilterText}" AutomationProperties.Name="Filter tree">
            <TextBox.InnerLeftContent>
              <PathIcon Classes="search" Data="M6.5,1 A5.5,5.5 0 1 1 6.5,12 A5.5,5.5 0 1 1 6.5,1 Z M6.5,3 A3.5,3.5 0 1 0 6.5,10 A3.5,3.5 0 1 0 6.5,3 Z M10.2,11.6 L11.6,10.2 L15,13.6 L13.6,15 Z" />
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <TextBlock Classes="mono muted key-hint" Text="Ctrl+F" />
            </TextBox.InnerRightContent>
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Escape" Command="{Binding TreeSearch.ClearFilterCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          </DockPanel>
        </Border>
        <Border x:Name="HiddenFooter" DockPanel.Dock="Bottom" Classes="tree-bar" Padding="8,3" BorderThickness="0,1,0,0" IsVisible="{Binding HiddenSummary, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="12" Height="12" Data="M1,8 C4,3 12,3 15,8 C12,13 4,13 1,8 Z M2,13 L13,2 L14,3 L3,14 Z" />
            <TextBlock Text="{Binding HiddenSummary}" Classes="muted" VerticalAlignment="Center" />
            <Button Content="Show" Command="{Binding ShowHiddenCommand}" Classes="flat link" Padding="4,0" Cursor="Hand" />
          </StackPanel>
        </Border>
        <Panel>
        <!-- One virtualized list of the visible rows (VisibleRows), each CmRowTree high and indented by its depth. -->
        <views:BrowseTree x:Name="Tree" Classes="sidebar browse" ItemsSource="{Binding TreeRows}" SelectedItem="{Binding Selected, Mode=OneWay}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.AllowAutoHide="False">
          <ListBox.KeyBindings>
            <KeyBinding Gesture="Delete" Command="{Binding EditActions.DeleteResourceCommand}" />
          </ListBox.KeyBindings>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:NodeViewModel">
              <!-- A row (boards/browse-tree.md): the indent, the expander, then icon or spinner, name, unsaved mark, "not
                   read" chip; meta on the right. -->
              <DockPanel Classes="tree-line">
              <Border DockPanel.Dock="Left" Width="{Binding Depth, Converter={x:Static views:BrowseTree.IndentConverter}}" />
              <Panel DockPanel.Dock="Left" Classes="tree-expander-slot">
                <Border Classes="tree-expander" Classes.open="{Binding IsExpanded}" IsVisible="{Binding HasChildren}"
                        PointerPressed="OnExpanderPressed">
                  <Path Data="M 1,0 10,10 l -9,10 -1,-1 L 8,10 -0,1 z" />
                </Border>
              </Panel>
              <Panel Classes="tree-row">
                <Rectangle Classes="drag-outline" IsVisible="{Binding IsDragSource}" />
                <!-- The row fits the pane: the meta and the chip keep their width on the right, the name trims with an
                     ellipsis (a left-aligned grid: the name's star column is as wide as the name until the row is
                     full), the unsaved mark right after it. -->
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Classes="meta" Text="{Binding Meta}" ToolTip.Tip="{Binding KindTip}"
                             IsVisible="{Binding Meta, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <Panel DockPanel.Dock="Right" Classes="not-read" IsVisible="{Binding IsUnread}">
                    <Rectangle />
                    <TextBlock Text="not read" />
                  </Panel>
                  <views:TreeIcon DockPanel.Dock="Left" Margin="0,0,4,0" Node="{Binding}" IsVisible="{Binding !IsLoading}" />
                  <Panel DockPanel.Dock="Left" Margin="0,0,4,0" Classes="spinner" IsVisible="{Binding IsLoading}">
                    <Ellipse Classes="track" />
                    <Path Classes="arc" Data="M8,2 A6,6 0 0 1 14,8" />
                  </Panel>
                  <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                    <!-- A whitespace name as token chips (boards/tree-no-name.md), its bytes on hover. -->
                    <ItemsControl Classes="name-tokens" ItemsSource="{Binding NameTokens}" IsVisible="{Binding HasNameTokens}"
                                  ToolTip.Tip="{Binding NameBytes}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:NameToken">
                          <Border Classes="name-token">
                            <TextBlock Text="{Binding Label}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="name" Classes.type="{Binding IsResourceType}" Classes.loading="{Binding IsLoading}" Classes.italic="{Binding IsItalic}" Classes.broken="{Binding IsBrokenAlias}"
                               Classes.dimmed="{Binding IsDimmed}" TextTrimming="CharacterEllipsis" IsVisible="{Binding !HasNameTokens}">
                      <Run Text="{Binding NameBefore}" /><Run Classes="match" Classes.on="{Binding HasMatch}" Classes.current="{Binding IsCurrentMatch}" Text="{Binding NameMatch}" /><Run Text="{Binding NameAfter}" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" Classes="unsaved" Text=" •" IsVisible="{Binding IsUnsaved}" />
                  </Grid>
                </DockPanel>
              </Panel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="_New Resource…" Command="{Binding EditActions.NewResourceCommand}" InputGesture="Ctrl+K" />
              <MenuItem Header="_Duplicate" Command="{Binding EditActions.DuplicateResourceCommand}" InputGesture="Ctrl+D" />
              <MenuItem Header="De_lete" Command="{Binding EditActions.DeleteResourceCommand}" InputGesture="Delete" />
              <MenuItem Header="Get _Info…" Command="{Binding EditActions.GetInfoCommand}" InputGesture="Ctrl+I" />
              <MenuItem Header="Edit _Hex…" Command="{Binding EditActions.EditHexCommand}" InputGesture="Ctrl+H" />
              <MenuItem Header="_Replace Data from File…" Command="{Binding EditActions.ReplaceDataCommand}" />
              <MenuItem Header="I_mport Image or Sound…" Command="{Binding ImportActions.ImportCommand}" />
              <Separator />
              <MenuItem Header="New _File…" Command="{Binding VolumeActions.NewFileCommand}" />
              <MenuItem Header="Import File…" Command="{Binding VolumeActions.ImportFileCommand}" />
              <MenuItem Header="New F_older…" Command="{Binding VolumeActions.NewFolderCommand}" />
              <MenuItem Header="Delete File or Folder…" Command="{Binding VolumeActions.DeleteItemCommand}" />
              <Separator />
              <MenuItem Header="_Save Resource As…" Command="{Binding ExportActions.SaveResourceAsCommand}" InputGesture="Ctrl+E" />
              <MenuItem Header="_Export Resources…" Command="{Binding ExportActions.ExportResourcesCommand}" />
              <MenuItem Header="E_xtract All Resources…" Command="{Binding ExportActions.ExtractAllCommand}" />
              <MenuItem Header="_Convert Documents…" Command="{Binding ExportActions.ConvertDocumentsCommand}" />
              <Separator />
              <MenuItem Header="_Unpack (AppleDouble)…" Command="{Binding ExportActions.UnpackAppleDoubleCommand}" />
              <MenuItem Header="Unpack (_Basilisk II)…" Command="{Binding ExportActions.UnpackBasiliskCommand}" />
            </ContextMenu>
          </ListBox.ContextMenu>
        </views:BrowseTree>
        <!-- The type-ahead pill: what was typed, the matches, F3 and Esc. -->
        <Border x:Name="TypeAheadPill" Classes="type-ahead" IsVisible="{Binding TreeSearch.IsTypeAheadOpen}" VerticalAlignment="Bottom" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Classes="search" Margin="0" Data="M6.5,1 A5.5,5.5 0 1 1 6.5,12 A5.5,5.5 0 1 1 6.5,1 Z M6.5,3 A3.5,3.5 0 1 0 6.5,10 A3.5,3.5 0 1 0 6.5,3 Z M10.2,11.6 L11.6,10.2 L15,13.6 L13.6,15 Z" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="mono" Text="{Binding TreeSearch.TypeAheadText}" VerticalAlignment="Center" />
              <TextBlock Classes="mono caret" Text="|" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="muted" Text="{Binding TreeSearch.TypeAheadSummary}" VerticalAlignment="Center" />
            <Border Classes="key"><TextBlock Classes="mono muted key-hint" Text="F3" /></Border>
            <Border Classes="key"><TextBlock Classes="mono muted key-hint" Text="Esc" /></Border>
          </StackPanel>
        </Border>
        </Panel>
        </DockPanel>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

        <!-- The inspector (boards/main-window.md, S3): the selection's header, then its tabs. -->
        <DockPanel Grid.Column="2" Classes="pane">
        <views:InspectorHeaderView x:Name="InspectorHeaderView" DockPanel.Dock="Top" />
        <TabControl Classes="pane inspector" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Padding="0">
          <TabItem Header="Details">
            <!-- The Details tab (design/boards/details.md, P4): a two-column grid of cards, the full-width chain card
                 under it, Copy all in the header. -->
            <views:DetailsTab x:Name="DetailsTab" />
          </TabItem>

          <TabItem Header="Preview">
            <Panel>
            <DockPanel IsVisible="{Binding !FormEditing.ShowsForm}">
              <!-- An alias previews its original under this strip (docs/formats/resources/aliases.md §5). -->
              <Border x:Name="AliasStripBar" DockPanel.Dock="Top" Classes="alias-strip" IsVisible="{Binding AliasActions.AliasStrip, Converter={x:Static ObjectConverters.IsNotNull}}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Show Original" Command="{Binding AliasActions.ShowOriginalCommand}" />
                  <TextBlock Text="{Binding AliasActions.AliasStrip}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <!-- An alias whose original is not found: what it recorded instead of a preview. -->
              <Border x:Name="AliasNotFoundCard" DockPanel.Dock="Top" Classes="detail-card alias-missing" IsVisible="{Binding AliasActions.AliasNotFound}">
                <StackPanel Spacing="4">
                  <TextBlock Classes="heading" Text="{Binding AliasActions.AliasNotFoundTitle}" />
                  <TextBlock Text="{Binding AliasActions.AliasNotFoundReason}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding AliasActions.AliasNotFoundLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="x:String">
                        <TextBlock Classes="mono muted" Text="{Binding}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Panel>
                <TextBlock Text="{Binding Preview.Message}" Margin="16" Classes="muted" IsVisible="{Binding Preview.IsMessage}" />
                <!-- The image grid (boards/main-window.md, P1): the sub-bar, then the cards cut into rows by the view-model
                     for the viewport's width, in a virtualising list so hundreds of images scroll smoothly. -->
                <views:ImagePane x:Name="ImagePane" />
                <!-- 24 on the right: the overlay scroll bar never covers the text. -->
                <!-- Mac content keeps its colours: styled text on white paper, as the Mac draws it, in both themes. -->
                <ScrollViewer x:Name="StyledTextScroller" IsVisible="{Binding Preview.IsStyledText}" Padding="16,12,24,12" Background="White">
                  <views:StyledTextView Styled="{Binding Preview.Styled}" TextWrapping="Wrap" />
                </ScrollViewer>
                <ScrollViewer IsVisible="{Binding Preview.IsPlainText}" Padding="16,12,24,12" HorizontalScrollBarVisibility="Auto">
                  <SelectableTextBlock Text="{Binding Preview.Text}" FontFamily="{StaticResource CmFontMono}" />
                </ScrollViewer>
                <!-- The property view (boards/property-view.md, P2): Properties | JSON, then the values in cards (E4's card
                     styles), or the JSON itself. -->
                <views:PropertyPane x:Name="PropertyPane" />
                <!-- A font family (boards/font-family.md, P6): Properties | JSON; the sample from the chosen strike, the
                     association matrix, the metrics, style and kerning cards. -->
                <views:FontFamilyPane x:Name="FontFamilyPane" />
                <ScrollViewer IsVisible="{Binding Preview.IsDialog}" HorizontalScrollBarVisibility="Auto" AllowAutoHide="False">
                  <views:DialogView Dialog="{Binding Preview.Dialog}" Scale="{Binding Zoom}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ScrollViewer>
                <ScrollViewer IsVisible="{Binding Preview.IsMenu}" HorizontalScrollBarVisibility="Auto" AllowAutoHide="False">
                  <views:MenuView Menu="{Binding Preview.Menu}" Scale="{Binding Zoom}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ScrollViewer>
                <!-- A page in the web view: an Apple Help page (docs/formats/resources/help-pages.md), or a document's HTML export
                     (DOCMaker, SimpleText, Word; with Back and its pages). Rendered | Source (or Text); the page in a native web
                     view (made in code, HelpWebView.cs), else its source or text with why; the status line under it. -->
                <views:WebPagePane x:Name="WebPagePane" />
                <!-- The sound preview (boards/sound.md, P3): the transport (Play/Stop, the playhead's time, Repeat the loop),
                     the detail chips, and the channel lanes with the loop band and the playhead; a click on the waveform
                     plays from there, Space plays and stops. -->
                <views:SoundPane x:Name="SoundPane" />
                <!-- A sound that cannot be decoded: what it is, why, and its bytes. -->
                <Border x:Name="SoundErrorCard" Classes="sound-error" IsVisible="{Binding Preview.IsSoundError}" VerticalAlignment="Top" HorizontalAlignment="Left">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <views:SeverityIcon Severity="Error" Width="16" Height="16" VerticalAlignment="Center" />
                      <TextBlock Classes="strong" Text="{Binding Preview.ErrorTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="muted" Text="{Binding Preview.ErrorDetail}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Show in Hex" Command="{Binding SoundPlayback.ShowInHexCommand}" />
                      <Button Content="Save raw data…" Command="{Binding SoundPlayback.SaveRawDataCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Panel>
            </DockPanel>
              <!-- The read-then-edit host (boards/read-then-edit.md, E1; FormEditing.cs): every form, read only first, then
                   in place with Cancel and Apply. Esc cancels and Ctrl+Enter applies (FormHostInput.cs); a double-click
                   on a "form-row" edits with that row selected. -->
              <views:FormHostPane x:Name="FormHostPane" />
            </Panel>
          </TabItem>

          <TabItem Header="Hex" IsVisible="{Binding HasHex}">
            <!-- The hex view (boards/hex.md, E7): the resource's bytes in a grid, edited in place with Edit Hex (Ctrl+H) or
                 Edit Bytes; while editing, the byte inspector on the right and the footer with the mode switch, status,
                 Discard and Apply. -->
            <views:HexTab x:Name="HexTab" />
          </TabItem>
        </TabControl>
        </DockPanel>

        <!-- The empty state (boards/empty-state.md, S5): over the inspector while nothing is open. -->
        <views:EmptyStateView x:Name="EmptyStateView" Grid.Column="2" />
      </Grid>

      <!-- The drag handle: a 6 px strip with a 36 x 2 grip; hidden while the panel is collapsed. -->
      <GridSplitter Grid.Row="1" Classes="handle" ResizeDirection="Rows" IsVisible="{Binding DiagnosticsPanel.IsExpanded}"
                    AutomationProperties.Name="Resize the diagnostics" />

      <!-- The diagnostics panel (design/boards/diagnostics.md): header bar, column headers, rows grouped by file. -->
      <DockPanel Grid.Row="2" DataContext="{Binding DiagnosticsPanel}" x:DataType="vm:DiagnosticsPanel">
        <Border DockPanel.Dock="Top" Classes="chrome diagnostics-header" Classes.collapsed="{Binding !IsExpanded}"
                Height="{DynamicResource CmPanelHeader}" Padding="4,0,8,0" BorderBrush="{DynamicResource CmBorder}">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Left" Classes="flat" IsChecked="{Binding IsExpanded, Mode=TwoWay}" VerticalAlignment="Center"
                          ToolTip.Tip="Show or hide the diagnostics (Ctrl+Shift+D)" AutomationProperties.Name="Diagnostics">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Classes="chevron" Width="10" Height="10" Data="M2,4 L5,7 L8,4" />
                <TextBlock Text="Diagnostics" FontWeight="{DynamicResource CmFontWeightStrong}" />
              </StackPanel>
            </ToggleButton>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0" VerticalAlignment="Center">
              <Border Classes="badge error" IsVisible="{Binding HasErrors}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <views:SeverityIcon Severity="Error" Width="12" Height="12" />
                  <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding IsExpanded}" />
                  <TextBlock Text="{Binding ErrorCount}" IsVisible="{Binding !IsExpanded}" />
                </StackPanel>
              </Border>
              <Border Classes="badge warning" IsVisible="{Binding HasWarnings}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <views:SeverityIcon Severity="Warning" Width="12" Height="12" />
                  <TextBlock Text="{Binding WarningText}" IsVisible="{Binding IsExpanded}" />
                  <TextBlock Text="{Binding WarningCount}" IsVisible="{Binding !IsExpanded}" />
                </StackPanel>
              </Border>
              <!-- Collapsed, only the error and warning numbers show. -->
              <Border Classes="badge info">
                <Border.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsExpanded" />
                    <Binding Path="HasInfos" />
                  </MultiBinding>
                </Border.IsVisible>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <views:SeverityIcon Severity="Info" Width="12" Height="12" />
                  <TextBlock Text="{Binding InfoText}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsExpanded}">
              <TextBox Width="200" Height="26" MinHeight="0" Padding="8,3" PlaceholderText="Filter messages" Text="{Binding Search, Mode=TwoWay}"
                       AutomationProperties.Name="Filter messages" />
              <ListBox Classes="segmented" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}" VerticalAlignment="Center">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:DiagnosticFilter">
                    <TextBlock Text="{Binding Converter={x:Static views:DiagnosticsLabels.Filter}}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <ToggleButton Classes="flat outlined" Content="By file" IsChecked="{Binding ByFile, Mode=TwoWay}" />
            </StackPanel>
            <!-- Collapsed with nothing open: "Nothing opened yet" (boards/empty-state.md). -->
            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Classes="muted" Text="{Binding Placeholder}">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="!IsExpanded" />
                  <Binding Path="Placeholder" Converter="{x:Static ObjectConverters.IsNotNull}" />
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <!-- Collapsed: the latest problem. -->
            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" Classes="muted">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="!IsExpanded" />
                  <Binding Path="HasLatest" />
                </MultiBinding>
              </TextBlock.IsVisible>
              <Run Text="Latest: " /><Run Text="{Binding Latest.Code, FallbackValue={x:Null}}" Foreground="{DynamicResource CmError}"
                   FontFamily="{DynamicResource CmFontMono}" /><Run Text=" " /><Run Text="{Binding LatestPlace}" />
            </TextBlock>
          </DockPanel>
        </Border>

        <!-- Column headers. -->
        <Border DockPanel.Dock="Top" Classes="pane" Height="26" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CmDivider}"
                IsVisible="{Binding IsExpanded}">
          <Grid ColumnDefinitions="110,260,210,*,90" Classes.grouped="{Binding ByFile}" Classes="diagnostic-columns">
            <Button Classes="flat" Padding="0" VerticalAlignment="Center" Command="{Binding SortBySeverityCommand}"
                    ToolTip.Tip="Sort by severity" AutomationProperties.Name="Sort by severity">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="caption" Text="SEVERITY" />
                <TextBlock Classes="caption" Text="{Binding Sort, Converter={x:Static views:DiagnosticsLabels.Sort}}" />
              </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Classes="caption" Text="SOURCE" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="caption" Text="CODE" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Classes="caption" Text="MESSAGE" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <ListBox x:Name="DiagnosticList" Classes="pane diagnostics" Classes.grouped="{Binding ByFile}" IsVisible="{Binding IsExpanded}"
                 ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:DiagnosticGroup">
              <Border Classes="sidebar diagnostic-group">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <PathIcon Classes="chevron" Classes.collapsed="{Binding !IsExpanded}" Width="10" Height="10" Data="M2,4 L5,7 L8,4" />
                  <Image Width="16" Height="16" RenderOptions.BitmapInterpolationMode="None" Source="{Binding Kind, Converter={x:Static views:TreeIcons.KindConverter}}" />
                  <TextBlock Text="{Binding Path}" FontWeight="{DynamicResource CmFontWeightStrong}" />
                  <TextBlock Text="{Binding Counts}" Classes="muted" />
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:DiagnosticEntry">
              <Border Classes="diagnostic-row">
                <Grid ColumnDefinitions="110,260,210,*,90" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <views:SeverityIcon Severity="{Binding Diagnostic.Severity}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Severity}" FontWeight="{DynamicResource CmFontWeightStrong}"
                               Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}" Classes.info="{Binding IsInfo}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Source}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="2" Classes="mono muted" Text="{Binding Code}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="3" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                  <!-- On the selected row only (style), for an entry with a node. -->
                  <Panel Grid.Column="4" IsVisible="{Binding HasNode}">
                    <Button Classes="link show-item" Content="Show item" HorizontalAlignment="Right"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowItemCommand, FallbackValue={x:Null}}"
                            CommandParameter="{Binding}" ToolTip.Tip="Select it in the tree" />
                  </Panel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
