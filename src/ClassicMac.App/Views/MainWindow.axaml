<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClassicMac.App.ViewModels"
        xmlns:views="using:ClassicMac.App.Views"
        xmlns:editing="using:ClassicMac.Files.Editing"
        xmlns:app="using:ClassicMac.App"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="ClassicMac.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1200" Height="780" MinWidth="700" MinHeight="450"
        Icon="/Assets/icon/classicmac.ico"
        DragDrop.AllowDrop="True">

  <Window.Resources>
    <!-- With the client area extended, Avalonia 12 draws the title bar on Windows itself (the Win32 backend requests
         PlatformRequestedDrawnDecoration.TitleBar): Fluent's WindowDrawnDecorations template puts the window's Title in
         its overlay (Panel PART_TitleTextPanel), over the app's own title bar, beside its caption buttons. This theme is
         Fluent's with that title hidden: the caption buttons (minimize, maximize with snap layouts, close in red on
         hover) and the drag and resize areas stay. -->
    <ControlTheme x:Key="CmWindowDecorations" TargetType="chrome:WindowDrawnDecorations"
                  BasedOn="{StaticResource {x:Type chrome:WindowDrawnDecorations}}">
      <!-- The text, not its panel: the panel's IsVisible is a template binding (HasTitleBar), which outranks a style. -->
      <Style Selector="^ /template/ Panel#PART_TitleTextPanel > TextBlock">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ControlTheme>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TreeViewItem" x:DataType="vm:NodeViewModel">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="IsVisible" Value="{Binding !IsFilteredOut}" />
    </Style>
    <!-- The tree's filter and type-ahead (boards/browse-tree.md S6): the filter field (28 high, search icon, "Ctrl+F"),
         matched letters on CmMatchSoft (CmMatch on the current match), rows that do not match dimmed to CmTextMuted,
         and the type-ahead pill at the bottom of the tree (CmPaneBackground, CmAccent border, CmShadowPopover). -->
    <Style Selector="TextBox.filter">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="4,4,6,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="PathIcon.search">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Margin" Value="8,0,2,0" />
      <Setter Property="Foreground" Value="{DynamicResource CmTextMuted}" />
    </Style>
    <Style Selector="TextBlock.key-hint">
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeCaption}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Run.match.on">
      <Setter Property="Background" Value="{DynamicResource CmMatchSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource CmText}" />
    </Style>
    <Style Selector="Run.match.on.current">
      <Setter Property="Background" Value="{DynamicResource CmMatch}" />
    </Style>
    <Style Selector="TreeView.browse TextBlock.name.dimmed">
      <Setter Property="Foreground" Value="{DynamicResource CmTextMuted}" />
    </Style>
    <Style Selector="Border.type-ahead">
      <Setter Property="Background" Value="{DynamicResource CmPaneBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CmAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="8,0,8,10" />
      <Setter Property="BoxShadow" Value="{DynamicResource CmShadowPopover}" />
    </Style>
    <Style Selector="Border.type-ahead Border.key">
      <Setter Property="BorderBrush" Value="{DynamicResource CmControlBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource CmRadiusSmall}" />
      <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style Selector="Border.type-ahead TextBlock.caret">
      <Setter Property="Foreground" Value="{DynamicResource CmAccent}" />
    </Style>
    <!-- The empty state (boards/empty-state.md S5): a centred 640 column on CmPaneBackground, the drop zone (300 high,
         2 px dashed CmControlBorder, radius 12, CmSidebarBackground; CmAccent on CmRowHighlight while a drag is over
         the window) and the Recent list. -->
    <Style Selector="Border.empty-state">
      <Setter Property="Background" Value="{DynamicResource CmPaneBackground}" />
    </Style>
    <Style Selector="Border.drop-zone">
      <Setter Property="Background" Value="{DynamicResource CmSidebarBackground}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Height" Value="300" />
    </Style>
    <Style Selector="Border.drop-zone Rectangle.dash">
      <Setter Property="Stroke" Value="{DynamicResource CmControlBorder}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeDashArray" Value="4,3" />
      <Setter Property="RadiusX" Value="12" />
      <Setter Property="RadiusY" Value="12" />
    </Style>
    <Style Selector="Border.drop-zone.active">
      <Setter Property="Background" Value="{DynamicResource CmRowHighlight}" />
    </Style>
    <Style Selector="Border.drop-zone.active Rectangle.dash">
      <Setter Property="Stroke" Value="{DynamicResource CmAccent}" />
    </Style>
    <Style Selector="TextBlock.empty-title">
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeTitle}" />
      <Setter Property="FontWeight" Value="{DynamicResource CmFontWeightStrong}" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.recent-list">
      <Setter Property="BorderBrush" Value="{DynamicResource CmCardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource CmRadius}" />
    </Style>
    <Style Selector="Button.recent">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <!-- The tree's rows (design/boards/tree-no-name.md): no-name titles in italics, whitespace made visible in mono
         (.mono), the group's count as the row's meta ("4 files"). The tree's header (the Tree display button) and footer
         ("N invisible items hidden · Show") sit on CmSidebarBackground with CmDivider rules; Show is a CmAccent link. -->
    <Style Selector="TextBlock.italic">
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style Selector="Border.tree-bar">
      <Setter Property="Background" Value="{DynamicResource CmSidebarBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CmDivider}" />
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource CmAccent}" />
    </Style>
    <Style Selector="FlyoutPresenter.tree-display">
      <Setter Property="Background" Value="{DynamicResource CmSidebarBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CmDivider}" />
    </Style>
    <Style Selector="ListBox.hex ListBoxItem">
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="{DynamicResource CmRowList}" />
    </Style>

    <!-- The hex grid (boards/hex.md): mono 13, 24 high lines; byte cells 24 wide with a gap after the eighth, characters
         9 wide; zero bytes lighter; changed bytes on CmWarningTint in SemiBold; the cursor on CmHexCursor. -->
    <Style Selector="Border.hex-bar">
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="TextBox.go-to">
      <Setter Property="FontFamily" Value="{StaticResource CmFontMono}" />
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeMonoSmall}" />
      <Setter Property="Width" Value="110" />
    </Style>
    <Style Selector="StackPanel.hex-header">
      <Setter Property="Margin" Value="12,0,12,2" />
    </Style>
    <Style Selector="StackPanel.hex-header TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource CmTextMuted}" />
    </Style>
    <Style Selector="TextBlock.hex-offset">
      <Setter Property="Width" Value="68" />
      <Setter Property="Foreground" Value="{DynamicResource CmTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.hex-text">
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="Border.hex-cell">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="Border.hex-cell.group-end">
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="Border.hex-cell > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.hex-char">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="Border.hex-char > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.hex-cell.zero > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CmTextMuted}" />
    </Style>
    <Style Selector="Border.in-field">
      <Setter Property="Background" Value="{DynamicResource CmRowHighlight}" />
    </Style>
    <Style Selector="Border.selected">
      <Setter Property="Background" Value="{DynamicResource CmSelectionInactive}" />
    </Style>
    <Style Selector="Border.changed">
      <Setter Property="Background" Value="{DynamicResource CmWarningTint}" />
    </Style>
    <Style Selector="Border.changed > TextBlock">
      <Setter Property="FontWeight" Value="{DynamicResource CmFontWeightStrong}" />
    </Style>
    <Style Selector="Border.cursor">
      <Setter Property="Background" Value="{DynamicResource CmHexCursor}" />
    </Style>
    <Style Selector="Border.cursor > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CmOnAccent}" />
    </Style>
    <Style Selector="Border.hex-inspector">
      <Setter Property="Width" Value="200" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Background" Value="{DynamicResource CmSidebarBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CmBorder}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="Border.hex-inspector TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource CmFontMono}" />
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeMonoSmall}" />
    </Style>
    <Style Selector="TextBlock.hex-status">
      <Setter Property="FontFamily" Value="{StaticResource CmFontMono}" />
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeMonoSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource CmTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12,0" />
    </Style>

    <!-- The diagnostics list: 26 px rows divided by CmDivider, indented 32 under their group; the selected row is
         CmRowHighlight with a 3 px CmAccent bar on the left (design/boards/diagnostics.md), its muted code staying
         muted on that light highlight. -->
    <Style Selector="ListBox.diagnostics ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.diagnostics ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.diagnostics ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CmRowHighlight}" />
      <Setter Property="Foreground" Value="{DynamicResource CmText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CmAccent}" />
    </Style>
    <Style Selector="ListBox.diagnostics:focus-within ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CmRowHighlight}" />
      <Setter Property="Foreground" Value="{DynamicResource CmText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CmAccent}" />
    </Style>
    <Style Selector="ListBox.diagnostics:focus-within ListBoxItem:selected :is(TextBlock).muted">
      <Setter Property="Foreground" Value="{DynamicResource CmTextMuted}" />
    </Style>
    <Style Selector="Border.diagnostic-row">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CmDivider}" />
    </Style>
    <Style Selector="ListBox.grouped Border.diagnostic-row">
      <Setter Property="Padding" Value="32,0,8,0" />
    </Style>
    <Style Selector="Border.diagnostic-group">
      <Setter Property="Height" Value="27" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CmDivider}" />
    </Style>
    <Style Selector="Grid.diagnostic-columns">
      <Setter Property="Margin" Value="11,0,8,0" />
    </Style>
    <Style Selector="Border.diagnostics-header">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.diagnostics-header.collapsed">
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="ListBox.diagnostics Button.show-item">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.diagnostics ListBoxItem:selected Button.show-item">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- The diagnostics' drag handle: a 6 px chrome strip under a CmBorder line, a 36 x 2 grip in its middle. -->
    <Style Selector="GridSplitter.handle">
      <Setter Property="Background" Value="{DynamicResource CmChromeBackground}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CmBorder}" BorderThickness="0,1,0,0">
            <Border Width="36" Height="2" CornerRadius="1" Background="{DynamicResource CmControlBorder}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Grid.diagnostic-columns.grouped">
      <Setter Property="Margin" Value="35,0,8,0" />
    </Style>

    <!-- Title bar (S1): CmBarTitle high on CmTitleBarBackground, the title in CmFontMeta and CmTextMuted, the unsaved
         mark in CmAccent. The caption buttons (Avalonia's drawn ones on Windows, the system's on macOS) sit over its right or left end. -->
    <Style Selector="Border.titlebar">
      <Setter Property="Height" Value="{DynamicResource CmBarTitle}" />
      <Setter Property="Background" Value="{DynamicResource CmTitleBarBackground}" />
      <Setter Property="Padding" Value="12,0,146,0" />
    </Style>
    <Style Selector="Border.titlebar.mac">
      <Setter Property="Padding" Value="78,0,12,0" />
    </Style>
    <Style Selector="Border.titlebar TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeMeta}" />
      <Setter Property="Foreground" Value="{DynamicResource CmTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.titlebar TextBlock.unsaved">
      <Setter Property="Foreground" Value="{DynamicResource CmAccent}" />
      <Setter Property="Margin" Value="-4,0,0,0" />
    </Style>

    <!-- Toolbar (S2): CmBarTool high, a CmBorder line below; 34-high buttons with an 18 px stroke icon over a CmFontMeta
         label, transparent until hovered, 40% opacity when disabled; groups split by 1 x 24 CmBorder lines. -->
    <Style Selector="Border.toolbar">
      <Setter Property="Height" Value="{DynamicResource CmBarTool}" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CmBorder}" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="52" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeMeta}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool StackPanel">
      <Setter Property="Spacing" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource CmText}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Path.tool-icon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Stroke" Value="{DynamicResource CmText}" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Border.tool-divider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Background" Value="{DynamicResource CmBorder}" />
    </Style>
    <Style Selector="TextBlock.tool-label">
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeMeta}" />
      <Setter Property="Foreground" Value="{DynamicResource CmTextMuted}" />
    </Style>
    <Style Selector="StackPanel:disabled TextBlock.tool-label">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="StackPanel:disabled ListBox.segmented">
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- The read-then-edit host (boards/read-then-edit.md, E1): the footer on CmSidebarBackground under a CmDivider
         line; while editing, a 3 px CmAccent line over the values; Apply greyed while the values have an error. -->
    <Style Selector="Border.host-footer">
      <Setter Property="Background" Value="{DynamicResource CmSidebarBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CmDivider}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="MinHeight" Value="50" />
    </Style>
    <Style Selector="Border.host-footer TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.applied">
      <Setter Property="Foreground" Value="{DynamicResource CmAccent}" />
    </Style>
    <Style Selector="TextBlock.form-error">
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeMeta}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="PathIcon.lock">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource CmTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.host-values">
      <Setter Property="BorderBrush" Value="{DynamicResource CmAccent}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="DockPanel.form-host.editing Border.host-values">
      <Setter Property="BorderThickness" Value="0,3,0,0" />
    </Style>
    <Style Selector="ContentControl.form-content">
      <Setter Property="Margin" Value="16,12" />
    </Style>
    <Style Selector="Grid.menu-form">
      <Setter Property="Margin" Value="-16,-12" />
    </Style>

    <!-- Property cards (boards/window-alert.md, E4): CmCardBorder, radius 8; rows 34 high with CmDivider between and
         a 150 label column in CmTextMuted; dots for yes/no (filled CmAccent for yes); the screen panel 320 wide. -->
    <Style Selector="StackPanel.cards">
      <Setter Property="Spacing" Value="12" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="BorderBrush" Value="{DynamicResource CmCardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource CmRadiusLarge}" />
      <Setter Property="Background" Value="{DynamicResource CmPaneBackground}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="TextBlock.card-title">
      <Setter Property="FontWeight" Value="{DynamicResource CmFontWeightStrong}" />
      <Setter Property="Margin" Value="14,10,14,4" />
    </Style>
    <Style Selector="TextBlock.card-note">
      <Setter Property="Margin" Value="14,4,14,8" />
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeMeta}" />
    </Style>
    <Style Selector="Grid.card-row">
      <Setter Property="MinHeight" Value="{DynamicResource CmRowForm}" />
      <Setter Property="Margin" Value="14,0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Grid.card-row > :is(Control)">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.card-row > TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource CmTextMuted}" />
    </Style>
    <Style Selector="Border.card-line">
      <Setter Property="BorderBrush" Value="{DynamicResource CmDivider}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.card-line.last">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.card TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource CmFontMono}" />
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeMonoSmall}" />
    </Style>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="Stroke" Value="{DynamicResource CmTextMuted}" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.dot.on">
      <Setter Property="Fill" Value="{DynamicResource CmAccent}" />
      <Setter Property="Stroke" Value="{DynamicResource CmAccent}" />
    </Style>
    <Style Selector="Grid.card-columns">
      <Setter Property="Margin" Value="14,0,14,4" />
    </Style>
    <Style Selector="Grid.stage-row > :is(Control)">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.screen-panel">
      <Setter Property="Width" Value="320" />
      <Setter Property="Margin" Value="16,0,0,0" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Background" Value="{DynamicResource CmSidebarBackground}" />
      <Setter Property="CornerRadius" Value="{DynamicResource CmRadiusLarge}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- The template form (boards/template-form.md, E6): the note on CmWarningTint, fields in a card with their type
         codes, list headings, item cards with a header strip, nested lists as compact tables, the template panel 300 wide. -->
    <Style Selector="Border.note-banner">
      <Setter Property="Background" Value="{DynamicResource CmWarningTint}" />
      <Setter Property="CornerRadius" Value="{DynamicResource CmRadius}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="Border.note-banner TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CmWarning}" />
    </Style>
    <Style Selector="Grid.template-field TextBlock.type-code">
      <Setter Property="FontFamily" Value="{StaticResource CmFontMono}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource CmTextMuted}" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="Grid.template-field TextBlock.value.code">
      <Setter Property="FontFamily" Value="{StaticResource CmFontMono}" />
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeMonoSmall}" />
    </Style>
    <Style Selector="TextBlock.count-note">
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeMeta}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.template-list">
      <Setter Property="Margin" Value="14,10" />
    </Style>
    <Style Selector="TextBlock.list-heading">
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeBody}" />
      <Setter Property="FontWeight" Value="{DynamicResource CmFontWeightStrong}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.item-card">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.item-header">
      <Setter Property="Background" Value="{DynamicResource CmSidebarBackground}" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="TextBlock.item-key">
      <Setter Property="FontFamily" Value="{StaticResource CmFontMono}" />
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeMonoSmall}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.compact-table :is(Control).table-cell">
      <Setter Property="Width" Value="112" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="StackPanel.compact-table Panel.table-cell TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource CmFontMono}" />
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeMonoSmall}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.link.danger">
      <Setter Property="Foreground" Value="{DynamicResource CmError}" />
    </Style>
    <Style Selector="Border.template-panel">
      <Setter Property="Width" Value="300" />
      <Setter Property="Margin" Value="16,0,0,0" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Background" Value="{DynamicResource CmSidebarBackground}" />
      <Setter Property="CornerRadius" Value="{DynamicResource CmRadiusLarge}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.template-panel TextBlock.outline">
      <Setter Property="FontFamily" Value="{StaticResource CmFontMono}" />
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeMonoSmall}" />
    </Style>
    <Style Selector="Border.template-panel TextBlock.note">
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeMeta}" />
    </Style>

    <!-- The menu form (E2): summary, table rows 32 high with CmDivider between, the selected row CmRowHighlight with a
         3 px CmAccent bar, disabled items muted, dividers as a short rule; key fields that clash in CmError on
         CmErrorTint; the preview panel 420 wide. -->
    <Style Selector="StackPanel.menu-table :is(Control).editing">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="StackPanel.menu-table.editing :is(Control).editing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="StackPanel.menu-table.editing :is(Control).read-only">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="WrapPanel.menu-summary > TextBlock, WrapPanel.menu-fields > :is(Control)">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,4" />
    </Style>
    <Style Selector="WrapPanel.menu-summary > TextBlock.value">
      <Setter Property="FontWeight" Value="{DynamicResource CmFontWeightStrong}" />
      <Setter Property="Margin" Value="0,0,20,4" />
    </Style>
    <Style Selector="Grid.menu-columns">
      <Setter Property="Margin" Value="11,0,8,4" />
    </Style>
    <Style Selector="Border.table-row">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="11,2,8,2" />
      <Setter Property="BorderBrush" Value="{DynamicResource CmDivider}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.table-row.selected">
      <Setter Property="Background" Value="{DynamicResource CmRowHighlight}" />
    </Style>
    <Style Selector="Border.table-row Border.bar">
      <Setter Property="Width" Value="3" />
      <Setter Property="Margin" Value="-11,-2,0,-2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource CmAccent}" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.table-row.selected Border.bar">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.table-row Grid.read-only > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.table-row.dimmed Grid.read-only TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CmTextMuted}" />
    </Style>
    <Style Selector="Border.table-row StackPanel.divider-mark">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.table-row.divider StackPanel.divider-mark">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.table-row.divider TextBlock.item-text">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.rule">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource CmBorder}" />
    </Style>
    <Style Selector="Border.table-row Grid.editing > :is(Control)">
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.conflict">
      <Setter Property="BorderBrush" Value="{DynamicResource CmError}" />
      <Setter Property="Background" Value="{DynamicResource CmErrorTint}" />
    </Style>
    <Style Selector="Button.row-tool">
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="FontSize" Value="9" />
    </Style>
    <Style Selector="Button.row-tool.remove">
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeBody}" />
    </Style>
    <Style Selector="WrapPanel.menu-fields > StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="WrapPanel.menu-fields > StackPanel > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Table inputs (28 high, as boards/read-then-edit.md has them inside tables) fit their columns. -->
    <Style Selector="Border.table-row Grid.editing TextBox, Border.table-row Grid.editing ComboBox">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.table-row Grid.editing NumericUpDown, WrapPanel.menu-fields NumericUpDown">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.table-row Grid.editing TextBox, Border.table-row Grid.editing ComboBox">
      <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="Border.table-row Grid.editing CheckBox">
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="WrapPanel.menu-fields TextBox">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="StackPanel.menu-table.editing Border.table-row">
      <Setter Property="Padding" Value="11,1,8,1" />
      <Setter Property="MinHeight" Value="30" />
    </Style>

    <!-- E5's read-only views: a double-click anywhere on them edits; labelled rows 8 apart. -->
    <Style Selector="Border.read-view">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Grid.labelled > TextBlock">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.strong-value">
      <Setter Property="FontWeight" Value="{DynamicResource CmFontWeightStrong}" />
    </Style>
    <Style Selector="Button.row-tool.remove /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource CmError}" />
    </Style>
    <Style Selector=":is(Button).style-bit">
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="FontSize" Value="{DynamicResource CmFontSizeMeta}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.style-bit.more.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CmRowHighlight}" />
      <Setter Property="Foreground" Value="{DynamicResource CmAccent}" />
    </Style>
    <Style Selector="Border.preview-panel">
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="BorderBrush" Value="{DynamicResource CmBorder}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <!-- The item list's preview panel is 400 wide (boards/dialog-item-list.md); its bounds inputs are mono, 40 wide. -->
    <Style Selector="Border.ditl-preview">
      <Setter Property="MaxWidth" Value="400" />
    </Style>
    <Style Selector="TextBlock.preview-note">
      <Setter Property="Margin" Value="12,6" />
    </Style>
    <Style Selector="Border.ditl-row">
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="TextBox.bound">
      <Setter Property="Width" Value="40" />
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="Padding" Value="4,4" />
    </Style>
    <!-- The sound preview (boards/sound.md): a 40 px round play button, chips with a 1 px CmCardBorder and radius 6, the
         waveform card with its header strip, and the error card on CmSidebarBackground. -->
    <Style Selector="Button.transport">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.transport PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="TextBlock.sound-time">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="BorderBrush" Value="{DynamicResource CmCardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style Selector="Border.wave-card">
      <Setter Property="BorderBrush" Value="{DynamicResource CmCardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.wave-header">
      <Setter Property="Background" Value="{DynamicResource CmSidebarBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CmDivider}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Border.loop-swatch">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource CmLoopRegion}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CmCardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.sound-error">
      <Setter Property="Background" Value="{DynamicResource CmSidebarBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CmCardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="16" />
      <Setter Property="MaxWidth" Value="520" />
    </Style>
    <Style Selector="Border.preview-header">
      <Setter Property="Background" Value="{DynamicResource CmSidebarBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CmDivider}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="TextBlock.strong">
      <Setter Property="FontWeight" Value="{DynamicResource CmFontWeightStrong}" />
    </Style>

    <!-- View ▸ Screen Depth: one radio item per depth. -->
    <Style Selector="MenuItem.depths > MenuItem" x:DataType="vm:ScreenDepthChoice">
      <Setter Property="Header" Value="{Binding Label}" />
      <Setter Property="ToggleType" Value="Radio" />
      <Setter Property="GroupName" Value="depth" />
      <Setter Property="Command" Value="{Binding $parent[Window].((vm:MainViewModel)DataContext).SetScreenDepthCommand, FallbackValue={x:Null}}" />
      <Setter Property="CommandParameter" Value="{Binding Depth}" />
      <Setter Property="IsChecked">
        <MultiBinding Converter="{x:Static views:ShellConverters.AreEqual}">
          <Binding Path="Depth" />
          <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).ScreenDepth" FallbackValue="0" />
        </MultiBinding>
      </Setter>
    </Style>
  </Window.Styles>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Shift+D" Command="{Binding DiagnosticsPanel.ToggleCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <!-- The custom title bar (S1) on Windows and macOS, where the window extends into its decorations; a drag area for
         the platform; the caption buttons are drawn over it (see CmWindowDecorations). Linux keeps the system's. -->
    <Border x:Name="TitleBar" DockPanel.Dock="Top" Classes="titlebar" chrome:WindowDecorationProperties.ElementRole="TitleBar"
            IsVisible="{Binding $parent[Window].ExtendClientAreaToDecorationsHint}">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <!-- The app's icon: the hand-drawn pixel size for the scaling, drawn 1:1 (AppIconView). -->
        <views:AppIconView x:Name="TitleIcon" Slot="16" VerticalAlignment="Center" />
        <TextBlock Text="{Binding TitleFile}" IsVisible="{Binding TitleFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="•" Classes="unsaved" IsVisible="{Binding TitleUnsaved}" />
        <TextBlock Text="—" IsVisible="{Binding TitleFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="ClassicMac" />
      </StackPanel>
    </Border>
    <Menu DockPanel.Dock="Top" Classes="chrome">
      <MenuItem Header="_File">
        <MenuItem Header="_Open…" Command="{Binding OpenCommand}" InputGesture="Ctrl+O" HotKey="Ctrl+O" />
        <MenuItem Header="_Close" Command="{Binding CloseCommand}" InputGesture="Ctrl+W" HotKey="Ctrl+W" />
        <Separator />
        <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" HotKey="Ctrl+S" />
        <MenuItem Header="Save _As">
          <MenuItem Header="_MacBinary III…" Command="{Binding SaveAsCommand}" CommandParameter="{x:Static editing:SaveAsFormat.MacBinary}" />
          <MenuItem Header="_BinHex 4.0…" Command="{Binding SaveAsCommand}" CommandParameter="{x:Static editing:SaveAsFormat.BinHex}" />
          <MenuItem Header="Apple_Single…" Command="{Binding SaveAsCommand}" CommandParameter="{x:Static editing:SaveAsFormat.AppleSingle}" />
          <MenuItem Header="Apple_Double Pair…" Command="{Binding SaveAsCommand}" CommandParameter="{x:Static editing:SaveAsFormat.AppleDoublePair}" />
          <MenuItem Header="Basilisk _II Folder Entry…" Command="{Binding SaveAsCommand}" CommandParameter="{x:Static editing:SaveAsFormat.BasiliskEntry}" />
          <MenuItem Header="_HFS Volume Image…" Command="{Binding SaveAsCommand}" CommandParameter="{x:Static editing:SaveAsFormat.HfsImage}" />
          <MenuItem Header="_Resource Fork Only…" Command="{Binding SaveAsCommand}" CommandParameter="{x:Static editing:SaveAsFormat.RawFork}" />
        </MenuItem>
        <MenuItem Header="_Revert" Command="{Binding RevertCommand}" />
        <Separator />
        <MenuItem Header="_Quit" Click="OnQuit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="{Binding UndoTitle}" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" HotKey="Ctrl+Z" />
        <MenuItem Header="{Binding RedoTitle}" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" HotKey="Ctrl+Y" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Zoom _In" Command="{Binding ZoomInCommand}" InputGesture="Ctrl+OemPlus" HotKey="Ctrl+OemPlus" />
        <MenuItem Header="Zoom _Out" Command="{Binding ZoomOutCommand}" InputGesture="Ctrl+OemMinus" HotKey="Ctrl+OemMinus" />
        <MenuItem Header="_Actual Size" Command="{Binding ActualSizeCommand}" InputGesture="Ctrl+D0" HotKey="Ctrl+D0" />
        <MenuItem Header="Screen _Depth" Classes="depths" ItemsSource="{Binding ScreenDepthChoices}" />
        <Separator />
        <MenuItem Header="Show _Diagnostics" ToggleType="CheckBox" IsChecked="{Binding DiagnosticsPanel.IsExpanded, Mode=TwoWay}" InputGesture="Ctrl+Shift+D" />
        <Separator />
        <MenuItem Header="_Group Files with No Name" ToggleType="CheckBox" IsChecked="{Binding TreeDisplay.GroupNoName, Mode=TwoWay}" />
        <MenuItem Header="_Hide Invisible Files" ToggleType="CheckBox" IsChecked="{Binding TreeDisplay.HideInvisible, Mode=TwoWay}" />
        <MenuItem Header="Show _Details Column" ToggleType="CheckBox" IsChecked="{Binding TreeDisplay.ShowDetails, Mode=TwoWay}" />
        <Separator />
        <MenuItem Header="_Theme">
          <MenuItem Header="_System" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                    Command="{Binding SetThemeCommand}" CommandParameter="{x:Static app:AppTheme.System}" />
          <MenuItem Header="_Light" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                    Command="{Binding SetThemeCommand}" CommandParameter="{x:Static app:AppTheme.Light}" />
          <MenuItem Header="_Dark" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                    Command="{Binding SetThemeCommand}" CommandParameter="{x:Static app:AppTheme.Dark}" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Resource">
        <MenuItem Header="_New Resource…" Command="{Binding NewResourceCommand}" InputGesture="Ctrl+K" HotKey="Ctrl+K" />
        <MenuItem Header="_Duplicate" Command="{Binding DuplicateResourceCommand}" InputGesture="Ctrl+D" HotKey="Ctrl+D" />
        <MenuItem Header="De_lete" Command="{Binding DeleteResourceCommand}" InputGesture="Delete" />
        <Separator />
        <MenuItem Header="Get _Info…" Command="{Binding GetInfoCommand}" InputGesture="Ctrl+I" HotKey="Ctrl+I" />
        <MenuItem Header="Edit _Hex…" Command="{Binding EditHexCommand}" InputGesture="Ctrl+H" HotKey="Ctrl+H" />
        <MenuItem Header="_Replace Data from File…" Command="{Binding ReplaceDataCommand}" />
        <MenuItem Header="I_mport Image or Sound…" Command="{Binding ImportCommand}" />
      </MenuItem>
      <MenuItem Header="_Volume">
        <MenuItem Header="New _File…" Command="{Binding NewFileCommand}" />
        <MenuItem Header="_Import File…" Command="{Binding ImportFileCommand}" />
        <MenuItem Header="New F_older…" Command="{Binding NewFolderCommand}" />
        <Separator />
        <MenuItem Header="_Delete File or Folder…" Command="{Binding DeleteItemCommand}" />
      </MenuItem>
      <MenuItem Header="E_xport">
        <MenuItem Header="_Save Resource As…" Command="{Binding SaveResourceAsCommand}" InputGesture="Ctrl+E" HotKey="Ctrl+E" />
        <MenuItem Header="_Export Resources…" Command="{Binding ExportResourcesCommand}" />
        <MenuItem Header="E_xtract All Resources…" Command="{Binding ExtractAllCommand}" />
        <MenuItem Header="_Convert Documents…" Command="{Binding ConvertDocumentsCommand}" />
        <Separator />
        <MenuItem Header="_Unpack (AppleDouble)…" Command="{Binding UnpackAppleDoubleCommand}" />
        <MenuItem Header="Unpack (_Basilisk II)…" Command="{Binding UnpackBasiliskCommand}" />
        <Separator />
        <MenuItem Header="_Drag Files Out as MacBinary" ToggleType="CheckBox" IsChecked="{Binding DragOutAsMacBinary, Mode=TwoWay}" />
      </MenuItem>
      <!-- Filled by the window: Minimize, Zoom, then one item per open input. -->
      <MenuItem x:Name="WindowMenu" Header="_Window" />
      <MenuItem Header="_Help">
        <MenuItem Header="ClassicMac _Help" Command="{Binding OpenHelpCommand}" />
        <MenuItem Header="_Report a Problem…" Command="{Binding ReportProblemCommand}" />
        <Separator />
        <MenuItem Header="_About ClassicMac" Command="{Binding AboutCommand}" />
      </MenuItem>
    </Menu>

    <!-- The toolbar (design/boards/main-window.md, S2): each button follows its command's enabled state. -->
    <Border x:Name="Toolbar" DockPanel.Dock="Top" Classes="chrome toolbar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsEnabled="{Binding IsZoomable}">
          <TextBlock Text="Zoom" Classes="tool-label" VerticalAlignment="Center" />
          <ListBox x:Name="ZoomChoice" Classes="segmented" ItemsSource="{Binding Zooms}" SelectedItem="{Binding Zoom, Mode=TwoWay}"
                   AutomationProperties.Name="Zoom">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="x:Int32">
                <TextBlock Text="{Binding StringFormat={}{0}×}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="Depth" Classes="tool-label" VerticalAlignment="Center" Margin="8,0,0,0" />
          <ComboBox x:Name="DepthChoice" ItemsSource="{Binding ScreenDepthChoices}" SelectedItem="{Binding SelectedDepthChoice, Mode=TwoWay}"
                    MinWidth="120" AutomationProperties.Name="Screen depth">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:ScreenDepthChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="flat tool" Command="{Binding OpenCommand}" ToolTip.Tip="Open (Ctrl+O)" AutomationProperties.Name="Open">
            <StackPanel>
              <Path Classes="tool-icon" Data="M2,5 V14 H14 L16,8 H5 L3,14 M2,5 H7 L8.5,6.5 H14 V8" />
              <TextBlock Text="Open" />
            </StackPanel>
          </Button>
          <Button Classes="flat tool" Command="{Binding SaveCommand}" ToolTip.Tip="Save (Ctrl+S)" AutomationProperties.Name="Save">
            <StackPanel>
              <Path Classes="tool-icon" Data="M9,2 V11 M5.5,7.5 L9,11 L12.5,7.5 M2,11 V15 H16 V11" />
              <TextBlock Text="Save" />
            </StackPanel>
          </Button>
          <Border Classes="tool-divider" />
          <Button Classes="flat tool" Command="{Binding GetInfoCommand}" ToolTip.Tip="Get Info (Ctrl+I)" AutomationProperties.Name="Get Info">
            <StackPanel>
              <Path Classes="tool-icon" Data="M9,1.75 A7.25,7.25 0 1 1 8.99,1.75 Z M9,8 V13 M9,5 V5.6" />
              <TextBlock Text="Get Info" />
            </StackPanel>
          </Button>
          <Button Classes="flat tool" Command="{Binding EditHexCommand}" ToolTip.Tip="Edit Hex (Ctrl+H)" AutomationProperties.Name="Edit Hex">
            <StackPanel>
              <Path Classes="tool-icon" Data="M6,5 L2,9 L6,13 M12,5 L16,9 L12,13 M10.5,4 L7.5,14" />
              <TextBlock Text="Edit Hex" />
            </StackPanel>
          </Button>
          <Border Classes="tool-divider" />
          <Button Classes="flat tool" Command="{Binding HeaderExportCommand}" ToolTip.Tip="Export the selection" AutomationProperties.Name="Export">
            <StackPanel>
              <Path Classes="tool-icon" Data="M9,11 V2 M5.5,5.5 L9,2 L12.5,5.5 M2,11 V15 H16 V11" />
              <TextBlock Text="Export…" />
            </StackPanel>
          </Button>
          <Button Classes="flat tool" Command="{Binding ExtractAllCommand}" ToolTip.Tip="Extract all resources" AutomationProperties.Name="Extract All">
            <StackPanel>
              <Path Classes="tool-icon" Data="M2,7 H16 V16 H2 Z M3.5,4.5 H14.5 M5,2 H13 M9,9 V14 M7,12 L9,14 L11,12" />
              <TextBlock Text="Extract All" />
            </StackPanel>
          </Button>
          <Border Classes="tool-divider" />
          <Button Classes="flat tool" Command="{Binding PlaySoundCommand}" ToolTip.Tip="Play the sound" AutomationProperties.Name="Play">
            <StackPanel>
              <Path Classes="tool-icon" Data="M5,3 L15,9 L5,15 Z" />
              <TextBlock Text="Play" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- The status bar (boards/main-window.md, S4): the selected file's summary with its error and warning counts; on the
         right, while work runs, what it does, how far and a progress bar, else the status text. -->
    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Classes="chrome status-bar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" IsVisible="{Binding Summary, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Classes="summary" Text="{Binding Summary.Text, FallbackValue={x:Null}}" />
          <TextBlock Classes="summary error" Text="{Binding Summary.ErrorText, StringFormat=' · {0}', FallbackValue={x:Null}}"
                     IsVisible="{Binding Summary.ErrorText, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
          <TextBlock Classes="summary warning" Text="{Binding Summary.WarningText, StringFormat=' · {0}', FallbackValue={x:Null}}"
                     IsVisible="{Binding Summary.WarningText, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
        </StackPanel>
        <StackPanel x:Name="Progress" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsWorking}">
          <TextBlock Text="{Binding ProgressText}" />
          <TextBlock Text="{Binding ProgressCount}" Classes="muted" IsVisible="{Binding ProgressCount, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <ProgressBar Classes="status" Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}"
                       IsIndeterminate="{Binding IsProgressIndeterminate}" />
        </StackPanel>
        <TextBlock Classes="status" Text="{Binding Status}" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsWorking}" />
      </DockPanel>
    </Border>

    <Grid x:Name="Body" RowDefinitions="*,6,196">
      <Grid ColumnDefinitions="380,5,*">
        <DockPanel>
        <Border DockPanel.Dock="Top" Classes="tree-bar" Padding="6,6,4,6" BorderThickness="0,0,0,1">
          <DockPanel>
          <Button x:Name="TreeDisplayButton" DockPanel.Dock="Right" Classes="flat" Margin="4,0,0,0" ToolTip.Tip="Tree display" AutomationProperties.Name="Tree display">
            <PathIcon Width="12" Height="12" Data="M1,2 H15 V4 H1 Z M1,7 H15 V9 H1 Z M1,12 H15 V14 H1 Z" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="tree-display">
                <StackPanel x:Name="TreeDisplayPanel" Spacing="8" MinWidth="220">
                  <TextBlock Text="Tree display" FontWeight="SemiBold" />
                  <CheckBox Content="Group files with no name" IsChecked="{Binding TreeDisplay.GroupNoName}" />
                  <CheckBox Content="Hide invisible files" IsChecked="{Binding TreeDisplay.HideInvisible}" />
                  <CheckBox Content="Show details column" IsChecked="{Binding TreeDisplay.ShowDetails}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <TextBox x:Name="TreeFilter" Classes="filter" PlaceholderText="Filter tree" Text="{Binding FilterText}" AutomationProperties.Name="Filter tree">
            <TextBox.InnerLeftContent>
              <PathIcon Classes="search" Data="M6.5,1 A5.5,5.5 0 1 1 6.5,12 A5.5,5.5 0 1 1 6.5,1 Z M6.5,3 A3.5,3.5 0 1 0 6.5,10 A3.5,3.5 0 1 0 6.5,3 Z M10.2,11.6 L11.6,10.2 L15,13.6 L13.6,15 Z" />
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <TextBlock Classes="mono muted key-hint" Text="Ctrl+F" />
            </TextBox.InnerRightContent>
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Escape" Command="{Binding ClearFilterCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          </DockPanel>
        </Border>
        <Border x:Name="HiddenFooter" DockPanel.Dock="Bottom" Classes="tree-bar" Padding="8,3" BorderThickness="0,1,0,0" IsVisible="{Binding HiddenSummary, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="12" Height="12" Data="M1,8 C4,3 12,3 15,8 C12,13 4,13 1,8 Z M2,13 L13,2 L14,3 L3,14 Z" />
            <TextBlock Text="{Binding HiddenSummary}" Classes="muted" VerticalAlignment="Center" />
            <Button Content="Show" Command="{Binding ShowHiddenCommand}" Classes="flat link" Padding="4,0" Cursor="Hand" />
          </StackPanel>
        </Border>
        <Panel>
        <TreeView x:Name="Tree" Classes="sidebar browse" ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.AllowAutoHide="False">
          <TreeView.KeyBindings>
            <KeyBinding Gesture="Delete" Command="{Binding DeleteResourceCommand}" />
          </TreeView.KeyBindings>
          <TreeView.ItemTemplate>
            <TreeDataTemplate DataType="vm:NodeViewModel" ItemsSource="{Binding Children}">
              <!-- A row (boards/browse-tree.md): icon or spinner, name, unsaved mark, "not read" chip; meta on the right. -->
              <Panel Classes="tree-row">
                <Rectangle Classes="drag-outline" IsVisible="{Binding IsDragSource}" />
                <!-- The row fits the pane: the meta and the chip keep their width on the right, the name trims with an
                     ellipsis (a left-aligned grid: the name's star column is as wide as the name until the row is
                     full), the unsaved mark right after it. -->
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Classes="meta" Text="{Binding Meta}"
                             IsVisible="{Binding Meta, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <Panel DockPanel.Dock="Right" Classes="not-read" IsVisible="{Binding IsUnread}">
                    <Rectangle />
                    <TextBlock Text="not read" />
                  </Panel>
                  <views:TreeIcon DockPanel.Dock="Left" Margin="0,0,4,0" Node="{Binding}" IsVisible="{Binding !IsLoading}" />
                  <Panel DockPanel.Dock="Left" Margin="0,0,4,0" Classes="spinner" IsVisible="{Binding IsLoading}">
                    <Ellipse Classes="track" />
                    <Path Classes="arc" Data="M8,2 A6,6 0 0 1 14,8" />
                  </Panel>
                  <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                    <TextBlock Classes="name" Classes.type="{Binding IsResourceType}" Classes.loading="{Binding IsLoading}" Classes.italic="{Binding IsItalic}"
                               Classes.mono="{Binding IsMono}" Classes.dimmed="{Binding IsDimmed}" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding NameBefore}" /><Run Classes="match" Classes.on="{Binding HasMatch}" Classes.current="{Binding IsCurrentMatch}" Text="{Binding NameMatch}" /><Run Text="{Binding NameAfter}" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" Classes="unsaved" Text=" •" IsVisible="{Binding IsUnsaved}" />
                  </Grid>
                </DockPanel>
              </Panel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
          <TreeView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="_New Resource…" Command="{Binding NewResourceCommand}" InputGesture="Ctrl+K" />
              <MenuItem Header="_Duplicate" Command="{Binding DuplicateResourceCommand}" InputGesture="Ctrl+D" />
              <MenuItem Header="De_lete" Command="{Binding DeleteResourceCommand}" InputGesture="Delete" />
              <MenuItem Header="Get _Info…" Command="{Binding GetInfoCommand}" InputGesture="Ctrl+I" />
              <MenuItem Header="Edit _Hex…" Command="{Binding EditHexCommand}" InputGesture="Ctrl+H" />
              <MenuItem Header="_Replace Data from File…" Command="{Binding ReplaceDataCommand}" />
              <MenuItem Header="I_mport Image or Sound…" Command="{Binding ImportCommand}" />
              <Separator />
              <MenuItem Header="New _File…" Command="{Binding NewFileCommand}" />
              <MenuItem Header="Import File…" Command="{Binding ImportFileCommand}" />
              <MenuItem Header="New F_older…" Command="{Binding NewFolderCommand}" />
              <MenuItem Header="Delete File or Folder…" Command="{Binding DeleteItemCommand}" />
              <Separator />
              <MenuItem Header="_Save Resource As…" Command="{Binding SaveResourceAsCommand}" InputGesture="Ctrl+E" />
              <MenuItem Header="_Export Resources…" Command="{Binding ExportResourcesCommand}" />
              <MenuItem Header="E_xtract All Resources…" Command="{Binding ExtractAllCommand}" />
              <MenuItem Header="_Convert Documents…" Command="{Binding ConvertDocumentsCommand}" />
              <Separator />
              <MenuItem Header="_Unpack (AppleDouble)…" Command="{Binding UnpackAppleDoubleCommand}" />
              <MenuItem Header="Unpack (_Basilisk II)…" Command="{Binding UnpackBasiliskCommand}" />
            </ContextMenu>
          </TreeView.ContextMenu>
        </TreeView>
        <!-- The type-ahead pill: what was typed, the matches, F3 and Esc. -->
        <Border x:Name="TypeAheadPill" Classes="type-ahead" IsVisible="{Binding IsTypeAheadOpen}" VerticalAlignment="Bottom" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Classes="search" Margin="0" Data="M6.5,1 A5.5,5.5 0 1 1 6.5,12 A5.5,5.5 0 1 1 6.5,1 Z M6.5,3 A3.5,3.5 0 1 0 6.5,10 A3.5,3.5 0 1 0 6.5,3 Z M10.2,11.6 L11.6,10.2 L15,13.6 L13.6,15 Z" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="mono" Text="{Binding TypeAheadText}" VerticalAlignment="Center" />
              <TextBlock Classes="mono caret" Text="|" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="muted" Text="{Binding TypeAheadSummary}" VerticalAlignment="Center" />
            <Border Classes="key"><TextBlock Classes="mono muted key-hint" Text="F3" /></Border>
            <Border Classes="key"><TextBlock Classes="mono muted key-hint" Text="Esc" /></Border>
          </StackPanel>
        </Border>
        </Panel>
        </DockPanel>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

        <!-- The inspector (boards/main-window.md, S3): the selection's header, then its tabs. -->
        <DockPanel Grid.Column="2" Classes="pane">
        <Border x:Name="InspectorHeader" DockPanel.Dock="Top" Classes="inspector-header" IsVisible="{Binding Header, Converter={x:Static ObjectConverters.IsNotNull}}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Button Content="Export…" Command="{Binding HeaderExportCommand}" />
              <Panel IsVisible="{Binding HasForm}">
                <Button Classes="accent" Content="Edit" Command="{Binding EditFormCommand}" IsVisible="{Binding !IsEditingForm}" />
                <Border Classes="editing-badge" IsVisible="{Binding IsEditingForm}" VerticalAlignment="Center">
                  <TextBlock Text="Editing" />
                </Border>
              </Panel>
            </StackPanel>
            <Border Classes="icon-tile">
              <Panel>
                <views:PixelImage Source="{Binding HeaderIconPng, Converter={x:Static views:Images.FromPng}}" Zoom="1"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsVisible="{Binding HeaderIconPng, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <views:TreeIcon Node="{Binding Header.Node, FallbackValue={x:Null}}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding HeaderIconPng, Converter={x:Static ObjectConverters.IsNull}}" />
              </Panel>
            </Border>
            <StackPanel Classes="titles">
              <TextBlock Classes="heading" Text="{Binding Header.Name, FallbackValue={x:Null}}" />
              <TextBlock Classes="muted kind" Text="{Binding Header.Kind, FallbackValue={x:Null}}" />
              <ItemsControl ItemsSource="{Binding Header.Facts, FallbackValue={x:Null}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:InspectorFact">
                    <StackPanel Classes="fact" Orientation="Horizontal">
                      <TextBlock Classes="muted label" Text="{Binding Label}" />
                      <TextBlock Classes="value" Classes.mono="{Binding IsMono}" Text="{Binding Value}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DockPanel>
        </Border>
        <TabControl Classes="pane inspector" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Padding="0">
          <TabItem Header="Details">
            <ScrollViewer Padding="16,12">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Details.Heading}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Details.Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:DetailRow">
                      <Grid ColumnDefinitions="140,*" Margin="0,2">
                        <TextBlock Text="{Binding Label}" Classes="muted" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Preview">
            <Panel>
            <DockPanel IsVisible="{Binding !ShowsForm}">
              <Panel>
                <TextBlock Text="{Binding Preview.Message}" Margin="16" Classes="muted" IsVisible="{Binding Preview.IsMessage}" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" IsVisible="{Binding Preview.IsImage}">
                  <ItemsControl ItemsSource="{Binding Images}" Margin="12">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:ImageItem">
                        <StackPanel Margin="0,0,16,16" Spacing="4">
                          <Border Background="{DynamicResource CmCheckerboard}" HorizontalAlignment="Left">
                            <views:PixelImage Source="{Binding Image.Png, Converter={x:Static views:Images.FromPng}}" Zoom="{Binding Zoom}" />
                          </Border>
                          <TextBlock Text="{Binding Image.Caption}" Classes="muted" FontSize="{DynamicResource CmFontSizeMeta}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <ScrollViewer IsVisible="{Binding Preview.IsStyledText}" Padding="16,12">
                  <views:StyledTextView Styled="{Binding Preview.Styled}" TextWrapping="Wrap" />
                </ScrollViewer>
                <ScrollViewer IsVisible="{Binding Preview.IsPlainText}" Padding="16,12" HorizontalScrollBarVisibility="Auto">
                  <SelectableTextBlock Text="{Binding Preview.Text}" FontFamily="{StaticResource CmFontMono}" />
                </ScrollViewer>
                <ScrollViewer IsVisible="{Binding Preview.IsDialog}" HorizontalScrollBarVisibility="Auto">
                  <views:DialogView Dialog="{Binding Preview.Dialog}" Scale="{Binding Zoom}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ScrollViewer>
                <ScrollViewer IsVisible="{Binding Preview.IsMenu}" HorizontalScrollBarVisibility="Auto">
                  <views:MenuView Menu="{Binding Preview.Menu}" Scale="{Binding Zoom}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ScrollViewer>
                <DockPanel IsVisible="{Binding Preview.IsDocument}">
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="12,8">
                    <Button Content="Back" Command="{Binding Preview.Document.BackCommand, FallbackValue={x:Null}}" />
                    <ComboBox ItemsSource="{Binding Preview.Document.ChapterTitles, FallbackValue={x:Null}}" MinWidth="260"
                              SelectedIndex="{Binding Preview.Document.ChapterIndex, Mode=TwoWay, FallbackValue=0}"
                              IsVisible="{Binding Preview.Document.HasChapters, FallbackValue=False}" />
                  </StackPanel>
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" Background="{Binding Preview.Document.Background, FallbackValue={x:Null}}"
                                Offset="{Binding Preview.Document.Offset, Mode=TwoWay, FallbackValue={x:Static Vector.Zero}}">
                    <ItemsControl ItemsSource="{Binding Preview.Document.Items, FallbackValue={x:Null}}" Margin="16,12" HorizontalAlignment="Center"
                                  Width="{Binding Preview.Document.ColumnWidth, FallbackValue=NaN}">
                      <ItemsControl.DataTemplates>
                        <DataTemplate DataType="vm:DocumentTextItem">
                          <views:StyledTextView Styled="{Binding Text}" Scale="1" TextWrapping="Wrap" TextAlignment="{Binding Alignment}" />
                        </DataTemplate>
                        <DataTemplate DataType="vm:DocumentRowItem">
                          <Grid ColumnDefinitions="*,Auto,*">
                            <ItemsControl ItemsSource="{Binding Left}" HorizontalAlignment="Left">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate><DataTemplate DataType="vm:DocumentPictureItem"><views:DocumentPictureView Item="{Binding}" VerticalAlignment="Top" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Center}">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate><DataTemplate DataType="vm:DocumentPictureItem"><views:DocumentPictureView Item="{Binding}" VerticalAlignment="Top" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Right}" HorizontalAlignment="Right">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate><DataTemplate DataType="vm:DocumentPictureItem"><views:DocumentPictureView Item="{Binding}" VerticalAlignment="Top" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.DataTemplates>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
                <!-- The sound preview (boards/sound.md, P3): the transport (Play/Stop, the playhead's time, Repeat the loop),
                     the detail chips, and the channel lanes with the loop band and the playhead; a click on the waveform
                     plays from there, Space plays and stops. -->
                <ScrollViewer x:Name="SoundPreview" IsVisible="{Binding Preview.IsSound}" Focusable="True">
                  <ScrollViewer.KeyBindings>
                    <KeyBinding Gesture="Space" Command="{Binding ToggleSoundCommand}" />
                  </ScrollViewer.KeyBindings>
                  <StackPanel Margin="16,12" Spacing="12">
                    <DockPanel>
                      <CheckBox x:Name="RepeatLoopBox" DockPanel.Dock="Right" Content="Repeat the loop" IsChecked="{Binding RepeatLoop}"
                                IsVisible="{Binding HasSoundLoop}" />
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <Panel>
                          <Button x:Name="PlayButton" Classes="accent transport" Command="{Binding PlaySoundCommand}" IsVisible="{Binding !IsPlaying}"
                                  ToolTip.Tip="Play (Space)" AutomationProperties.Name="Play">
                            <PathIcon Data="M5,2 L14,8 L5,14 Z" />
                          </Button>
                          <Button x:Name="StopButton" Classes="accent transport" Command="{Binding StopSoundCommand}" IsVisible="{Binding IsPlaying}"
                                  ToolTip.Tip="Stop (Space)" AutomationProperties.Name="Stop">
                            <PathIcon Data="M3,3 H13 V13 H3 Z" />
                          </Button>
                        </Panel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <TextBlock Classes="mono sound-time" Text="{Binding PlayheadText}" />
                          <TextBlock Classes="mono muted sound-time" Text="{Binding SoundDurationText}" />
                        </StackPanel>
                        <TextBlock Classes="muted" VerticalAlignment="Center" Text="Space plays and stops · stops when the selection changes" />
                      </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding PlaybackNote}" Classes="muted" IsVisible="{Binding PlaybackNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ItemsControl ItemsSource="{Binding Preview.SoundFacts}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:SoundFact">
                          <Border Classes="chip">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Classes="muted" Text="{Binding Label}" />
                              <TextBlock Text="{Binding Value}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Classes="wave-card">
                      <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="wave-header">
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSoundLoop}">
                              <Border Classes="loop-swatch" />
                              <TextBlock Classes="muted" Text="Loop" />
                            </StackPanel>
                            <TextBlock Classes="strong" Text="{Binding Preview.SoundLanesTitle}" />
                          </DockPanel>
                        </Border>
                        <views:WaveformView Sound="{Binding Preview.Sound}" LoopFrames="{Binding Preview.SoundLoopFrames}" Playhead="{Binding Playhead}"
                                            ShowsPlayhead="{Binding IsPlaying}" SeekCommand="{Binding SeekSoundCommand}" />
                      </DockPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
                <!-- A sound that cannot be decoded: what it is, why, and its bytes. -->
                <Border x:Name="SoundErrorCard" Classes="sound-error" IsVisible="{Binding Preview.IsSoundError}" VerticalAlignment="Top" HorizontalAlignment="Left">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <views:SeverityIcon Severity="Error" Width="16" Height="16" VerticalAlignment="Center" />
                      <TextBlock Classes="strong" Text="{Binding Preview.ErrorTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="muted" Text="{Binding Preview.ErrorDetail}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Show in Hex" Command="{Binding ShowInHexCommand}" />
                      <Button Content="Save raw data…" Command="{Binding SaveRawDataCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Panel>
            </DockPanel>
              <!-- The read-then-edit host (boards/read-then-edit.md, E1; FormHost.cs): every form, read only first, then
                   in place with Cancel and Apply. Esc cancels and Ctrl+Enter applies (MainWindow.Host.cs); a double-click
                   on a "form-row" edits with that row selected. -->
              <DockPanel x:Name="FormHost" Classes="form-host" Classes.editing="{Binding IsEditingForm}" IsVisible="{Binding ShowsForm}">
                <Border x:Name="FormFooter" DockPanel.Dock="Bottom" Classes="host-footer">
                  <Panel>
                    <StackPanel x:Name="ReadOnlyFooter" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditingForm}">
                      <PathIcon Classes="lock" Data="M4,7 V5 A4,4 0 0 1 12,5 V7 H13 V15 H3 V7 Z M6,7 H10 V5 A2,2 0 0 0 6,5 Z" />
                      <TextBlock Text="{Binding FormReadOnlyNote}" Classes="muted" />
                      <TextBlock Text="{Binding LastApplied}" Classes="applied" IsVisible="{Binding LastApplied, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <DockPanel x:Name="EditingFooter" IsVisible="{Binding IsEditingForm}">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                        <Button Content="Cancel" Command="{Binding CancelFormCommand}" ToolTip.Tip="Esc" />
                        <Button Classes="accent" Content="Apply" Command="{Binding ApplyFormCommand}" IsDefault="False" ToolTip.Tip="Ctrl+Enter" />
                      </StackPanel>
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <TextBlock Text="{Binding FormHint}" Classes="muted" VerticalAlignment="Center" />
                          <CheckBox x:Name="TemplateBox" Content="Edit with template" IsChecked="{Binding UseTemplate}" IsVisible="{Binding HasTemplateChoice}" />
                        </StackPanel>
                        <StackPanel x:Name="FormErrorLine" Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <views:SeverityIcon Severity="Error" Width="12" Height="12" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding FormError}" Classes="error form-error" TextWrapping="Wrap" />
                        </StackPanel>
                      </StackPanel>
                    </DockPanel>
                  </Panel>
                </Border>
                <Border Classes="host-values">
                <DockPanel>
                <ScrollViewer DockPanel.Dock="Right" HorizontalScrollBarVisibility="Auto" Margin="16,0,0,0" MaxWidth="560"
                              IsVisible="{Binding ShowsHostDialog}">
                  <views:DialogView Dialog="{Binding FormDialog}" Scale="1" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ScrollViewer>
                <ContentControl Classes="form-content" Content="{Binding Form}">
                  <ContentControl.DataTemplates>
                    <!-- Strings, string lists, text and version (boards/read-then-edit.md, E5): read as text (a double-click
                         anywhere on it edits), edited with the inputs. -->
                    <DataTemplate DataType="vm:StringForm">
                      <Panel>
                        <Border x:Name="StringRead" Classes="read-view form-row" IsVisible="{Binding !IsEditing}">
                          <StackPanel Spacing="6">
                            <TextBlock Classes="caption" Text="STRING" />
                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding !IsEmpty}" />
                            <TextBlock Classes="muted" Text="Empty" IsVisible="{Binding IsEmpty}" />
                          </StackPanel>
                        </Border>
                        <StackPanel Spacing="6" IsVisible="{Binding IsEditing}">
                          <TextBlock Text="String (at most 255 Mac OS Roman characters)" Classes="muted" />
                          <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                        </StackPanel>
                      </Panel>
                    </DataTemplate>
                    <DataTemplate DataType="vm:StringListForm">
                      <Panel>
                        <ScrollViewer IsVisible="{Binding !IsEditing}">
                          <StackPanel Spacing="6">
                            <TextBlock Classes="caption" Text="{Binding Summary, StringFormat={}{0}}" />
                            <ItemsControl x:Name="StringRows" ItemsSource="{Binding Strings}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:StringItem">
                                  <Border Classes="table-row form-row" Classes.selected="{Binding IsSelected}">
                                    <Panel>
                                      <Border Classes="bar" />
                                      <Grid ColumnDefinitions="36,*">
                                        <TextBlock Classes="muted mono" Text="{Binding Number}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                      </Grid>
                                    </Panel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </ScrollViewer>
                        <DockPanel IsVisible="{Binding IsEditing}">
                          <Button DockPanel.Dock="Bottom" Content="Add String" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                          <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Strings}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:StringItem">
                                  <Grid ColumnDefinitions="36,*,Auto,Auto" Margin="0,2">
                                    <TextBlock Classes="muted mono" Text="{Binding Number}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Classes.selected="{Binding IsSelected}" Text="{Binding Text}" />
                                    <Button Grid.Column="2" Content="↑" Margin="4,0,0,0"
                                            Command="{Binding $parent[ItemsControl].((vm:StringListForm)DataContext).MoveUpCommand}" CommandParameter="{Binding}" />
                                    <Button Grid.Column="3" Content="Remove" Margin="4,0,0,0"
                                            Command="{Binding $parent[ItemsControl].((vm:StringListForm)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </DockPanel>
                      </Panel>
                    </DataTemplate>
                    <DataTemplate DataType="vm:TextForm">
                      <Panel>
                        <ScrollViewer IsVisible="{Binding !IsEditing}">
                          <Border x:Name="TextRead" Classes="read-view form-row">
                            <views:StyledTextView Styled="{Binding Styled}" TextWrapping="Wrap" />
                          </Border>
                        </ScrollViewer>
                        <DockPanel IsVisible="{Binding IsEditing}">
                          <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Classes="muted"
                                     Text="Text (Mac OS Roman). Its 'styl' runs follow your edits; new text takes the style where the change starts."
                                     IsVisible="{Binding HasStyles}" TextWrapping="Wrap" />
                          <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" />
                        </DockPanel>
                      </Panel>
                    </DataTemplate>
                    <DataTemplate DataType="vm:VersionForm">
                      <Panel>
                        <Border x:Name="VersionRead" Classes="read-view form-row" IsVisible="{Binding !IsEditing}">
                          <Grid Classes="labelled" ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Classes="muted" Text="Version" />
                            <TextBlock Grid.Column="1" Classes="mono strong-value" Text="{Binding NumberText}" />
                            <TextBlock Grid.Row="1" Classes="muted" Text="Stage" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StageText}" />
                            <TextBlock Grid.Row="2" Classes="muted" Text="Region code" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding RegionText}" />
                            <TextBlock Grid.Row="3" Classes="muted" Text="Short version" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ShortVersion}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" Classes="muted" Text="Long version" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LongVersion}" TextWrapping="Wrap" />
                          </Grid>
                        </Border>
                        <Grid IsVisible="{Binding IsEditing}" ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                          <TextBlock Text="Major" VerticalAlignment="Center" />
                          <NumericUpDown Grid.Column="1" Value="{Binding Major}" Minimum="0" Maximum="99" FormatString="0" Width="140" HorizontalAlignment="Left" />
                          <TextBlock Grid.Row="1" Text="Minor" VerticalAlignment="Center" />
                          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Minor}" Minimum="0" Maximum="15" FormatString="0" Width="140" HorizontalAlignment="Left" />
                          <TextBlock Grid.Row="2" Text="Bug fix" VerticalAlignment="Center" />
                          <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding BugFix}" Minimum="0" Maximum="15" FormatString="0" Width="140" HorizontalAlignment="Left" />
                          <TextBlock Grid.Row="3" Text="Stage" VerticalAlignment="Center" />
                          <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static vm:VersionForm.Stages}" SelectedItem="{Binding Stage}" Width="140" />
                          <TextBlock Grid.Row="4" Text="Non-release" VerticalAlignment="Center" />
                          <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding NonRelease}" Minimum="0" Maximum="99" FormatString="0" Width="140" HorizontalAlignment="Left" />
                          <TextBlock Grid.Row="5" Text="Region code" VerticalAlignment="Center" />
                          <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding Region}" Minimum="-32768" Maximum="32767" FormatString="0" Width="140" HorizontalAlignment="Left" />
                          <TextBlock Grid.Row="6" Text="Short version" VerticalAlignment="Center" />
                          <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ShortVersion}" />
                          <TextBlock Grid.Row="7" Text="Long version" VerticalAlignment="Center" />
                          <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding LongVersion}" />
                        </Grid>
                      </Panel>
                    </DataTemplate>
                    <!-- The window and dialog form (boards/window-alert.md, E4): property cards, text read only and inputs while
                         editing; the bounds on a screen on the right. -->
                    <DataTemplate DataType="vm:WindowForm">
                      <Grid x:Name="WindowCards" ColumnDefinitions="*,Auto">
                        <ScrollViewer>
                          <StackPanel Classes="cards">
                            <Border Classes="card">
                              <StackPanel>
                                <TextBlock Classes="card-title" Text="Bounds" />
                                <Border Classes="card-line">
                                  <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Top, left" />
                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding TopLeftText}" IsVisible="{Binding !IsEditing}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsEditing}">
                                      <NumericUpDown Value="{Binding Top}" FormatString="0" Width="110" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Top" />
                                      <NumericUpDown Value="{Binding Left}" FormatString="0" Width="110" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Left" />
                                    </StackPanel>
                                  </Grid>
                                </Border>
                                <Border Classes="card-line">
                                  <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Bottom, right" />
                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding BottomRightText}" IsVisible="{Binding !IsEditing}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsEditing}">
                                      <NumericUpDown Value="{Binding Bottom}" FormatString="0" Width="110" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Bottom" />
                                      <NumericUpDown Value="{Binding Right}" FormatString="0" Width="110" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Right" />
                                    </StackPanel>
                                  </Grid>
                                </Border>
                                <Border Classes="card-line last">
                                  <Grid Classes="card-row last" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Size" />
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" />
                                  </Grid>
                                </Border>
                              </StackPanel>
                            </Border>
                            <Border Classes="card">
                              <StackPanel>
                                <TextBlock Classes="card-title" Text="Window" />
                                <Border Classes="card-line">
                                  <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Title" />
                                    <TextBlock Grid.Column="1" Text="{Binding TitleText}" IsVisible="{Binding !IsEditing}" />
                                    <TextBox Grid.Column="1" Text="{Binding Title}" MaxWidth="320" HorizontalAlignment="Left" MinWidth="200" IsVisible="{Binding IsEditing}" />
                                  </Grid>
                                </Border>
                                <Border Classes="card-line">
                                  <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Definition" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
                                      <TextBlock Text="{Binding DefinitionName}" />
                                      <TextBlock Classes="mono muted" Text="{Binding DefinitionCode}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Definitions}" SelectedItem="{Binding SelectedDefinition}" MinWidth="220" IsVisible="{Binding IsEditing}" />
                                  </Grid>
                                </Border>
                                <Border Classes="card-line" IsVisible="{Binding IsDialog}">
                                  <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Item list" />
                                    <Button Grid.Column="1" Classes="link" Content="{Binding ItemsText}" IsVisible="{Binding !IsEditing}"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowItemListCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding ItemsId}" FormatString="0" Width="110" HorizontalAlignment="Left" Minimum="-32768" Maximum="32767" IsVisible="{Binding IsEditing}" />
                                  </Grid>
                                </Border>
                                <Border Classes="card-line">
                                  <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Visible" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsEditing}">
                                      <Ellipse Classes="dot" Classes.on="{Binding Visible}" />
                                      <TextBlock Text="{Binding VisibleText}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding Visible}" IsVisible="{Binding IsEditing}" AutomationProperties.Name="Visible" />
                                  </Grid>
                                </Border>
                                <Border Classes="card-line">
                                  <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Close box" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsEditing}">
                                      <Ellipse Classes="dot" Classes.on="{Binding GoAway}" />
                                      <TextBlock Text="{Binding GoAwayText}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding GoAway}" IsVisible="{Binding IsEditing}" AutomationProperties.Name="Close box" />
                                  </Grid>
                                </Border>
                                <Border Classes="card-line">
                                  <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Reference constant" />
                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding RefConText}" IsVisible="{Binding !IsEditing}" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding RefCon}" FormatString="0" Width="160" HorizontalAlignment="Left" Minimum="-2147483648" Maximum="2147483647" IsVisible="{Binding IsEditing}" />
                                  </Grid>
                                </Border>
                                <Border Classes="card-line last">
                                  <Grid Classes="card-row form-row last" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Auto-position" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
                                      <TextBlock Text="{Binding PositionName}" />
                                      <TextBlock Classes="mono muted" Text="{Binding PositionCode}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditing}">
                                      <CheckBox IsChecked="{Binding HasPosition}" AutomationProperties.Name="Positioning word" />
                                      <ComboBox ItemsSource="{x:Static vm:CardForm.Positions}" SelectedItem="{Binding SelectedPosition}" MinWidth="260" IsEnabled="{Binding HasPosition}" />
                                    </StackPanel>
                                  </Grid>
                                </Border>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Column="1" Classes="screen-panel" IsVisible="{Binding !IsDialog}">
                          <StackPanel Spacing="8">
                            <TextBlock Classes="caption" Text="{Binding ScreenTitle}" />
                            <views:ScreenBoundsView Top="{Binding Top}" Left="{Binding Left}" Bottom="{Binding Bottom}" Right="{Binding Right}"
                                                    Definition="{Binding Definition}" ScreenWidth="{Binding SelectedScreen.Width}" ScreenHeight="{Binding SelectedScreen.Height}"
                                                    HorizontalAlignment="Left" />
                            <ComboBox ItemsSource="{x:Static vm:WindowForm.Screens}" SelectedItem="{Binding SelectedScreen}" MinWidth="200" AutomationProperties.Name="Screen" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </DataTemplate>
                    <!-- The alert form (E4): a card, then the stages table; selecting a stage redraws the preview with its
                         default button. -->
                    <DataTemplate DataType="vm:AlertForm">
                      <ScrollViewer>
                        <StackPanel x:Name="AlertCards" Classes="cards">
                          <Border Classes="card">
                            <StackPanel>
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Bounds" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
                                    <TextBlock Classes="mono" Text="{Binding BoundsText}" />
                                    <TextBlock Classes="muted" Text="{Binding SizeText}" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsEditing}">
                                    <NumericUpDown Value="{Binding Top}" FormatString="0" Width="96" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Top" />
                                    <NumericUpDown Value="{Binding Left}" FormatString="0" Width="96" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Left" />
                                    <NumericUpDown Value="{Binding Bottom}" FormatString="0" Width="96" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Bottom" />
                                    <NumericUpDown Value="{Binding Right}" FormatString="0" Width="96" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Right" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Item list" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
                                    <Button Classes="link" Content="{Binding ItemsText}"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowItemListCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                                    <TextBlock Classes="muted" Text="{Binding ItemCountText}" VerticalAlignment="Center" />
                                  </StackPanel>
                                  <NumericUpDown Grid.Column="1" Value="{Binding ItemsId}" FormatString="0" Width="110" HorizontalAlignment="Left" Minimum="-32768" Maximum="32767" IsVisible="{Binding IsEditing}" />
                                </Grid>
                              </Border>
                              <Border Classes="card-line last">
                                <Grid Classes="card-row form-row last" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Auto-position" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
                                    <TextBlock Text="{Binding PositionName}" />
                                    <TextBlock Classes="mono muted" Text="{Binding PositionCode}" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditing}">
                                    <CheckBox IsChecked="{Binding HasPosition}" AutomationProperties.Name="Positioning word" />
                                    <ComboBox ItemsSource="{x:Static vm:CardForm.Positions}" SelectedItem="{Binding SelectedPosition}" MinWidth="260" IsEnabled="{Binding HasPosition}" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </StackPanel>
                          </Border>
                          <Border Classes="card">
                            <StackPanel>
                              <TextBlock Classes="card-title" Text="Stages" />
                              <TextBlock Classes="muted card-note" Text="What happens the 1st to 4th time the alert is shown in a row" />
                              <Grid Classes="card-columns" ColumnDefinitions="70,*,90,120">
                                <TextBlock Classes="caption" Text="STAGE" />
                                <TextBlock Grid.Column="1" Classes="caption" Text="DEFAULT BUTTON" />
                                <TextBlock Grid.Column="2" Classes="caption" Text="DRAWN" />
                                <TextBlock Grid.Column="3" Classes="caption" Text="SOUND" />
                              </Grid>
                              <!-- The stages: table rows (a click selects one, through the host's row selection). -->
                              <ItemsControl x:Name="AlertStages" ItemsSource="{Binding Stages}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="vm:AlertStage">
                                    <Border Classes="table-row form-row" Classes.selected="{Binding IsSelected}">
                                      <Panel>
                                        <Border Classes="bar" />
                                        <Grid Classes="stage-row" ColumnDefinitions="70,*,90,120">
                                          <TextBlock Text="{Binding Ordinal}" />
                                          <TextBlock Grid.Column="1" Text="{Binding DefaultText}"
                                                     IsVisible="{Binding !$parent[ItemsControl].((vm:AlertForm)DataContext).IsEditing, FallbackValue=True}" />
                                          <ComboBox Grid.Column="1" ItemsSource="{Binding DefaultChoices}" SelectedIndex="{Binding DefaultIndex}" MinWidth="180"
                                                    IsVisible="{Binding $parent[ItemsControl].((vm:AlertForm)DataContext).IsEditing, FallbackValue=False}" AutomationProperties.Name="Default button" />
                                          <TextBlock Grid.Column="2" Text="{Binding DrawnText}"
                                                     IsVisible="{Binding !$parent[ItemsControl].((vm:AlertForm)DataContext).IsEditing, FallbackValue=True}" />
                                          <CheckBox Grid.Column="2" IsChecked="{Binding Drawn}"
                                                    IsVisible="{Binding $parent[ItemsControl].((vm:AlertForm)DataContext).IsEditing, FallbackValue=False}" AutomationProperties.Name="Drawn" />
                                          <TextBlock Grid.Column="3" Text="{Binding SoundName}"
                                                     IsVisible="{Binding !$parent[ItemsControl].((vm:AlertForm)DataContext).IsEditing, FallbackValue=True}" />
                                          <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:AlertStage.Sounds}" SelectedIndex="{Binding SoundIndex}" MinWidth="110"
                                                    IsVisible="{Binding $parent[ItemsControl].((vm:AlertForm)DataContext).IsEditing, FallbackValue=False}" AutomationProperties.Name="Sound" />
                                        </Grid>
                                      </Panel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock x:Name="StageNote" Classes="muted card-note" Text="{Binding StageNote}" TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </ScrollViewer>
                    </DataTemplate>
                    <!-- The dialog item list form (boards/dialog-item-list.md, E3): a table read only, inputs while editing; the
                         preview on the right (the dialog that uses the list, live from the values), its outlined item the
                         selected row, a click on an item selecting its row. -->
                    <DataTemplate DataType="vm:DialogItemsForm">
                      <Grid x:Name="ItemListForm" Classes="menu-form" ColumnDefinitions="3*,2*">
                        <Border Grid.Column="1" Classes="preview-panel ditl-preview">
                          <DockPanel>
                            <Border DockPanel.Dock="Top" Classes="preview-header">
                              <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Classes="muted" Text="1× · Mac OS 8/9" />
                                <TextBlock x:Name="ItemListPreviewTitle" Classes="strong"
                                           Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).FormPreviewTitle, FallbackValue=Preview}" />
                              </DockPanel>
                            </Border>
                            <TextBlock DockPanel.Dock="Top" Classes="muted preview-note"
                                       Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).FormDialogNote, FallbackValue={x:Null}}" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" Background="{DynamicResource CmCheckerboard}">
                              <views:DialogView x:Name="ItemListPreview" Dialog="{Binding $parent[Window].((vm:MainViewModel)DataContext).FormDialog, FallbackValue={x:Null}}"
                                                SelectedIndex="{Binding PreviewIndex, Mode=TwoWay}" Scale="1" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            </ScrollViewer>
                          </DockPanel>
                        </Border>
                        <ScrollViewer Padding="18,12" HorizontalScrollBarVisibility="Disabled">
                          <StackPanel Classes="menu-table" Classes.editing="{Binding IsEditing}">
                            <Grid Classes="menu-columns read-only" ColumnDefinitions="24,96,*,132,56">
                              <TextBlock Classes="caption" Text="#" />
                              <TextBlock Grid.Column="1" Classes="caption" Text="KIND" />
                              <TextBlock Grid.Column="2" Classes="caption" Text="TEXT OR RESOURCE" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="3" Classes="caption" Text="TOP, LEFT, BOTTOM, RIGHT" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="4" Classes="caption" Text="ENABLED" />
                            </Grid>
                            <Grid Classes="menu-columns editing" ColumnDefinitions="24,104,*,172,24,24">
                              <TextBlock Classes="caption" Text="#" />
                              <TextBlock Grid.Column="1" Classes="caption" Text="KIND" />
                              <TextBlock Grid.Column="2" Classes="caption" Text="TEXT OR RESOURCE ID" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="3" Classes="caption" Text="TOP, LEFT, BOTTOM, RIGHT" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="4" Classes="caption" Text="ON" />
                            </Grid>
                            <ItemsControl x:Name="ItemRows" ItemsSource="{Binding Items}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:DialogItemRow">
                                  <Border Classes="table-row ditl-row form-row" Classes.selected="{Binding IsSelected}">
                                    <Panel>
                                      <Border Classes="bar" />
                                      <Grid Classes="read-only" ColumnDefinitions="24,96,*,132,56">
                                        <TextBlock Classes="muted mono" Text="{Binding Number}" />
                                        <TextBlock Grid.Column="1" Text="{Binding KindName}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Content}" Classes.muted="{Binding HasNoContent}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Classes="mono" Text="{Binding BoundsText}" />
                                        <TextBlock Grid.Column="4" Text="{Binding EnabledText}" Classes.muted="{Binding IsDimmed}" />
                                      </Grid>
                                      <Grid Classes="editing" ColumnDefinitions="24,104,*,172,24,24">
                                        <TextBlock Classes="muted mono" Text="{Binding Number}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:DialogItemRow.Kinds}" SelectedItem="{Binding Kind}" AutomationProperties.Name="Kind" />
                                        <TextBox x:Name="ItemText" Grid.Column="2" Text="{Binding Text}" IsVisible="{Binding HasText}" AutomationProperties.Name="Text" />
                                        <NumericUpDown Grid.Column="2" Classes="mono" Value="{Binding ResourceId}" FormatString="0" ShowButtonSpinner="False"
                                                       Minimum="-32768" Maximum="32767" IsVisible="{Binding HasResource}" AutomationProperties.Name="Resource ID" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                          <TextBox x:Name="TopBox" Classes="mono bound" Text="{Binding TopText}" AutomationProperties.Name="Top" />
                                          <TextBox x:Name="LeftBox" Classes="mono bound" Text="{Binding LeftText}" AutomationProperties.Name="Left" />
                                          <TextBox x:Name="BottomBox" Classes="mono bound" Text="{Binding BottomText}" AutomationProperties.Name="Bottom" />
                                          <TextBox x:Name="RightBox" Classes="mono bound" Text="{Binding RightText}" AutomationProperties.Name="Right" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="4" IsChecked="{Binding Enabled}" AutomationProperties.Name="Enabled" />
                                        <Button Grid.Column="5" Classes="flat row-tool remove" Content="×" ToolTip.Tip="Remove" AutomationProperties.Name="Remove"
                                                Command="{Binding $parent[ItemsControl].((vm:DialogItemsForm)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                                      </Grid>
                                    </Panel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Classes="editing" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                              <Button Content="Add item" Command="{Binding AddCommand}" />
                            </StackPanel>
                          </StackPanel>
                        </ScrollViewer>
                      </Grid>
                    </DataTemplate>
                    <!-- The menu form (boards/read-then-edit.md, E2): a summary and a table read only, inputs while
                         editing; the live preview on the right, its highlighted item the selected row. -->
                    <DataTemplate DataType="vm:MenuForm">
                      <Grid x:Name="MenuForm" Classes="menu-form" ColumnDefinitions="2*,*">
                        <Border Grid.Column="1" Classes="preview-panel">
                          <DockPanel>
                            <Border DockPanel.Dock="Top" Classes="preview-header">
                              <WrapPanel>
                                <TextBlock x:Name="PreviewTitle" Classes="strong" Margin="0,0,10,0"
                                           Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).FormPreviewTitle, FallbackValue=Preview}" />
                                <TextBlock Classes="muted" Text="2× · Mac OS 8/9" />
                              </WrapPanel>
                            </Border>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" Background="{DynamicResource CmCheckerboard}">
                              <views:MenuView x:Name="MenuPreview" Menu="{Binding Preview}" SelectedIndex="{Binding PreviewIndex, Mode=TwoWay}" Scale="2"
                                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                            </ScrollViewer>
                          </DockPanel>
                        </Border>
                        <ScrollViewer Padding="18,12">
                          <StackPanel Spacing="12">
                            <WrapPanel Classes="menu-summary" IsVisible="{Binding !IsEditing}">
                              <TextBlock Classes="muted" Text="Menu title" />
                              <TextBlock Classes="value" Text="{Binding Title}" />
                              <TextBlock Classes="muted" Text="Enabled" />
                              <TextBlock Classes="value" Text="{Binding EnabledText}" />
                              <TextBlock Classes="muted" Text="Menu ID" />
                              <TextBlock Classes="value mono" Text="{Binding IdText}" />
                              <TextBlock Classes="muted" Text="MDEF" />
                              <TextBlock Classes="value mono" Text="{Binding DefinitionText}" />
                            </WrapPanel>
                            <WrapPanel Classes="menu-fields" IsVisible="{Binding IsEditing}">
                              <StackPanel>
                                <TextBlock Classes="muted" Text="Title" />
                                <TextBox Text="{Binding Title}" Width="130" AutomationProperties.Name="Menu title" />
                              </StackPanel>
                              <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" />
                              <StackPanel>
                                <TextBlock Classes="muted" Text="ID" />
                                <NumericUpDown Classes="mono" Value="{Binding Id}" FormatString="0" Width="68" ShowButtonSpinner="False"
                                               Minimum="-32768" Maximum="32767" AutomationProperties.Name="Menu ID" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Classes="muted" Text="MDEF" />
                                <NumericUpDown Classes="mono" Value="{Binding Definition}" FormatString="0" Width="68" ShowButtonSpinner="False"
                                               Minimum="-32768" Maximum="32767" AutomationProperties.Name="MDEF" />
                              </StackPanel>
                            </WrapPanel>
                            <StackPanel Classes="menu-table" Classes.editing="{Binding IsEditing}">
                              <Grid Classes="menu-columns read-only" ColumnDefinitions="28,*,52,44,40,120,60">
                                <TextBlock Classes="caption" Text="#" />
                                <TextBlock Grid.Column="1" Classes="caption" Text="TEXT" />
                                <TextBlock Grid.Column="2" Classes="caption" Text="⌘ KEY" />
                                <TextBlock Grid.Column="3" Classes="caption" Text="MARK" />
                                <TextBlock Grid.Column="4" Classes="caption" Text="ICON" />
                                <TextBlock Grid.Column="5" Classes="caption" Text="STYLE" />
                                <TextBlock Grid.Column="6" Classes="caption" Text="ENABLED" />
                              </Grid>
                              <Grid Classes="menu-columns editing" ColumnDefinitions="28,*,40,84,40,126,28,28">
                                <TextBlock Grid.Column="1" Classes="caption" Text="TEXT" />
                                <TextBlock Grid.Column="2" Classes="caption" Text="⌘ KEY" />
                                <TextBlock Grid.Column="3" Classes="caption" Text="MARK" />
                                <TextBlock Grid.Column="4" Classes="caption" Text="ICON" />
                                <TextBlock Grid.Column="5" Classes="caption" Text="STYLE" />
                                <TextBlock Grid.Column="6" Classes="caption" Text="ON" />
                              </Grid>
                              <ItemsControl x:Name="MenuRows" ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="vm:MenuItemRow">
                                    <Border Classes="table-row form-row" Classes.selected="{Binding IsSelected}" Classes.dimmed="{Binding IsDimmed}"
                                            Classes.divider="{Binding IsDivider}">
                                      <Panel>
                                        <Border Classes="bar" />
                                        <Grid Classes="read-only" ColumnDefinitions="28,*,52,44,40,120,60">
                                          <TextBlock Classes="muted mono" Text="{Binding Number}" />
                                          <TextBlock Grid.Column="1" Classes="item-text" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                          <StackPanel Grid.Column="1" Classes="divider-mark" Orientation="Horizontal" Spacing="8">
                                            <Border Classes="rule" />
                                            <TextBlock Classes="muted" Text="divider" />
                                          </StackPanel>
                                          <TextBlock Grid.Column="2" Classes="mono cell" Text="{Binding KeyText}" />
                                          <TextBlock Grid.Column="3" Classes="cell" Text="{Binding MarkText}" />
                                          <TextBlock Grid.Column="4" Classes="mono cell" Text="{Binding IconText}" />
                                          <TextBlock Grid.Column="5" Classes="cell" Text="{Binding StyleText}" TextTrimming="CharacterEllipsis" />
                                          <TextBlock Grid.Column="6" Classes="cell" Text="{Binding EnabledText}" />
                                        </Grid>
                                        <Grid Classes="editing" ColumnDefinitions="28,*,40,84,40,126,28,28">
                                          <StackPanel Classes="move">
                                            <Button Classes="flat row-tool" Content="▲" ToolTip.Tip="Move up" AutomationProperties.Name="Move up"
                                                    Command="{Binding $parent[ItemsControl].((vm:MenuForm)DataContext).MoveUpCommand}" CommandParameter="{Binding}" />
                                            <Button Classes="flat row-tool" Content="▼" ToolTip.Tip="Move down" AutomationProperties.Name="Move down"
                                                    Command="{Binding $parent[ItemsControl].((vm:MenuForm)DataContext).MoveDownCommand}" CommandParameter="{Binding}" />
                                          </StackPanel>
                                          <TextBox Grid.Column="1" Text="{Binding Text}" AutomationProperties.Name="Text" />
                                          <TextBox Grid.Column="2" Classes="mono key" Classes.conflict="{Binding HasKeyConflict}" Text="{Binding Key}"
                                                   HorizontalContentAlignment="Center" AutomationProperties.Name="Command key" />
                                          <ComboBox Grid.Column="3" ItemsSource="{Binding MarkChoices}" SelectedItem="{Binding MarkChoice}" AutomationProperties.Name="Mark" />
                                          <NumericUpDown Grid.Column="4" Classes="mono" Value="{Binding Icon}" FormatString="0" ShowButtonSpinner="False"
                                                         Minimum="0" Maximum="255" AutomationProperties.Name="Icon" />
                                          <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2">
                                            <ToggleButton Classes="style-bit" Content="B" FontWeight="Bold" IsChecked="{Binding Bold}" ToolTip.Tip="Bold" />
                                            <ToggleButton Classes="style-bit" Content="I" FontStyle="Italic" IsChecked="{Binding Italic}" ToolTip.Tip="Italic" />
                                            <ToggleButton Classes="style-bit" ToolTip.Tip="Underline" IsChecked="{Binding Underline}">
                                              <TextBlock Text="U" TextDecorations="Underline" />
                                            </ToggleButton>
                                            <Button Classes="style-bit more" Classes.on="{Binding HasMoreStyles}" Content="More" ToolTip.Tip="Outline, Shadow, Condense, Extend">
                                              <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                  <StackPanel Spacing="4">
                                                    <CheckBox Content="Outline" IsChecked="{Binding Outline}" />
                                                    <CheckBox Content="Shadow" IsChecked="{Binding Shadow}" />
                                                    <CheckBox Content="Condense" IsChecked="{Binding Condense}" />
                                                    <CheckBox Content="Extend" IsChecked="{Binding Extend}" />
                                                  </StackPanel>
                                                </Flyout>
                                              </Button.Flyout>
                                            </Button>
                                          </StackPanel>
                                          <CheckBox Grid.Column="6" IsChecked="{Binding Enabled}" AutomationProperties.Name="Enabled" />
                                          <Button Grid.Column="7" Classes="flat row-tool remove" Content="×" ToolTip.Tip="Remove" AutomationProperties.Name="Remove"
                                                  Command="{Binding $parent[ItemsControl].((vm:MenuForm)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                      </Panel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <StackPanel Classes="editing" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Content="Add item" Command="{Binding AddCommand}" />
                                <Button Content="Add divider" Command="{Binding AddDividerCommand}" />
                              </StackPanel>
                            </StackPanel>
                          </StackPanel>
                        </ScrollViewer>
                      </Grid>
                    </DataTemplate>
                    <!-- The control form (E4): property cards like a window's. -->
                    <DataTemplate DataType="vm:ControlForm">
                      <ScrollViewer>
                        <StackPanel x:Name="ControlCards" Classes="cards">
                          <Border Classes="card">
                            <StackPanel>
                              <TextBlock Classes="card-title" Text="Bounds" />
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Top, left" />
                                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding TopLeftText}" IsVisible="{Binding !IsEditing}" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsEditing}">
                                    <NumericUpDown Value="{Binding Top}" FormatString="0" Width="110" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Top" />
                                    <NumericUpDown Value="{Binding Left}" FormatString="0" Width="110" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Left" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Bottom, right" />
                                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding BottomRightText}" IsVisible="{Binding !IsEditing}" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsEditing}">
                                    <NumericUpDown Value="{Binding Bottom}" FormatString="0" Width="110" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Bottom" />
                                    <NumericUpDown Value="{Binding Right}" FormatString="0" Width="110" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Right" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                              <Border Classes="card-line last">
                                <Grid Classes="card-row last" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Size" />
                                  <TextBlock Grid.Column="1" Text="{Binding SizeText}" />
                                </Grid>
                              </Border>
                            </StackPanel>
                          </Border>
                          <Border Classes="card">
                            <StackPanel>
                              <TextBlock Classes="card-title" Text="Control" />
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Title" />
                                  <TextBlock Grid.Column="1" Text="{Binding TitleText}" IsVisible="{Binding !IsEditing}" />
                                  <TextBox Grid.Column="1" Text="{Binding Title}" MinWidth="200" MaxWidth="320" HorizontalAlignment="Left" IsVisible="{Binding IsEditing}" />
                                </Grid>
                              </Border>
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Definition" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
                                    <TextBlock Text="{Binding DefinitionName}" />
                                    <TextBlock Classes="mono muted" Text="{Binding DefinitionCode}" />
                                  </StackPanel>
                                  <ComboBox Grid.Column="1" ItemsSource="{Binding Definitions}" SelectedItem="{Binding SelectedDefinition}" MinWidth="240" IsVisible="{Binding IsEditing}" />
                                </Grid>
                              </Border>
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Value" />
                                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding ValueText}" IsVisible="{Binding !IsEditing}" />
                                  <NumericUpDown Grid.Column="1" Value="{Binding Value}" FormatString="0" Width="110" HorizontalAlignment="Left" Minimum="-32768" Maximum="32767" IsVisible="{Binding IsEditing}" />
                                </Grid>
                              </Border>
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Minimum, maximum" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsEditing}">
                                    <TextBlock Classes="mono" Text="{Binding MinimumText}" />
                                    <TextBlock Classes="mono" Text="–" />
                                    <TextBlock Classes="mono" Text="{Binding MaximumText}" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsEditing}">
                                    <NumericUpDown Value="{Binding Minimum}" FormatString="0" Width="110" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Minimum" />
                                    <NumericUpDown Value="{Binding Maximum}" FormatString="0" Width="110" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Maximum" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Visible" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsEditing}">
                                    <Ellipse Classes="dot" Classes.on="{Binding Visible}" />
                                    <TextBlock Text="{Binding VisibleText}" />
                                  </StackPanel>
                                  <CheckBox Grid.Column="1" IsChecked="{Binding Visible}" IsVisible="{Binding IsEditing}" AutomationProperties.Name="Visible" />
                                </Grid>
                              </Border>
                              <Border Classes="card-line last">
                                <Grid Classes="card-row form-row last" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Reference constant" />
                                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding RefConText}" IsVisible="{Binding !IsEditing}" />
                                  <NumericUpDown Grid.Column="1" Value="{Binding RefCon}" FormatString="0" Width="160" HorizontalAlignment="Left" Minimum="-2147483648" Maximum="2147483647" IsVisible="{Binding IsEditing}" />
                                </Grid>
                              </Border>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </ScrollViewer>
                    </DataTemplate>
                    <!-- The template form (boards/template-form.md, E6): the note banner, the fields in a card, each list as a
                         heading and item cards (a list inside an item as a compact table); the template panel on the right. -->
                    <DataTemplate DataType="vm:TemplateForm">
                      <Grid x:Name="TemplateCards" ColumnDefinitions="*,Auto">
                        <DockPanel>
                          <Border x:Name="TemplateNote" DockPanel.Dock="Top" Classes="note-banner" IsVisible="{Binding HasNote}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <views:SeverityIcon Severity="Warning" Width="14" Height="14" VerticalAlignment="Top" />
                              <TextBlock Text="{Binding Note}" TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <Border Classes="card">
                              <ItemsControl ItemsSource="{Binding Fields}" Margin="0,4" />
                            </Border>
                          </ScrollViewer>
                        </DockPanel>
                        <Border Grid.Column="1" Classes="template-panel">
                          <StackPanel Spacing="8">
                            <TextBlock Classes="caption" Text="TEMPLATE" />
                            <TextBlock Text="{Binding Source}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted note" Text="{x:Static vm:TemplateForm.SourceRule}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Outline}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TemplateOutlineLine">
                                  <Grid ColumnDefinitions="*,Auto" Margin="{Binding Indent, Converter={x:Static views:TemplateViews.Indent}}">
                                    <TextBlock Classes="outline" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Classes="outline muted" Text="{Binding Type}" Margin="8,0,0,0" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="muted note" Text="“Edit with template” off: the resource opens in Hex only." TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </DataTemplate>
                    <DataTemplate DataType="vm:TemplateScalarRow">
                      <Border Classes="card-line">
                        <Grid Classes="card-row form-row template-field" ColumnDefinitions="180,*,Auto">
                          <TextBlock Classes="label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
                            <TextBlock Classes="value" Classes.code="{Binding IsCode}" Text="{Binding DisplayText}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted count-note" Text="{Binding CountNote}" IsVisible="{Binding IsReadOnly}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditing}">
                            <TextBox Text="{Binding Text}" IsVisible="{Binding IsEditableText}" MinWidth="160" TextWrapping="Wrap" AutomationProperties.Name="{Binding Label}" />
                            <CheckBox IsChecked="{Binding Flag}" IsVisible="{Binding IsFlag}" AutomationProperties.Name="{Binding Label}" />
                            <TextBlock Classes="value" Text="{Binding DisplayText}" IsVisible="{Binding IsReadOnly}" />
                            <TextBlock Classes="muted count-note" Text="{Binding CountNote}" IsVisible="{Binding IsReadOnly}" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Classes="type-code" Text="{Binding Type}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                    <DataTemplate DataType="vm:TemplateListRow">
                      <StackPanel Classes="template-list" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="list-heading" Text="{Binding Heading}" />
                          <TextBlock Classes="muted" Text="{Binding Summary}" VerticalAlignment="Center" />
                          <Button Content="{Binding AddLabel}" Command="{Binding AddCommand}" IsVisible="{Binding IsEditing}" />
                        </StackPanel>
                        <!-- Top-level lists: a card per item. -->
                        <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding !IsCompact}" />
                        <!-- A list inside an item: a compact table. -->
                        <StackPanel Classes="compact-table" IsVisible="{Binding IsCompact}">
                          <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <TextBlock Classes="caption table-cell" Text="{Binding}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="vm:TemplateItemRow">
                                <StackPanel Classes="form-row" Orientation="Horizontal">
                                  <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                      </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="vm:TemplateRow">
                                        <Panel Classes="table-cell">
                                          <TextBlock Text="{Binding $parent[Panel].((vm:TemplateScalarRow)DataContext).DisplayText, FallbackValue={x:Null}}"
                                                     IsVisible="{Binding !IsEditing}" />
                                          <TextBox Text="{Binding $parent[Panel].((vm:TemplateScalarRow)DataContext).Text, FallbackValue={x:Null}}"
                                                   IsVisible="{Binding IsEditing}" MinWidth="0" Width="104" />
                                        </Panel>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <Button Classes="link danger" Content="Remove" Command="{Binding List.RemoveCommand}" CommandParameter="{Binding}"
                                          IsVisible="{Binding List.IsEditing}" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="vm:TemplateItemRow">
                      <Border Classes="card item-card">
                        <StackPanel>
                          <Border Classes="item-header form-row">
                            <DockPanel>
                              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" IsVisible="{Binding List.IsEditing}">
                                <Button Classes="link" Content="Insert before" Command="{Binding List.InsertCommand}" CommandParameter="{Binding}" />
                                <Button Classes="link danger" Content="Remove" Command="{Binding List.RemoveCommand}" CommandParameter="{Binding}" />
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="muted" Text="{Binding Title}" />
                                <TextBlock Classes="item-key" Text="{Binding KeyText}" />
                                <TextBlock Classes="muted" Text="{Binding ItemSummary}" />
                              </StackPanel>
                            </DockPanel>
                          </Border>
                          <ItemsControl ItemsSource="{Binding Fields}" Margin="0,2" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ContentControl.DataTemplates>
                </ContentControl>
                </DockPanel>
                </Border>
              </DockPanel>
            </Panel>
          </TabItem>

          <TabItem Header="Hex" IsVisible="{Binding HasHex}">
            <!-- The hex view (boards/hex.md, E7): the resource's bytes in a grid, edited in place with Edit Hex (Ctrl+H) or
                 Edit Bytes; while editing, the byte inspector on the right and the footer with the mode switch, status,
                 Discard and Apply. -->
            <DockPanel x:Name="HexPane">
              <Border DockPanel.Dock="Top" Classes="hex-bar">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding GoToError}" Classes="error" VerticalAlignment="Center"
                               IsVisible="{Binding GoToError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="Go to" Classes="muted" VerticalAlignment="Center" />
                    <TextBox x:Name="GoToBox" Classes="go-to" PlaceholderText="0x0000" Text="{Binding GoToText}" IsEnabled="{Binding IsHexEditing}"
                             AutomationProperties.Name="Go to offset">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding GoToCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                  </StackPanel>
                  <Panel HorizontalAlignment="Left">
                    <Button Content="Edit Bytes" Command="{Binding BeginHexEditCommand}" IsVisible="{Binding !IsHexEditing}" />
                    <Border Classes="editing-badge" IsVisible="{Binding IsHexEditing}" VerticalAlignment="Center">
                      <TextBlock Text="Editing bytes" />
                    </Border>
                  </Panel>
                </DockPanel>
              </Border>
              <Border x:Name="HexFooter" DockPanel.Dock="Bottom" Classes="host-footer" IsVisible="{Binding IsHexEditing}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="Discard" Command="{Binding DiscardHexEditCommand}" />
                    <Button Classes="accent" Content="Apply" Command="{Binding ApplyHexEditCommand}" />
                  </StackPanel>
                  <ListBox x:Name="HexMode" DockPanel.Dock="Left" Classes="segmented" ItemsSource="{x:Static vm:HexEditor.Modes}"
                           SelectedIndex="{Binding HexEdit.ModeIndex, Mode=TwoWay, FallbackValue=0}" AutomationProperties.Name="Overwrite or insert" />
                  <TextBlock Classes="hex-status" Text="{Binding HexEdit.Status, FallbackValue={x:Null}}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </Border>
              <Border x:Name="HexInspector" DockPanel.Dock="Right" Classes="hex-inspector" IsVisible="{Binding HexInspection, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="4">
                  <TextBlock Classes="caption" Text="{Binding HexInspection.Heading, FallbackValue={x:Null}}" />
                  <ItemsControl ItemsSource="{Binding HexInspection.Rows, FallbackValue={x:Null}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:HexReading">
                        <Grid ColumnDefinitions="76,*" Margin="0,2">
                          <TextBlock Text="{Binding Label}" Classes="muted" />
                          <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Spacing="4" Margin="0,12,0,0"
                              IsVisible="{Binding HexInspection.Meaning, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                    <TextBlock Classes="caption" Text="IN THIS RESOURCE" />
                    <TextBlock Text="{Binding HexInspection.Meaning.Text, FallbackValue={x:Null}}" TextWrapping="Wrap" />
                    <TextBlock Classes="mono" Text="{Binding HexInspection.Meaning.Value, StringFormat='= {0}', FallbackValue={x:Null}}"
                               IsVisible="{Binding HexInspection.Meaning.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <!-- As the read-then-edit host (E1): a 3 px CmAccent line over the values while editing. -->
              <Border x:Name="HexEditLine" DockPanel.Dock="Top" Height="3" Background="{DynamicResource CmAccent}" IsVisible="{Binding IsHexEditing}" />
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Classes="hex-header">
                <TextBlock Classes="hex-offset" Text="Offset" />
                <ItemsControl ItemsSource="{x:Static vm:HexLines.HeaderCells}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:HexCell">
                      <Border Classes="hex-cell" Classes.group-end="{Binding IsGroupEnd}">
                        <TextBlock Text="{Binding Hex}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="hex-text" Text="Mac OS Roman" />
              </StackPanel>
              <ListBox x:Name="HexList" Classes="hex pane" ItemsSource="{Binding HexLines, TargetNullValue={x:Static vm:HexLines.None}}" FontFamily="{StaticResource CmFontMono}" FontSize="13">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:HexLine">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Classes="hex-offset" Text="{Binding DisplayOffset}" />
                      <ItemsControl ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:HexCell">
                            <Border Classes="hex-cell" Classes.group-end="{Binding IsGroupEnd}" Classes.zero="{Binding IsZero}"
                                    Classes.in-field="{Binding IsInField}" Classes.selected="{Binding IsSelected}"
                                    Classes.changed="{Binding IsChanged}" Classes.cursor="{Binding IsCursor}">
                              <TextBlock Text="{Binding Hex}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl ItemsSource="{Binding Cells}" Margin="12,0,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:HexCell">
                            <Border Classes="hex-char" Classes.in-field="{Binding IsInField}" Classes.selected="{Binding IsSelected}"
                                    Classes.changed="{Binding IsChanged}" Classes.cursor="{Binding IsCursor}">
                              <TextBlock Text="{Binding Character}" Classes.muted="{Binding IsPlaceholder}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>
        </TabControl>
        </DockPanel>

        <!-- The empty state (boards/empty-state.md, S5): over the inspector while nothing is open. -->
        <Border x:Name="EmptyState" Grid.Column="2" Classes="empty-state" IsVisible="{Binding IsEmpty}">
          <ScrollViewer>
            <StackPanel Width="640" HorizontalAlignment="Center" Margin="0,40" Spacing="24">
              <Border x:Name="DropZone" Classes="drop-zone" Classes.active="{Binding IsDropTarget}">
                <Panel>
                  <Rectangle Classes="dash" />
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Spacing="14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                      <Image RenderOptions.BitmapInterpolationMode="None" Width="48" Height="48" Source="{Binding Source={x:Static vm:TreeIconKind.HardDisk}, Converter={x:Static views:TreeIcons.IconConverter}}" />
                      <Image RenderOptions.BitmapInterpolationMode="None" Width="48" Height="48" Source="{Binding Source={x:Static vm:TreeIconKind.Floppy}, Converter={x:Static views:TreeIcons.IconConverter}}" />
                      <Image RenderOptions.BitmapInterpolationMode="None" Width="48" Height="48" Source="{Binding Source={x:Static vm:TreeIconKind.Parcel}, Converter={x:Static views:TreeIcons.IconConverter}}" />
                      <Image RenderOptions.BitmapInterpolationMode="None" Width="48" Height="48" Source="{Binding Source={x:Static vm:TreeIconKind.Application}, Converter={x:Static views:TreeIcons.IconConverter}}" />
                    </StackPanel>
                    <TextBlock Classes="empty-title" Text="Drop a Mac file, disk image or archive here" />
                    <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                               Text="HFS and HFS+ volume images, archives, MacBinary, BinHex, AppleSingle and AppleDouble files, or a file with its resource fork. ClassicMac shows everything inside, down to single resources." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                      <Button Classes="accent" Content="Open…" Command="{Binding OpenCommand}" />
                      <TextBlock Classes="mono muted" Text="Ctrl+O" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Panel>
              </Border>
              <StackPanel x:Name="RecentList" Spacing="8" IsVisible="{Binding HasRecentFiles}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="flat link" Content="Clear list" Command="{Binding ClearRecentCommand}" />
                  <TextBlock Classes="caption" Text="RECENT" VerticalAlignment="Center" />
                </DockPanel>
                <Border Classes="recent-list">
                  <ItemsControl ItemsSource="{Binding RecentFiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:RecentFile">
                        <Button Classes="flat recent" Command="{Binding #EmptyState.((vm:MainViewModel)DataContext).OpenRecentCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="{Binding Path}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image RenderOptions.BitmapInterpolationMode="None" Width="16" Height="16" Source="{Binding IconKind, Converter={x:Static views:TreeIcons.IconConverter}}" />
                            <TextBlock Text="{Binding Name}" Classes.muted="{Binding !Exists}" VerticalAlignment="Center" />
                            <TextBlock Classes="muted" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" MaxWidth="380" VerticalAlignment="Center" />
                            <TextBlock Classes="muted" Text="Not found" IsVisible="{Binding !Exists}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- The drag handle: a 6 px strip with a 36 x 2 grip; hidden while the panel is collapsed. -->
      <GridSplitter Grid.Row="1" Classes="handle" ResizeDirection="Rows" IsVisible="{Binding DiagnosticsPanel.IsExpanded}"
                    AutomationProperties.Name="Resize the diagnostics" />

      <!-- The diagnostics panel (design/boards/diagnostics.md): header bar, column headers, rows grouped by file. -->
      <DockPanel Grid.Row="2" DataContext="{Binding DiagnosticsPanel}" x:DataType="vm:DiagnosticsPanel">
        <Border DockPanel.Dock="Top" Classes="chrome diagnostics-header" Classes.collapsed="{Binding !IsExpanded}"
                Height="{DynamicResource CmPanelHeader}" Padding="4,0,8,0" BorderBrush="{DynamicResource CmBorder}">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Left" Classes="flat" IsChecked="{Binding IsExpanded, Mode=TwoWay}" VerticalAlignment="Center"
                          ToolTip.Tip="Show or hide the diagnostics (Ctrl+Shift+D)" AutomationProperties.Name="Diagnostics">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Classes="chevron" Width="10" Height="10" Data="M2,4 L5,7 L8,4" />
                <TextBlock Text="Diagnostics" FontWeight="{DynamicResource CmFontWeightStrong}" />
              </StackPanel>
            </ToggleButton>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0" VerticalAlignment="Center">
              <Border Classes="badge error" IsVisible="{Binding HasErrors}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <views:SeverityIcon Severity="Error" Width="12" Height="12" />
                  <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding IsExpanded}" />
                  <TextBlock Text="{Binding ErrorCount}" IsVisible="{Binding !IsExpanded}" />
                </StackPanel>
              </Border>
              <Border Classes="badge warning" IsVisible="{Binding HasWarnings}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <views:SeverityIcon Severity="Warning" Width="12" Height="12" />
                  <TextBlock Text="{Binding WarningText}" IsVisible="{Binding IsExpanded}" />
                  <TextBlock Text="{Binding WarningCount}" IsVisible="{Binding !IsExpanded}" />
                </StackPanel>
              </Border>
              <!-- Collapsed, only the error and warning numbers show. -->
              <Border Classes="badge info">
                <Border.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsExpanded" />
                    <Binding Path="HasInfos" />
                  </MultiBinding>
                </Border.IsVisible>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <views:SeverityIcon Severity="Info" Width="12" Height="12" />
                  <TextBlock Text="{Binding InfoText}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsExpanded}">
              <TextBox Width="200" Height="26" MinHeight="0" Padding="8,3" PlaceholderText="Filter messages" Text="{Binding Search, Mode=TwoWay}"
                       AutomationProperties.Name="Filter messages" />
              <ListBox Classes="segmented" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}" VerticalAlignment="Center">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:DiagnosticFilter">
                    <TextBlock Text="{Binding Converter={x:Static views:DiagnosticsLabels.Filter}}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <ToggleButton Classes="flat outlined" Content="By file" IsChecked="{Binding ByFile, Mode=TwoWay}" />
            </StackPanel>
            <!-- Collapsed with nothing open: "Nothing opened yet" (boards/empty-state.md). -->
            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Classes="muted" Text="{Binding Placeholder}">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="!IsExpanded" />
                  <Binding Path="Placeholder" Converter="{x:Static ObjectConverters.IsNotNull}" />
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <!-- Collapsed: the latest problem. -->
            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" Classes="muted">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="!IsExpanded" />
                  <Binding Path="HasLatest" />
                </MultiBinding>
              </TextBlock.IsVisible>
              <Run Text="Latest: " /><Run Text="{Binding Latest.Code, FallbackValue={x:Null}}" Foreground="{DynamicResource CmError}"
                   FontFamily="{DynamicResource CmFontMono}" /><Run Text=" " /><Run Text="{Binding LatestPlace}" />
            </TextBlock>
          </DockPanel>
        </Border>

        <!-- Column headers. -->
        <Border DockPanel.Dock="Top" Classes="pane" Height="26" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CmDivider}"
                IsVisible="{Binding IsExpanded}">
          <Grid ColumnDefinitions="110,260,210,*,90" Classes.grouped="{Binding ByFile}" Classes="diagnostic-columns">
            <Button Classes="flat" Padding="0" VerticalAlignment="Center" Command="{Binding SortBySeverityCommand}"
                    ToolTip.Tip="Sort by severity" AutomationProperties.Name="Sort by severity">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="caption" Text="SEVERITY" />
                <TextBlock Classes="caption" Text="{Binding Sort, Converter={x:Static views:DiagnosticsLabels.Sort}}" />
              </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Classes="caption" Text="SOURCE" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="caption" Text="CODE" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Classes="caption" Text="MESSAGE" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <ListBox x:Name="DiagnosticList" Classes="pane diagnostics" Classes.grouped="{Binding ByFile}" IsVisible="{Binding IsExpanded}"
                 ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:DiagnosticGroup">
              <Border Classes="sidebar diagnostic-group">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <PathIcon Classes="chevron" Classes.collapsed="{Binding !IsExpanded}" Width="10" Height="10" Data="M2,4 L5,7 L8,4" />
                  <Image Width="16" Height="16" RenderOptions.BitmapInterpolationMode="None" Source="{Binding Kind, Converter={x:Static views:TreeIcons.KindConverter}}" />
                  <TextBlock Text="{Binding Path}" FontWeight="{DynamicResource CmFontWeightStrong}" />
                  <TextBlock Text="{Binding Counts}" Classes="muted" />
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:DiagnosticEntry">
              <Border Classes="diagnostic-row">
                <Grid ColumnDefinitions="110,260,210,*,90" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <views:SeverityIcon Severity="{Binding Diagnostic.Severity}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Severity}" FontWeight="{DynamicResource CmFontWeightStrong}"
                               Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}" Classes.info="{Binding IsInfo}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Source}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="2" Classes="mono muted" Text="{Binding Code}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="3" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                  <!-- On the selected row only (style), for an entry with a node. -->
                  <Panel Grid.Column="4" IsVisible="{Binding HasNode}">
                    <Button Classes="link show-item" Content="Show item" HorizontalAlignment="Right"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowItemCommand, FallbackValue={x:Null}}"
                            CommandParameter="{Binding}" ToolTip.Tip="Select it in the tree" />
                  </Panel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
