<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClassicMac.App.ViewModels"
        xmlns:views="using:ClassicMac.App.Views"
        x:Class="ClassicMac.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ClassicMac"
        Width="1200" Height="780" MinWidth="700" MinHeight="450"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <Style Selector="TreeViewItem" x:DataType="vm:NodeViewModel">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    </Style>
    <Style Selector="ListBox.hex ListBoxItem">
      <Setter Property="Padding" Value="12,1" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open…" Command="{Binding OpenCommand}" InputGesture="Ctrl+O" HotKey="Ctrl+O" />
        <MenuItem Header="_Close" Command="{Binding CloseCommand}" InputGesture="Ctrl+W" HotKey="Ctrl+W" />
        <Separator />
        <MenuItem Header="_Quit" Click="OnQuit" />
      </MenuItem>
      <MenuItem Header="_Export">
        <MenuItem Header="_Save Resource As…" Command="{Binding SaveResourceAsCommand}" InputGesture="Ctrl+S" HotKey="Ctrl+S" />
        <MenuItem Header="_Export Resources…" Command="{Binding ExportResourcesCommand}" />
        <MenuItem Header="E_xtract All Resources…" Command="{Binding ExtractAllCommand}" />
        <MenuItem Header="_Convert Documents…" Command="{Binding ConvertDocumentsCommand}" />
        <Separator />
        <MenuItem Header="_Unpack (AppleDouble)…" Command="{Binding UnpackAppleDoubleCommand}" />
        <MenuItem Header="Unpack (_Basilisk II)…" Command="{Binding UnpackBasiliskCommand}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Padding="8,3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
    </Border>

    <Grid RowDefinitions="*,5,180">
      <Grid ColumnDefinitions="380,5,*">
        <TreeView ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected, Mode=TwoWay}">
          <TreeView.ItemTemplate>
            <TreeDataTemplate DataType="vm:NodeViewModel" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="14" Height="14" Data="{Binding Kind, Converter={x:Static views:NodeIcons.Converter}}" />
                <TextBlock Text="{Binding Title}" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
          <TreeView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="_Save Resource As…" Command="{Binding SaveResourceAsCommand}" InputGesture="Ctrl+S" />
              <MenuItem Header="_Export Resources…" Command="{Binding ExportResourcesCommand}" />
              <MenuItem Header="E_xtract All Resources…" Command="{Binding ExtractAllCommand}" />
              <MenuItem Header="_Convert Documents…" Command="{Binding ConvertDocumentsCommand}" />
              <Separator />
              <MenuItem Header="_Unpack (AppleDouble)…" Command="{Binding UnpackAppleDoubleCommand}" />
              <MenuItem Header="Unpack (_Basilisk II)…" Command="{Binding UnpackBasiliskCommand}" />
            </ContextMenu>
          </TreeView.ContextMenu>
        </TreeView>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

        <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Padding="0">
          <TabItem Header="Details">
            <ScrollViewer Padding="16,12">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Details.Heading}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Details.Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:DetailRow">
                      <Grid ColumnDefinitions="140,*" Margin="0,2">
                        <TextBlock Text="{Binding Label}" Opacity="0.65" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Preview">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="12,8" IsVisible="{Binding Preview.IsImage}">
                <TextBlock Text="Zoom" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Zooms}" SelectedItem="{Binding Zoom, Mode=TwoWay}" />
                <TextBlock Text="Screen depth" VerticalAlignment="Center" Margin="12,0,0,0" />
                <ComboBox ItemsSource="{Binding ScreenDepths}" SelectedItem="{Binding ScreenDepth, Mode=TwoWay}" />
              </StackPanel>
              <Panel>
                <TextBlock Text="{Binding Preview.Message}" Margin="16" Opacity="0.65" IsVisible="{Binding Preview.IsMessage}" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" IsVisible="{Binding Preview.IsImage}">
                  <ItemsControl ItemsSource="{Binding Images}" Margin="12">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:ImageItem">
                        <StackPanel Margin="0,0,16,16" Spacing="4">
                          <Border Background="{x:Static views:Images.Checkerboard}" HorizontalAlignment="Left">
                            <Image Source="{Binding Image.Png, Converter={x:Static views:Images.FromPng}}"
                                   Width="{Binding Width}" Height="{Binding Height}" Stretch="Fill"
                                   RenderOptions.BitmapInterpolationMode="None" />
                          </Border>
                          <TextBlock Text="{Binding Image.Caption}" Opacity="0.65" FontSize="12" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <ScrollViewer IsVisible="{Binding Preview.IsStyledText}" Padding="16,12">
                  <views:StyledTextView Styled="{Binding Preview.Styled}" TextWrapping="Wrap" />
                </ScrollViewer>
                <ScrollViewer IsVisible="{Binding Preview.IsPlainText}" Padding="16,12" HorizontalScrollBarVisibility="Auto">
                  <SelectableTextBlock Text="{Binding Preview.Text}" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" />
                </ScrollViewer>
                <DockPanel IsVisible="{Binding Preview.IsDocument}">
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="12,8">
                    <Button Content="Back" Command="{Binding Preview.Document.BackCommand, FallbackValue={x:Null}}" />
                    <ComboBox ItemsSource="{Binding Preview.Document.ChapterTitles, FallbackValue={x:Null}}" MinWidth="260"
                              SelectedIndex="{Binding Preview.Document.ChapterIndex, Mode=TwoWay, FallbackValue=0}"
                              IsVisible="{Binding Preview.Document.HasChapters, FallbackValue=False}" />
                  </StackPanel>
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" Background="{Binding Preview.Document.Background, FallbackValue={x:Null}}"
                                Offset="{Binding Preview.Document.Offset, Mode=TwoWay, FallbackValue={x:Static Vector.Zero}}">
                    <ItemsControl ItemsSource="{Binding Preview.Document.Items, FallbackValue={x:Null}}" Margin="16,12" HorizontalAlignment="Center"
                                  Width="{Binding Preview.Document.ColumnWidth, FallbackValue=NaN}">
                      <ItemsControl.DataTemplates>
                        <DataTemplate DataType="vm:DocumentTextItem">
                          <views:StyledTextView Styled="{Binding Text}" Scale="1" TextWrapping="Wrap" TextAlignment="{Binding Alignment}" />
                        </DataTemplate>
                        <DataTemplate DataType="vm:DocumentRowItem">
                          <Grid ColumnDefinitions="*,Auto,*">
                            <ItemsControl ItemsSource="{Binding Left}" HorizontalAlignment="Left">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate><DataTemplate DataType="vm:DocumentPictureItem"><views:DocumentPictureView Item="{Binding}" VerticalAlignment="Top" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Center}">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate><DataTemplate DataType="vm:DocumentPictureItem"><views:DocumentPictureView Item="{Binding}" VerticalAlignment="Top" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Right}" HorizontalAlignment="Right">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate><DataTemplate DataType="vm:DocumentPictureItem"><views:DocumentPictureView Item="{Binding}" VerticalAlignment="Top" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.DataTemplates>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
                <DockPanel IsVisible="{Binding Preview.IsSound}" Margin="12,8">
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <Button Content="Play" Command="{Binding PlaySoundCommand}" />
                    <Button Content="Stop" Command="{Binding StopSoundCommand}" />
                    <TextBlock Text="{Binding Preview.SoundDetails}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </StackPanel>
                  <TextBlock DockPanel.Dock="Bottom" Text="{Binding PlaybackNote}" Opacity="0.65" Margin="0,6,0,0"
                             IsVisible="{Binding PlaybackNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <views:WaveformView Sound="{Binding Preview.Sound}" MinHeight="120" />
                </DockPanel>
              </Panel>
            </DockPanel>
          </TabItem>

          <TabItem Header="Hex">
            <DockPanel>
              <ComboBox DockPanel.Dock="Top" Margin="12,8" MinWidth="260"
                        ItemsSource="{Binding Hex.Sources}" SelectedItem="{Binding HexSource, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="vm:HexSource">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ListBox Classes="hex" ItemsSource="{Binding HexLines}" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="13">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:HexLine">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                      <TextBlock Text="{Binding Offset}" Opacity="0.55" />
                      <TextBlock Text="{Binding Hex}" />
                      <TextBlock Text="{Binding Characters}" Opacity="0.8" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Grid>

      <GridSplitter Grid.Row="1" ResizeDirection="Rows" />

      <DockPanel Grid.Row="2">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8,4">
          <TextBlock Text="Diagnostics" FontWeight="SemiBold" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}" MinWidth="170" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Diagnostics}" SelectedItem="{Binding SelectedDiagnostic, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:DiagnosticEntry">
              <Grid ColumnDefinitions="70,260,200,*">
                <TextBlock Text="{Binding Severity}" />
                <TextBlock Grid.Column="1" Text="{Binding Source}" TextTrimming="CharacterEllipsis" Opacity="0.75" />
                <TextBlock Grid.Column="2" Text="{Binding Code}" TextTrimming="CharacterEllipsis" Opacity="0.75" />
                <TextBlock Grid.Column="3" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
