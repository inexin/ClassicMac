<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClassicMac.App.ViewModels"
        xmlns:views="using:ClassicMac.App.Views"
        xmlns:editing="using:ClassicMac.Files.Editing"
        xmlns:app="using:ClassicMac.App"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="ClassicMac.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding ShellActions.WindowTitle}"
        Width="1200" Height="780" MinWidth="700" MinHeight="450"
        Icon="/Assets/icon/classicmac.ico"
        DragDrop.AllowDrop="True">

  <Window.Resources>
    <!-- With the client area extended, Avalonia 12 draws the title bar on Windows itself (the Win32 backend requests
         PlatformRequestedDrawnDecoration.TitleBar): Fluent's WindowDrawnDecorations template puts the window's Title in
         its overlay (Panel PART_TitleTextPanel), over the app's own title bar, beside its caption buttons. This theme is
         Fluent's with that title hidden: the caption buttons (minimize, maximize with snap layouts, close in red on
         hover) and the drag and resize areas stay. -->
    <ControlTheme x:Key="CmWindowDecorations" TargetType="chrome:WindowDrawnDecorations"
                  BasedOn="{StaticResource {x:Type chrome:WindowDrawnDecorations}}">
      <!-- The text, not its panel: the panel's IsVisible is a template binding (HasTitleBar), which outranks a style. -->
      <Style Selector="^ /template/ Panel#PART_TitleTextPanel > TextBlock">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ControlTheme>
  </Window.Resources>

  <Window.Styles>
    <StyleInclude Source="avares://ClassicMac/Styles/MainWindow.axaml" />
  </Window.Styles>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Shift+D" Command="{Binding DiagnosticsPanel.ToggleCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <!-- The custom title bar (S1) on Windows and macOS, where the window extends into its decorations; a drag area for
         the platform; the caption buttons are drawn over it (see CmWindowDecorations). Linux keeps the system's. -->
    <Border x:Name="TitleBar" DockPanel.Dock="Top" Classes="titlebar" chrome:WindowDecorationProperties.ElementRole="TitleBar"
            IsVisible="{Binding $parent[Window].ExtendClientAreaToDecorationsHint}">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <!-- The app's icon: the hand-drawn pixel size for the scaling, drawn 1:1 (AppIconView). -->
        <views:AppIconView x:Name="TitleIcon" Slot="16" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ShellActions.TitleFile}" IsVisible="{Binding ShellActions.TitleFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="•" Classes="unsaved" IsVisible="{Binding ShellActions.TitleUnsaved}" />
        <TextBlock Text="—" IsVisible="{Binding ShellActions.TitleFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="ClassicMac" />
      </StackPanel>
    </Border>
    <Menu DockPanel.Dock="Top" Classes="chrome">
      <MenuItem Header="_File">
        <MenuItem Header="_Open…" Command="{Binding OpenCommand}" InputGesture="Ctrl+O" HotKey="Ctrl+O" />
        <MenuItem Header="_Close" Command="{Binding CloseCommand}" InputGesture="Ctrl+W" HotKey="Ctrl+W" />
        <Separator />
        <MenuItem Header="_Save" Command="{Binding EditActions.SaveCommand}" InputGesture="Ctrl+S" HotKey="Ctrl+S" />
        <MenuItem Header="Save _As">
          <MenuItem Header="_MacBinary III…" Command="{Binding EditActions.SaveAsCommand}" CommandParameter="{x:Static editing:SaveAsFormat.MacBinary}" />
          <MenuItem Header="_BinHex 4.0…" Command="{Binding EditActions.SaveAsCommand}" CommandParameter="{x:Static editing:SaveAsFormat.BinHex}" />
          <MenuItem Header="Apple_Single…" Command="{Binding EditActions.SaveAsCommand}" CommandParameter="{x:Static editing:SaveAsFormat.AppleSingle}" />
          <MenuItem Header="Apple_Double Pair…" Command="{Binding EditActions.SaveAsCommand}" CommandParameter="{x:Static editing:SaveAsFormat.AppleDoublePair}" />
          <MenuItem Header="Basilisk _II Folder Entry…" Command="{Binding EditActions.SaveAsCommand}" CommandParameter="{x:Static editing:SaveAsFormat.BasiliskEntry}" />
          <MenuItem Header="_HFS Volume Image…" Command="{Binding EditActions.SaveAsCommand}" CommandParameter="{x:Static editing:SaveAsFormat.HfsImage}" />
          <MenuItem Header="_Resource Fork Only…" Command="{Binding EditActions.SaveAsCommand}" CommandParameter="{x:Static editing:SaveAsFormat.RawFork}" />
        </MenuItem>
        <MenuItem Header="_Revert" Command="{Binding EditActions.RevertCommand}" />
        <Separator />
        <MenuItem Header="Show _Original" Command="{Binding AliasActions.ShowOriginalCommand}" InputGesture="Ctrl+R" HotKey="Ctrl+R" />
        <Separator />
        <MenuItem Header="_Quit" Click="OnQuit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="{Binding EditActions.UndoTitle}" Command="{Binding EditActions.UndoCommand}" InputGesture="Ctrl+Z" HotKey="Ctrl+Z" />
        <MenuItem Header="{Binding EditActions.RedoTitle}" Command="{Binding EditActions.RedoCommand}" InputGesture="Ctrl+Y" HotKey="Ctrl+Y" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Zoom _In" Command="{Binding ShellActions.ZoomInCommand}" InputGesture="Ctrl+OemPlus" HotKey="Ctrl+OemPlus" />
        <MenuItem Header="Zoom _Out" Command="{Binding ShellActions.ZoomOutCommand}" InputGesture="Ctrl+OemMinus" HotKey="Ctrl+OemMinus" />
        <MenuItem Header="_Actual Size" Command="{Binding ShellActions.ActualSizeCommand}" InputGesture="Ctrl+D0" HotKey="Ctrl+D0" />
        <MenuItem Header="Screen _Depth" Classes="depths" ItemsSource="{Binding ShellActions.ScreenDepthChoices}" />
        <Separator />
        <MenuItem Header="Show _Diagnostics" ToggleType="CheckBox" IsChecked="{Binding DiagnosticsPanel.IsExpanded, Mode=TwoWay}" InputGesture="Ctrl+Shift+D" />
        <Separator />
        <MenuItem Header="_Group Files with No Name" ToggleType="CheckBox" IsChecked="{Binding TreeDisplay.GroupNoName, Mode=TwoWay}" />
        <MenuItem Header="_Hide Invisible Files" ToggleType="CheckBox" IsChecked="{Binding TreeDisplay.HideInvisible, Mode=TwoWay}" />
        <MenuItem Header="Show _Details Column" ToggleType="CheckBox" IsChecked="{Binding TreeDisplay.ShowDetails, Mode=TwoWay}" />
        <Separator />
        <MenuItem Header="Type/Creator Data_base…" Command="{Binding TypeCreatorActions.ChooseTypeCreatorDatabaseCommand}" />
        <MenuItem Header="_Forget Type/Creator Database" Command="{Binding TypeCreatorActions.ForgetTypeCreatorDatabaseCommand}" />
        <Separator />
        <MenuItem Header="_Theme">
          <MenuItem Header="_System" ToggleType="Radio" GroupName="theme" IsChecked="{Binding ShellActions.IsSystemTheme, Mode=OneWay}"
                    Command="{Binding ShellActions.SetThemeCommand}" CommandParameter="{x:Static app:AppTheme.System}" />
          <MenuItem Header="_Light" ToggleType="Radio" GroupName="theme" IsChecked="{Binding ShellActions.IsLightTheme, Mode=OneWay}"
                    Command="{Binding ShellActions.SetThemeCommand}" CommandParameter="{x:Static app:AppTheme.Light}" />
          <MenuItem Header="_Dark" ToggleType="Radio" GroupName="theme" IsChecked="{Binding ShellActions.IsDarkTheme, Mode=OneWay}"
                    Command="{Binding ShellActions.SetThemeCommand}" CommandParameter="{x:Static app:AppTheme.Dark}" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Resource">
        <MenuItem Header="_New Resource…" Command="{Binding EditActions.NewResourceCommand}" InputGesture="Ctrl+K" HotKey="Ctrl+K" />
        <MenuItem Header="_Duplicate" Command="{Binding EditActions.DuplicateResourceCommand}" InputGesture="Ctrl+D" HotKey="Ctrl+D" />
        <MenuItem Header="De_lete" Command="{Binding EditActions.DeleteResourceCommand}" InputGesture="Delete" />
        <Separator />
        <MenuItem Header="Get _Info…" Command="{Binding EditActions.GetInfoCommand}" InputGesture="Ctrl+I" HotKey="Ctrl+I" />
        <MenuItem Header="Edit _Hex…" Command="{Binding EditActions.EditHexCommand}" InputGesture="Ctrl+H" HotKey="Ctrl+H" />
        <MenuItem Header="_Replace Data from File…" Command="{Binding EditActions.ReplaceDataCommand}" />
        <MenuItem Header="I_mport Image or Sound…" Command="{Binding ImportActions.ImportCommand}" />
      </MenuItem>
      <MenuItem Header="_Volume">
        <MenuItem Header="New _File…" Command="{Binding VolumeActions.NewFileCommand}" />
        <MenuItem Header="_Import File…" Command="{Binding VolumeActions.ImportFileCommand}" />
        <MenuItem Header="New F_older…" Command="{Binding VolumeActions.NewFolderCommand}" />
        <Separator />
        <MenuItem Header="_Delete File or Folder…" Command="{Binding VolumeActions.DeleteItemCommand}" />
      </MenuItem>
      <MenuItem Header="E_xport">
        <MenuItem Header="_Save Resource As…" Command="{Binding ExportActions.SaveResourceAsCommand}" InputGesture="Ctrl+E" HotKey="Ctrl+E" />
        <MenuItem Header="_Export Resources…" Command="{Binding ExportActions.ExportResourcesCommand}" />
        <MenuItem Header="E_xtract All Resources…" Command="{Binding ExportActions.ExtractAllCommand}" />
        <MenuItem Header="_Convert Documents…" Command="{Binding ExportActions.ConvertDocumentsCommand}" />
        <Separator />
        <MenuItem Header="_Unpack (AppleDouble)…" Command="{Binding ExportActions.UnpackAppleDoubleCommand}" />
        <MenuItem Header="Unpack (_Basilisk II)…" Command="{Binding ExportActions.UnpackBasiliskCommand}" />
        <Separator />
        <MenuItem Header="_Drag Files Out as MacBinary" ToggleType="CheckBox" IsChecked="{Binding DragOut.DragOutAsMacBinary, Mode=TwoWay}" />
      </MenuItem>
      <!-- Filled by the window: Minimize, Zoom, then one item per open input. -->
      <MenuItem x:Name="WindowMenu" Header="_Window" />
      <MenuItem Header="_Help">
        <MenuItem Header="ClassicMac _Help" Command="{Binding ShellActions.OpenHelpCommand}" />
        <MenuItem Header="_Report a Problem…" Command="{Binding ShellActions.ReportProblemCommand}" />
        <Separator />
        <MenuItem Header="_About ClassicMac" Command="{Binding ShellActions.AboutCommand}" />
      </MenuItem>
    </Menu>

    <!-- The toolbar (design/boards/main-window.md, S2): each button follows its command's enabled state. -->
    <Border x:Name="Toolbar" DockPanel.Dock="Top" Classes="chrome toolbar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsEnabled="{Binding ShellActions.IsZoomable}">
          <TextBlock Text="Zoom" Classes="tool-label" VerticalAlignment="Center" />
          <ListBox x:Name="ZoomChoice" Classes="segmented" ItemsSource="{Binding Zooms}" SelectedItem="{Binding Zoom, Mode=TwoWay}"
                   AutomationProperties.Name="Zoom">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="x:Int32">
                <TextBlock Text="{Binding StringFormat={}{0}×}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="Depth" Classes="tool-label" VerticalAlignment="Center" Margin="8,0,0,0" />
          <ComboBox x:Name="DepthChoice" ItemsSource="{Binding ShellActions.ScreenDepthChoices}" SelectedItem="{Binding ShellActions.SelectedDepthChoice, Mode=TwoWay}"
                    MinWidth="120" AutomationProperties.Name="Screen depth">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:ScreenDepthChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="flat tool" Command="{Binding OpenCommand}" ToolTip.Tip="Open (Ctrl+O)" AutomationProperties.Name="Open">
            <StackPanel>
              <Path Classes="tool-icon" Data="M2,5 V14 H14 L16,8 H5 L3,14 M2,5 H7 L8.5,6.5 H14 V8" />
              <TextBlock Text="Open" />
            </StackPanel>
          </Button>
          <Button Classes="flat tool" Command="{Binding EditActions.SaveCommand}" ToolTip.Tip="Save (Ctrl+S)" AutomationProperties.Name="Save">
            <StackPanel>
              <Path Classes="tool-icon" Data="M9,2 V11 M5.5,7.5 L9,11 L12.5,7.5 M2,11 V15 H16 V11" />
              <TextBlock Text="Save" />
            </StackPanel>
          </Button>
          <Border Classes="tool-divider" />
          <Button Classes="flat tool" Command="{Binding EditActions.GetInfoCommand}" ToolTip.Tip="Get Info (Ctrl+I)" AutomationProperties.Name="Get Info">
            <StackPanel>
              <Path Classes="tool-icon" Data="M9,1.75 A7.25,7.25 0 1 1 8.99,1.75 Z M9,8 V13 M9,5 V5.6" />
              <TextBlock Text="Get Info" />
            </StackPanel>
          </Button>
          <Button Classes="flat tool" Command="{Binding EditActions.EditHexCommand}" ToolTip.Tip="Edit Hex (Ctrl+H)" AutomationProperties.Name="Edit Hex">
            <StackPanel>
              <Path Classes="tool-icon" Data="M6,5 L2,9 L6,13 M12,5 L16,9 L12,13 M10.5,4 L7.5,14" />
              <TextBlock Text="Edit Hex" />
            </StackPanel>
          </Button>
          <Border Classes="tool-divider" />
          <Button Classes="flat tool" Command="{Binding InspectorActions.HeaderExportCommand}" ToolTip.Tip="Export the selection" AutomationProperties.Name="Export">
            <StackPanel>
              <Path Classes="tool-icon" Data="M9,11 V2 M5.5,5.5 L9,2 L12.5,5.5 M2,11 V15 H16 V11" />
              <TextBlock Text="Export…" />
            </StackPanel>
          </Button>
          <Button Classes="flat tool" Command="{Binding ExportActions.ExtractAllCommand}" ToolTip.Tip="Extract all resources" AutomationProperties.Name="Extract All">
            <StackPanel>
              <Path Classes="tool-icon" Data="M2,7 H16 V16 H2 Z M3.5,4.5 H14.5 M5,2 H13 M9,9 V14 M7,12 L9,14 L11,12" />
              <TextBlock Text="Extract All" />
            </StackPanel>
          </Button>
          <Border Classes="tool-divider" />
          <Button Classes="flat tool" Command="{Binding SoundPlayback.PlaySoundCommand}" ToolTip.Tip="Play the sound" AutomationProperties.Name="Play">
            <StackPanel>
              <Path Classes="tool-icon" Data="M5,3 L15,9 L5,15 Z" />
              <TextBlock Text="Play" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- The status bar (boards/main-window.md, S4): the selected file's summary with its error and warning counts; on the
         right, while work runs, what it does, how far and a progress bar, else the status text. -->
    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Classes="chrome status-bar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" IsVisible="{Binding StatusLine.Summary, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Classes="summary" Text="{Binding StatusLine.Summary.Text, FallbackValue={x:Null}}" />
          <TextBlock Classes="summary error" Text="{Binding StatusLine.Summary.ErrorText, StringFormat=' · {0}', FallbackValue={x:Null}}"
                     IsVisible="{Binding StatusLine.Summary.ErrorText, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
          <TextBlock Classes="summary warning" Text="{Binding StatusLine.Summary.WarningText, StringFormat=' · {0}', FallbackValue={x:Null}}"
                     IsVisible="{Binding StatusLine.Summary.WarningText, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
        </StackPanel>
        <StackPanel x:Name="Progress" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" IsVisible="{Binding StatusLine.IsWorking}">
          <TextBlock Text="{Binding StatusLine.ProgressText}" />
          <TextBlock Text="{Binding StatusLine.ProgressCount}" Classes="muted" IsVisible="{Binding StatusLine.ProgressCount, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <ProgressBar Classes="status" Minimum="0" Maximum="{Binding StatusLine.ProgressMaximum}" Value="{Binding StatusLine.ProgressValue}"
                       IsIndeterminate="{Binding StatusLine.IsProgressIndeterminate}" />
        </StackPanel>
        <TextBlock Classes="status" Text="{Binding Status}" TextTrimming="CharacterEllipsis" IsVisible="{Binding !StatusLine.IsWorking}" />
      </DockPanel>
    </Border>

    <Grid x:Name="Body" RowDefinitions="*,6,196">
      <Grid ColumnDefinitions="380,5,*">
        <DockPanel>
        <Border DockPanel.Dock="Top" Classes="tree-bar" Padding="6,6,4,6" BorderThickness="0,0,0,1">
          <DockPanel>
          <Button x:Name="TreeDisplayButton" DockPanel.Dock="Right" Classes="flat" Margin="4,0,0,0" ToolTip.Tip="Tree display" AutomationProperties.Name="Tree display">
            <PathIcon Width="12" Height="12" Data="M1,2 H15 V4 H1 Z M1,7 H15 V9 H1 Z M1,12 H15 V14 H1 Z" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="tree-display">
                <StackPanel x:Name="TreeDisplayPanel" Spacing="8" MinWidth="220">
                  <TextBlock Text="Tree display" FontWeight="SemiBold" />
                  <CheckBox Content="Group files with no name" IsChecked="{Binding TreeDisplay.GroupNoName}" />
                  <CheckBox Content="Hide invisible files" IsChecked="{Binding TreeDisplay.HideInvisible}" />
                  <CheckBox Content="Show details column" IsChecked="{Binding TreeDisplay.ShowDetails}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <TextBox x:Name="TreeFilter" Classes="filter" PlaceholderText="Filter tree" Text="{Binding TreeSearch.FilterText}" AutomationProperties.Name="Filter tree">
            <TextBox.InnerLeftContent>
              <PathIcon Classes="search" Data="M6.5,1 A5.5,5.5 0 1 1 6.5,12 A5.5,5.5 0 1 1 6.5,1 Z M6.5,3 A3.5,3.5 0 1 0 6.5,10 A3.5,3.5 0 1 0 6.5,3 Z M10.2,11.6 L11.6,10.2 L15,13.6 L13.6,15 Z" />
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <TextBlock Classes="mono muted key-hint" Text="Ctrl+F" />
            </TextBox.InnerRightContent>
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Escape" Command="{Binding TreeSearch.ClearFilterCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          </DockPanel>
        </Border>
        <Border x:Name="HiddenFooter" DockPanel.Dock="Bottom" Classes="tree-bar" Padding="8,3" BorderThickness="0,1,0,0" IsVisible="{Binding HiddenSummary, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="12" Height="12" Data="M1,8 C4,3 12,3 15,8 C12,13 4,13 1,8 Z M2,13 L13,2 L14,3 L3,14 Z" />
            <TextBlock Text="{Binding HiddenSummary}" Classes="muted" VerticalAlignment="Center" />
            <Button Content="Show" Command="{Binding ShowHiddenCommand}" Classes="flat link" Padding="4,0" Cursor="Hand" />
          </StackPanel>
        </Border>
        <Panel>
        <!-- One virtualized list of the visible rows (VisibleRows), each CmRowTree high and indented by its depth. -->
        <views:BrowseTree x:Name="Tree" Classes="sidebar browse" ItemsSource="{Binding TreeRows}" SelectedItem="{Binding Selected, Mode=OneWay}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.AllowAutoHide="False">
          <ListBox.KeyBindings>
            <KeyBinding Gesture="Delete" Command="{Binding EditActions.DeleteResourceCommand}" />
          </ListBox.KeyBindings>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:NodeViewModel">
              <!-- A row (boards/browse-tree.md): the indent, the expander, then icon or spinner, name, unsaved mark, "not
                   read" chip; meta on the right. -->
              <DockPanel Classes="tree-line">
              <Border DockPanel.Dock="Left" Width="{Binding Depth, Converter={x:Static views:BrowseTree.IndentConverter}}" />
              <Panel DockPanel.Dock="Left" Classes="tree-expander-slot">
                <Border Classes="tree-expander" Classes.open="{Binding IsExpanded}" IsVisible="{Binding HasChildren}"
                        PointerPressed="OnExpanderPressed">
                  <Path Data="M 1,0 10,10 l -9,10 -1,-1 L 8,10 -0,1 z" />
                </Border>
              </Panel>
              <Panel Classes="tree-row">
                <Rectangle Classes="drag-outline" IsVisible="{Binding IsDragSource}" />
                <!-- The row fits the pane: the meta and the chip keep their width on the right, the name trims with an
                     ellipsis (a left-aligned grid: the name's star column is as wide as the name until the row is
                     full), the unsaved mark right after it. -->
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Classes="meta" Text="{Binding Meta}" ToolTip.Tip="{Binding KindTip}"
                             IsVisible="{Binding Meta, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <Panel DockPanel.Dock="Right" Classes="not-read" IsVisible="{Binding IsUnread}">
                    <Rectangle />
                    <TextBlock Text="not read" />
                  </Panel>
                  <views:TreeIcon DockPanel.Dock="Left" Margin="0,0,4,0" Node="{Binding}" IsVisible="{Binding !IsLoading}" />
                  <Panel DockPanel.Dock="Left" Margin="0,0,4,0" Classes="spinner" IsVisible="{Binding IsLoading}">
                    <Ellipse Classes="track" />
                    <Path Classes="arc" Data="M8,2 A6,6 0 0 1 14,8" />
                  </Panel>
                  <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                    <!-- A whitespace name as token chips (boards/tree-no-name.md), its bytes on hover. -->
                    <ItemsControl Classes="name-tokens" ItemsSource="{Binding NameTokens}" IsVisible="{Binding HasNameTokens}"
                                  ToolTip.Tip="{Binding NameBytes}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:NameToken">
                          <Border Classes="name-token">
                            <TextBlock Text="{Binding Label}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="name" Classes.type="{Binding IsResourceType}" Classes.loading="{Binding IsLoading}" Classes.italic="{Binding IsItalic}" Classes.broken="{Binding IsBrokenAlias}"
                               Classes.dimmed="{Binding IsDimmed}" TextTrimming="CharacterEllipsis" IsVisible="{Binding !HasNameTokens}">
                      <Run Text="{Binding NameBefore}" /><Run Classes="match" Classes.on="{Binding HasMatch}" Classes.current="{Binding IsCurrentMatch}" Text="{Binding NameMatch}" /><Run Text="{Binding NameAfter}" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" Classes="unsaved" Text=" •" IsVisible="{Binding IsUnsaved}" />
                  </Grid>
                </DockPanel>
              </Panel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="_New Resource…" Command="{Binding EditActions.NewResourceCommand}" InputGesture="Ctrl+K" />
              <MenuItem Header="_Duplicate" Command="{Binding EditActions.DuplicateResourceCommand}" InputGesture="Ctrl+D" />
              <MenuItem Header="De_lete" Command="{Binding EditActions.DeleteResourceCommand}" InputGesture="Delete" />
              <MenuItem Header="Get _Info…" Command="{Binding EditActions.GetInfoCommand}" InputGesture="Ctrl+I" />
              <MenuItem Header="Edit _Hex…" Command="{Binding EditActions.EditHexCommand}" InputGesture="Ctrl+H" />
              <MenuItem Header="_Replace Data from File…" Command="{Binding EditActions.ReplaceDataCommand}" />
              <MenuItem Header="I_mport Image or Sound…" Command="{Binding ImportActions.ImportCommand}" />
              <Separator />
              <MenuItem Header="New _File…" Command="{Binding VolumeActions.NewFileCommand}" />
              <MenuItem Header="Import File…" Command="{Binding VolumeActions.ImportFileCommand}" />
              <MenuItem Header="New F_older…" Command="{Binding VolumeActions.NewFolderCommand}" />
              <MenuItem Header="Delete File or Folder…" Command="{Binding VolumeActions.DeleteItemCommand}" />
              <Separator />
              <MenuItem Header="_Save Resource As…" Command="{Binding ExportActions.SaveResourceAsCommand}" InputGesture="Ctrl+E" />
              <MenuItem Header="_Export Resources…" Command="{Binding ExportActions.ExportResourcesCommand}" />
              <MenuItem Header="E_xtract All Resources…" Command="{Binding ExportActions.ExtractAllCommand}" />
              <MenuItem Header="_Convert Documents…" Command="{Binding ExportActions.ConvertDocumentsCommand}" />
              <Separator />
              <MenuItem Header="_Unpack (AppleDouble)…" Command="{Binding ExportActions.UnpackAppleDoubleCommand}" />
              <MenuItem Header="Unpack (_Basilisk II)…" Command="{Binding ExportActions.UnpackBasiliskCommand}" />
            </ContextMenu>
          </ListBox.ContextMenu>
        </views:BrowseTree>
        <!-- The type-ahead pill: what was typed, the matches, F3 and Esc. -->
        <Border x:Name="TypeAheadPill" Classes="type-ahead" IsVisible="{Binding TreeSearch.IsTypeAheadOpen}" VerticalAlignment="Bottom" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Classes="search" Margin="0" Data="M6.5,1 A5.5,5.5 0 1 1 6.5,12 A5.5,5.5 0 1 1 6.5,1 Z M6.5,3 A3.5,3.5 0 1 0 6.5,10 A3.5,3.5 0 1 0 6.5,3 Z M10.2,11.6 L11.6,10.2 L15,13.6 L13.6,15 Z" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="mono" Text="{Binding TreeSearch.TypeAheadText}" VerticalAlignment="Center" />
              <TextBlock Classes="mono caret" Text="|" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="muted" Text="{Binding TreeSearch.TypeAheadSummary}" VerticalAlignment="Center" />
            <Border Classes="key"><TextBlock Classes="mono muted key-hint" Text="F3" /></Border>
            <Border Classes="key"><TextBlock Classes="mono muted key-hint" Text="Esc" /></Border>
          </StackPanel>
        </Border>
        </Panel>
        </DockPanel>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

        <!-- The inspector (boards/main-window.md, S3): the selection's header, then its tabs. -->
        <DockPanel Grid.Column="2" Classes="pane">
        <Border x:Name="InspectorHeader" DockPanel.Dock="Top" Classes="inspector-header" IsVisible="{Binding InspectorActions.Header, Converter={x:Static ObjectConverters.IsNotNull}}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Button Content="Export…" Command="{Binding InspectorActions.HeaderExportCommand}" IsVisible="{Binding !SoundHeaderActions.IsSoundResource}" />
              <!-- A sound's actions (boards/sound.md): replaced, not edited. -->
              <Button x:Name="SaveAsWavButton" Content="Save as WAV…" Command="{Binding SoundHeaderActions.SaveAsWavCommand}" IsVisible="{Binding SoundHeaderActions.IsSoundResource}" />
              <Button x:Name="ReplaceFromWavButton" Content="Replace from WAV…" Command="{Binding SoundHeaderActions.ReplaceFromWavCommand}" IsVisible="{Binding SoundHeaderActions.IsSoundResource}" />
              <Panel IsVisible="{Binding Forms.HasForm}">
                <Button Classes="accent" Content="Edit" Command="{Binding FormEditing.EditFormCommand}" IsVisible="{Binding !FormEditing.IsEditingForm}" />
                <Border Classes="editing-badge" IsVisible="{Binding FormEditing.IsEditingForm}" VerticalAlignment="Center">
                  <TextBlock Text="Editing" />
                </Border>
              </Panel>
            </StackPanel>
            <Border Classes="icon-tile">
              <Panel>
                <!-- The selection's own large icon (an icon's image, a picture's thumbnail, a file's Finder icon), else its
                     kind's 32-pixel icon; both 1:1. -->
                <views:PixelImage x:Name="HeaderOwnIcon" Source="{Binding InspectorActions.HeaderIconPng, Converter={x:Static views:Images.FromPng}}" Zoom="1"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsVisible="{Binding InspectorActions.HeaderIconPng, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <views:PixelImage x:Name="HeaderKindIcon" Source="{Binding InspectorActions.Header.Node.IconKind, Converter={x:Static views:TreeIcons.LargeConverter}, FallbackValue={x:Null}}" Zoom="1"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsVisible="{Binding InspectorActions.HeaderIconPng, Converter={x:Static ObjectConverters.IsNull}}" />
              </Panel>
            </Border>
            <StackPanel Classes="titles">
              <!-- A file in a "No name" group is named with its row's chips (boards/tree-no-name.md), its bytes on hover. -->
              <ItemsControl x:Name="HeaderNameTokens" Classes="name-tokens" ItemsSource="{Binding InspectorActions.Header.Node.NameTokens, FallbackValue={x:Null}}"
                            IsVisible="{Binding InspectorActions.Header.Node.HasNameTokens, FallbackValue=False}"
                            ToolTip.Tip="{Binding InspectorActions.Header.Node.NameBytes, FallbackValue={x:Null}}" HorizontalAlignment="Left" Margin="0,4,0,3">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:NameToken">
                    <Border Classes="name-token">
                      <TextBlock Text="{Binding Label}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="HeaderName" Classes="heading" Text="{Binding InspectorActions.Header.Name, FallbackValue={x:Null}}"
                         IsVisible="{Binding !InspectorActions.Header.Node.HasNameTokens, FallbackValue=True}" />
              <TextBlock Classes="muted kind" Text="{Binding InspectorActions.Header.Kind, FallbackValue={x:Null}}" />
              <!-- An alias file: where its original is, and Show Original (Ctrl+R) when it is found. -->
              <StackPanel x:Name="AliasOriginal" Classes="alias-original" Orientation="Horizontal" Spacing="8" IsVisible="{Binding InspectorActions.Header.HasOriginal, FallbackValue=False}">
                <TextBlock Classes="mono original" Text="{Binding InspectorActions.Header.Original, FallbackValue={x:Null}}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding InspectorActions.Header.Original, FallbackValue={x:Null}}" VerticalAlignment="Center" />
                <Button x:Name="ShowOriginalButton" Content="Show Original" Command="{Binding AliasActions.ShowOriginalCommand}"
                        IsVisible="{Binding AliasActions.AliasStrip, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Ctrl+R" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding InspectorActions.Header.Facts, FallbackValue={x:Null}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:InspectorFact">
                    <StackPanel Classes="fact" Orientation="Horizontal">
                      <TextBlock Classes="muted label" Text="{Binding Label}" />
                      <TextBlock Classes="value" Classes.mono="{Binding IsMono}" Text="{Binding Value}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DockPanel>
        </Border>
        <TabControl Classes="pane inspector" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Padding="0">
          <TabItem Header="Details">
            <!-- The Details tab (design/boards/details.md, P4): a two-column grid of cards, the full-width chain card
                 under it, Copy all in the header. -->
            <ScrollViewer x:Name="DetailsScroll" Padding="16,12">
              <ScrollViewer.Resources>
                <DataTemplate x:Key="DetailCard" DataType="vm:DetailGroup">
                  <Border Classes="detail-card" Margin="7">
                    <DockPanel>
                      <Border DockPanel.Dock="Top" Classes="detail-card-header">
                        <TextBlock Classes="caption" Text="{Binding Caption}" />
                      </Border>
                      <StackPanel Classes="detail-rows">
                        <ItemsControl Classes="flags" ItemsSource="{Binding Flags}" IsVisible="{Binding HasFlags}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:FinderFlagChip">
                              <Panel Classes="chip" Classes.set="{Binding IsSet}" Classes.unset="{Binding !IsSet}">
                                <Border />
                                <Rectangle />
                                <TextBlock Text="{Binding Name}" />
                              </Panel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel IsVisible="{Binding HasChain}">
                          <Panel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,2,0,0">
                            <TextBlock Classes="muted problems" FontSize="{DynamicResource CmFontSizeMeta}"
                                       Text="{Binding $parent[TabItem].((vm:MainViewModel)DataContext).Details.ProblemsText, FallbackValue={x:Null}}"
                                       IsVisible="{Binding !$parent[TabItem].((vm:MainViewModel)DataContext).Details.HasProblems, FallbackValue=False}" />
                            <Button Classes="link problems" Padding="0" FontSize="{DynamicResource CmFontSizeMeta}"
                                    Content="{Binding $parent[TabItem].((vm:MainViewModel)DataContext).Details.ProblemsText, FallbackValue={x:Null}}"
                                    IsVisible="{Binding $parent[TabItem].((vm:MainViewModel)DataContext).Details.HasProblems, FallbackValue=False}"
                                    Command="{Binding $parent[TabItem].((vm:MainViewModel)DataContext).DetailsActions.ShowProblemsCommand, FallbackValue={x:Null}}"
                                    ToolTip.Tip="Show them in the diagnostics" />
                          </Panel>
                          <ItemsControl Classes="chain" ItemsSource="{Binding Chain}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="vm:ReadStep">
                                <StackPanel Orientation="Horizontal">
                                  <Panel Classes="chip step" Classes.last="{Binding IsLast}">
                                    <Border />
                                    <SelectableTextBlock Text="{Binding Text}" Margin="8,2" FontSize="{DynamicResource CmFontSizeMeta}" />
                                  </Panel>
                                  <TextBlock Classes="muted" Text="→" Margin="0,2,6,0" IsVisible="{Binding !IsLast}" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Rows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:DetailRow">
                              <Grid ColumnDefinitions="110,*" Margin="0,2">
                                <TextBlock Text="{Binding Label}" Classes="muted" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                  <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" Classes.mono="{Binding Mono}" IsVisible="{Binding !Link}" />
                                  <Button Classes="link in" Padding="0" FontSize="{DynamicResource CmFontSizeBody}" HorizontalAlignment="Left" Content="{Binding Value}" IsVisible="{Binding Link}"
                                          Command="{Binding $parent[TabItem].((vm:MainViewModel)DataContext).DetailsActions.GoToInCommand, FallbackValue={x:Null}}"
                                          ToolTip.Tip="Select it in the tree" />
                                  <ProgressBar Classes="fork-bar" Value="{Binding Bar, FallbackValue=0}" IsVisible="{Binding HasBar}" />
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="muted" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap"
                                   FontSize="{DynamicResource CmFontSizeMeta}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ScrollViewer.Resources>
              <StackPanel Spacing="4">
                <DockPanel Margin="0,0,0,4">
                  <Button x:Name="CopyDetails" DockPanel.Dock="Right" Content="Copy all" Command="{Binding DetailsActions.CopyDetailsCommand}"
                          VerticalAlignment="Center" ToolTip.Tip="Copy the details as plain text" />
                  <TextBlock Text="{Binding Details.Heading}" FontSize="{DynamicResource CmFontSizeHeading}"
                             FontWeight="{DynamicResource CmFontWeightStrong}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl x:Name="DetailCards" ItemsSource="{Binding Details.Cards}" ItemTemplate="{StaticResource DetailCard}" Margin="-7,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl x:Name="DetailWideCards" ItemsSource="{Binding Details.WideCards}" ItemTemplate="{StaticResource DetailCard}" Margin="-7,0" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Preview">
            <Panel>
            <DockPanel IsVisible="{Binding !FormEditing.ShowsForm}">
              <!-- An alias previews its original under this strip (docs/formats/resources/aliases.md §5). -->
              <Border x:Name="AliasStripBar" DockPanel.Dock="Top" Classes="alias-strip" IsVisible="{Binding AliasActions.AliasStrip, Converter={x:Static ObjectConverters.IsNotNull}}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Show Original" Command="{Binding AliasActions.ShowOriginalCommand}" />
                  <TextBlock Text="{Binding AliasActions.AliasStrip}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <!-- An alias whose original is not found: what it recorded instead of a preview. -->
              <Border x:Name="AliasNotFoundCard" DockPanel.Dock="Top" Classes="detail-card alias-missing" IsVisible="{Binding AliasActions.AliasNotFound}">
                <StackPanel Spacing="4">
                  <TextBlock Classes="heading" Text="{Binding AliasActions.AliasNotFoundTitle}" />
                  <TextBlock Text="{Binding AliasActions.AliasNotFoundReason}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding AliasActions.AliasNotFoundLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="x:String">
                        <TextBlock Classes="mono muted" Text="{Binding}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Panel>
                <TextBlock Text="{Binding Preview.Message}" Margin="16" Classes="muted" IsVisible="{Binding Preview.IsMessage}" />
                <!-- The image grid (boards/main-window.md, P1): the sub-bar, then the cards cut into rows by the view-model
                     for the viewport's width, in a virtualising list so hundreds of images scroll smoothly. -->
                <DockPanel IsVisible="{Binding Preview.IsImage}">
                  <DockPanel DockPanel.Dock="Top" Margin="12,8,12,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12">
                      <CheckBox Name="ShowMasksBox" Content="Show masks" IsChecked="{Binding ImageGrid.ShowMasks}" IsVisible="{Binding ImageGrid.HasMasks}" />
                      <CheckBox Name="FinderStatesBox" Content="Finder states" IsChecked="{Binding ImageGrid.ShowFinderStates}" IsVisible="{Binding ImageGrid.HasFinderStates}" />
                    </StackPanel>
                    <TextBlock Name="ImageSummaryText" Text="{Binding ImageGrid.ImageSummary}" Classes="muted" VerticalAlignment="Center" />
                  </DockPanel>
                  <ScrollViewer Name="ImageScroller" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl Name="ImageRowsList" ItemsSource="{Binding ImageGrid.ImageRows}" Margin="12">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.DataTemplates>
                        <DataTemplate DataType="vm:ImageRow">
                          <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="vm:ImageItem">
                                <Border Classes="image-card"
                                        Width="{Binding $parent[Window].((vm:MainViewModel)DataContext).ImageGrid.ImageCardWidth, FallbackValue=112}">
                                  <DockPanel>
                                    <Border DockPanel.Dock="Bottom" Classes="image-caption">
                                      <StackPanel>
                                        <TextBlock Text="{Binding Image.Title}" FontFamily="{StaticResource CmFontMono}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding Image.Title, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <TextBlock Text="{Binding Image.CardDetail}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                                      </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource CmCheckerboard}" Padding="12">
                                      <views:PixelImage Source="{Binding Image.Png, Converter={x:Static views:Images.FromPng}}" Zoom="{Binding Zoom}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                    </Border>
                                  </DockPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </DataTemplate>
                        <DataTemplate DataType="vm:FinderStatesRow">
                          <StackPanel Spacing="6" Margin="0,8,0,12">
                            <TextBlock Text="Finder states" Classes="muted" FontSize="12" FontWeight="SemiBold" />
                            <Border Background="{DynamicResource CmCheckerboard}" HorizontalAlignment="Left" Padding="12" CornerRadius="6" MaxWidth="{Binding MaxWidth}">
                              <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="vm:ImageItem">
                                    <StackPanel Margin="0,0,12,4" Spacing="4">
                                      <views:PixelImage Source="{Binding Image.Png, Converter={x:Static views:Images.FromPng}}" Zoom="{Binding Zoom}"
                                                        HorizontalAlignment="Center" />
                                      <Border Classes="state-plate">
                                        <TextBlock Text="{Binding Image.Caption}" FontSize="11" />
                                      </Border>
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Border>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.DataTemplates>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
                <!-- 24 on the right: the overlay scroll bar never covers the text. -->
                <!-- Mac content keeps its colours: styled text on white paper, as the Mac draws it, in both themes. -->
                <ScrollViewer x:Name="StyledTextScroller" IsVisible="{Binding Preview.IsStyledText}" Padding="16,12,24,12" Background="White">
                  <views:StyledTextView Styled="{Binding Preview.Styled}" TextWrapping="Wrap" />
                </ScrollViewer>
                <ScrollViewer IsVisible="{Binding Preview.IsPlainText}" Padding="16,12,24,12" HorizontalScrollBarVisibility="Auto">
                  <SelectableTextBlock Text="{Binding Preview.Text}" FontFamily="{StaticResource CmFontMono}" />
                </ScrollViewer>
                <!-- The property view (boards/property-view.md, P2): Properties | JSON, then the values in cards (E4's card
                     styles), or the JSON itself. -->
                <DockPanel IsVisible="{Binding Preview.IsJson}">
                  <ListBox x:Name="PropertyMode" DockPanel.Dock="Top" Classes="segmented" HorizontalAlignment="Left" Margin="16,12,16,0"
                           ItemsSource="{x:Static vm:PropertyLinks.PropertyModes}" SelectedIndex="{Binding PropertyLinks.PropertyModeIndex, Mode=TwoWay}"
                           IsVisible="{Binding Preview.HasProperties}" AutomationProperties.Name="Properties or JSON" />
                  <Panel>
                    <ScrollViewer x:Name="PropertyCards" IsVisible="{Binding PropertyLinks.ShowsProperties}" Padding="16,12">
                      <ItemsControl ItemsSource="{Binding Preview.PropertyCards}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Classes="cards" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:PropertyCard">
                            <Border Classes="card">
                              <StackPanel>
                                <TextBlock Classes="card-title" Text="{Binding Caption}" />
                                <ItemsControl Classes="property-rows" ItemsSource="{Binding Rows}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:PropertyRow">
                                      <Border Classes="card-line">
                                        <Grid Classes="card-row property-row" ColumnDefinitions="150,*">
                                          <Grid.ContextMenu>
                                            <ContextMenu>
                                              <MenuItem Header="Copy as _Decimal" Tag="{Binding Decimal}" IsVisible="{Binding IsNumber}" Click="OnCopyProperty" />
                                              <MenuItem Header="Copy as _Hex" Tag="{Binding Hex}" IsVisible="{Binding IsNumber}" Click="OnCopyProperty" />
                                              <MenuItem Header="Copy as _JSON" Tag="{Binding Json}" Click="OnCopyProperty" />
                                            </ContextMenu>
                                          </Grid.ContextMenu>
                                          <TextBlock Classes="label" Text="{Binding Label}" />
                                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Ellipse Classes="dot" Classes.on="{Binding IsYes}" IsVisible="{Binding IsFlag}" />
                                            <SelectableTextBlock Classes="property-value" Classes.mono="{Binding IsMono}" Text="{Binding Value}" />
                                            <SelectableTextBlock Classes="property-raw" Text="{Binding Raw}" IsVisible="{Binding HasRaw}" />
                                            <TextBlock Classes="muted" Text="{Binding Note}" IsVisible="{Binding HasNote}" VerticalAlignment="Center" />
                                          </StackPanel>
                                        </Grid>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer IsVisible="{Binding PropertyLinks.ShowsJsonText}" Padding="16,12" HorizontalScrollBarVisibility="Auto">
                      <SelectableTextBlock Text="{Binding Preview.Text}" FontFamily="{StaticResource CmFontMono}" />
                    </ScrollViewer>
                  </Panel>
                </DockPanel>
                <!-- A font family (boards/font-family.md, P6): Properties | JSON; the sample from the chosen strike, the
                     association matrix, the metrics, style and kerning cards. -->
                <views:FontFamilyPane x:Name="FontFamilyPane" />
                <ScrollViewer IsVisible="{Binding Preview.IsDialog}" HorizontalScrollBarVisibility="Auto" AllowAutoHide="False">
                  <views:DialogView Dialog="{Binding Preview.Dialog}" Scale="{Binding Zoom}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ScrollViewer>
                <ScrollViewer IsVisible="{Binding Preview.IsMenu}" HorizontalScrollBarVisibility="Auto" AllowAutoHide="False">
                  <views:MenuView Menu="{Binding Preview.Menu}" Scale="{Binding Zoom}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ScrollViewer>
                <!-- A page in the web view: an Apple Help page (docs/formats/resources/help-pages.md), or a document's HTML export
                     (DOCMaker, SimpleText, Word; with Back and its pages). Rendered | Source (or Text); the page in a native web
                     view (made in code, HelpWebView.cs), else its source or text with why; the status line under it. -->
                <DockPanel IsVisible="{Binding Preview.IsWebPage}">
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="16,12,16,0">
                    <ListBox x:Name="HelpMode" Classes="segmented" ItemsSource="{Binding HelpPreview.WebModes}" SelectedIndex="{Binding HelpPreview.HelpModeIndex, Mode=TwoWay}"
                             AutomationProperties.Name="Rendered or source" />
                    <Button Content="Back" Command="{Binding Preview.Document.BackCommand, FallbackValue={x:Null}}"
                            IsVisible="{Binding Preview.IsDocument}" />
                    <ComboBox x:Name="DocumentChapters" ItemsSource="{Binding Preview.Document.ChapterTitles, FallbackValue={x:Null}}" MinWidth="260"
                              SelectedIndex="{Binding Preview.Document.ChapterIndex, Mode=TwoWay, FallbackValue=0}"
                              IsVisible="{Binding Preview.Document.HasChapters, FallbackValue=False}" AutomationProperties.Name="Page" />
                  </StackPanel>
                  <TextBlock x:Name="HelpEngineMessage" DockPanel.Dock="Top" Classes="muted" Margin="16,8,16,0" TextWrapping="Wrap"
                             Text="{Binding HelpPreview.WebEngineMessage}" IsVisible="{Binding HelpPreview.HasWebEngineMessage}" />
                  <TextBlock x:Name="HelpStatusText" DockPanel.Dock="Bottom" Classes="muted" Margin="16,4" TextTrimming="CharacterEllipsis"
                             Text="{Binding HelpPreview.HelpStatus}" IsVisible="{Binding HelpPreview.HelpStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <Panel>
                    <Panel x:Name="HelpHost" Margin="0,8,0,0" IsVisible="{Binding HelpPreview.ShowsHelpRendered}" />
                    <ScrollViewer IsVisible="{Binding HelpPreview.ShowsHelpSource}" Padding="16,12" HorizontalScrollBarVisibility="Auto">
                      <SelectableTextBlock x:Name="HelpSource" Classes.document="{Binding Preview.IsDocument}" Text="{Binding Preview.Web.Source, FallbackValue={x:Null}}" TextWrapping="Wrap" />
                    </ScrollViewer>
                  </Panel>
                </DockPanel>
                <!-- The sound preview (boards/sound.md, P3): the transport (Play/Stop, the playhead's time, Repeat the loop),
                     the detail chips, and the channel lanes with the loop band and the playhead; a click on the waveform
                     plays from there, Space plays and stops. -->
                <ScrollViewer x:Name="SoundPreview" IsVisible="{Binding Preview.IsSound}" Focusable="True">
                  <ScrollViewer.KeyBindings>
                    <KeyBinding Gesture="Space" Command="{Binding SoundPlayback.ToggleSoundCommand}" />
                  </ScrollViewer.KeyBindings>
                  <StackPanel Margin="16,12" Spacing="12">
                    <DockPanel>
                      <CheckBox x:Name="RepeatLoopBox" DockPanel.Dock="Right" Content="Repeat the loop" IsChecked="{Binding SoundPlayback.RepeatLoop}"
                                IsVisible="{Binding SoundPlayback.HasSoundLoop}" />
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <Panel>
                          <Button x:Name="PlayButton" Classes="accent transport" Command="{Binding SoundPlayback.PlaySoundCommand}" IsVisible="{Binding !SoundPlayback.IsPlaying}"
                                  ToolTip.Tip="Play (Space)" AutomationProperties.Name="Play">
                            <PathIcon Data="M5,2 L14,8 L5,14 Z" />
                          </Button>
                          <Button x:Name="StopButton" Classes="accent transport" Command="{Binding SoundPlayback.StopSoundCommand}" IsVisible="{Binding SoundPlayback.IsPlaying}"
                                  ToolTip.Tip="Stop (Space)" AutomationProperties.Name="Stop">
                            <PathIcon Data="M3,3 H13 V13 H3 Z" />
                          </Button>
                        </Panel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <TextBlock Classes="mono sound-time" Text="{Binding SoundPlayback.PlayheadText}" />
                          <TextBlock Classes="mono muted sound-time" Text="{Binding SoundPlayback.SoundDurationText}" />
                        </StackPanel>
                        <TextBlock Classes="muted" VerticalAlignment="Center" Text="Space plays and stops · stops when the selection changes" />
                      </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding SoundPlayback.PlaybackNote}" Classes="muted" IsVisible="{Binding SoundPlayback.PlaybackNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ItemsControl ItemsSource="{Binding Preview.SoundFacts}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:SoundFact">
                          <Border Classes="chip">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Classes="muted" Text="{Binding Label}" />
                              <TextBlock Text="{Binding Value}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Classes="wave-card">
                      <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="wave-header">
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" IsVisible="{Binding SoundPlayback.HasSoundLoop}">
                              <Border Classes="loop-swatch" />
                              <TextBlock Classes="muted" Text="Loop" />
                            </StackPanel>
                            <TextBlock Classes="strong" Text="{Binding Preview.SoundLanesTitle}" />
                          </DockPanel>
                        </Border>
                        <views:WaveformView Sound="{Binding Preview.Sound}" LoopFrames="{Binding Preview.SoundLoopFrames}" Playhead="{Binding SoundPlayback.Playhead}"
                                            ShowsPlayhead="{Binding SoundPlayback.IsPlaying}" SeekCommand="{Binding SoundPlayback.SeekSoundCommand}" />
                      </DockPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
                <!-- A sound that cannot be decoded: what it is, why, and its bytes. -->
                <Border x:Name="SoundErrorCard" Classes="sound-error" IsVisible="{Binding Preview.IsSoundError}" VerticalAlignment="Top" HorizontalAlignment="Left">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <views:SeverityIcon Severity="Error" Width="16" Height="16" VerticalAlignment="Center" />
                      <TextBlock Classes="strong" Text="{Binding Preview.ErrorTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="muted" Text="{Binding Preview.ErrorDetail}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Show in Hex" Command="{Binding SoundPlayback.ShowInHexCommand}" />
                      <Button Content="Save raw data…" Command="{Binding SoundPlayback.SaveRawDataCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Panel>
            </DockPanel>
              <!-- The read-then-edit host (boards/read-then-edit.md, E1; FormEditing.cs): every form, read only first, then
                   in place with Cancel and Apply. Esc cancels and Ctrl+Enter applies (FormHostInput.cs); a double-click
                   on a "form-row" edits with that row selected. -->
              <DockPanel x:Name="FormHost" Classes="form-host" Classes.editing="{Binding FormEditing.IsEditingForm}" IsVisible="{Binding FormEditing.ShowsForm}">
                <Border x:Name="FormFooter" DockPanel.Dock="Bottom" Classes="host-footer">
                  <Panel>
                    <StackPanel x:Name="ReadOnlyFooter" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !FormEditing.IsEditingForm}">
                      <PathIcon Classes="lock" Data="M4,7 V5 A4,4 0 0 1 12,5 V7 H13 V15 H3 V7 Z M6,7 H10 V5 A2,2 0 0 0 6,5 Z" />
                      <TextBlock Text="{Binding FormEditing.FormReadOnlyNote}" Classes="muted" />
                      <TextBlock Text="{Binding FormEditing.LastApplied}" Classes="applied" IsVisible="{Binding FormEditing.LastApplied, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <DockPanel x:Name="EditingFooter" IsVisible="{Binding FormEditing.IsEditingForm}">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                        <Button Content="Cancel" Command="{Binding FormEditing.CancelFormCommand}" ToolTip.Tip="Esc" />
                        <Button Classes="accent" Content="Apply" Command="{Binding Forms.ApplyFormCommand}" IsDefault="False" ToolTip.Tip="Ctrl+Enter" />
                      </StackPanel>
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <TextBlock Text="{Binding FormEditing.FormHint}" Classes="muted" VerticalAlignment="Center" />
                          <CheckBox x:Name="TemplateBox" Content="Edit with template" IsChecked="{Binding Forms.UseTemplate}" IsVisible="{Binding Forms.HasTemplateChoice}" />
                        </StackPanel>
                        <StackPanel x:Name="FormErrorLine" Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding FormLivePreview.FormError, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <views:SeverityIcon Severity="Error" Width="12" Height="12" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding FormLivePreview.FormError}" Classes="error form-error" TextWrapping="Wrap" />
                        </StackPanel>
                      </StackPanel>
                    </DockPanel>
                  </Panel>
                </Border>
                <Border Classes="host-values">
                <DockPanel>
                <ScrollViewer DockPanel.Dock="Right" HorizontalScrollBarVisibility="Auto" AllowAutoHide="False" Margin="16,0,16,0" MaxWidth="560"
                              IsVisible="{Binding FormLivePreview.ShowsHostDialog}">
                  <views:DialogView Dialog="{Binding FormLivePreview.FormDialog}" Scale="1" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ScrollViewer>
                <ContentControl Classes="form-content" Content="{Binding Forms.Form}">
                  <ContentControl.DataTemplates>
                    <!-- Strings, string lists, text and version (boards/read-then-edit.md, E5): read as text (a double-click
                         anywhere on it edits), edited with the inputs. -->
                    <DataTemplate DataType="vm:StringForm">
                      <Panel>
                        <Border x:Name="StringRead" Classes="read-view form-row" IsVisible="{Binding !IsEditing}">
                          <StackPanel Spacing="6">
                            <TextBlock Classes="caption" Text="STRING" />
                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding !IsEmpty}" />
                            <TextBlock Classes="muted" Text="Empty" IsVisible="{Binding IsEmpty}" />
                          </StackPanel>
                        </Border>
                        <StackPanel Spacing="6" IsVisible="{Binding IsEditing}">
                          <TextBlock Text="String (at most 255 Mac OS Roman characters)" Classes="muted" />
                          <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                        </StackPanel>
                      </Panel>
                    </DataTemplate>
                    <DataTemplate DataType="vm:StringListForm">
                      <Panel>
                        <ScrollViewer IsVisible="{Binding !IsEditing}">
                          <StackPanel Spacing="6">
                            <TextBlock Classes="caption" Text="{Binding Summary, StringFormat={}{0}}" />
                            <ItemsControl x:Name="StringRows" ItemsSource="{Binding Strings}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:StringItem">
                                  <Border Classes="table-row form-row" Classes.selected="{Binding IsSelected}">
                                    <Panel>
                                      <Border Classes="bar" />
                                      <Grid ColumnDefinitions="36,*">
                                        <TextBlock Classes="muted mono" Text="{Binding Number}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                      </Grid>
                                    </Panel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </ScrollViewer>
                        <DockPanel IsVisible="{Binding IsEditing}">
                          <Button DockPanel.Dock="Bottom" Content="Add String" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                          <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Strings}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:StringItem">
                                  <Grid ColumnDefinitions="36,*,Auto,Auto" Margin="0,2">
                                    <TextBlock Classes="muted mono" Text="{Binding Number}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Classes.selected="{Binding IsSelected}" Text="{Binding Text}" />
                                    <Button Grid.Column="2" Content="↑" Margin="4,0,0,0"
                                            Command="{Binding $parent[ItemsControl].((vm:StringListForm)DataContext).MoveUpCommand}" CommandParameter="{Binding}" />
                                    <Button Grid.Column="3" Content="Remove" Margin="4,0,0,0"
                                            Command="{Binding $parent[ItemsControl].((vm:StringListForm)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </DockPanel>
                      </Panel>
                    </DataTemplate>
                    <DataTemplate DataType="vm:TextForm">
                      <Panel>
                        <ScrollViewer IsVisible="{Binding !IsEditing}">
                          <Border x:Name="TextRead" Classes="read-view form-row">
                            <views:StyledTextView Styled="{Binding Styled}" TextWrapping="Wrap" />
                          </Border>
                        </ScrollViewer>
                        <DockPanel IsVisible="{Binding IsEditing}">
                          <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Classes="muted"
                                     Text="Text (Mac OS Roman). Its 'styl' runs follow your edits; new text takes the style where the change starts."
                                     IsVisible="{Binding HasStyles}" TextWrapping="Wrap" />
                          <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" />
                        </DockPanel>
                      </Panel>
                    </DataTemplate>
                    <DataTemplate DataType="vm:VersionForm">
                      <Panel>
                        <Border x:Name="VersionRead" Classes="read-view form-row" IsVisible="{Binding !IsEditing}">
                          <Grid Classes="labelled" ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Classes="muted" Text="Version" />
                            <TextBlock Grid.Column="1" Classes="mono strong-value" Text="{Binding NumberText}" />
                            <TextBlock Grid.Row="1" Classes="muted" Text="Stage" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StageText}" />
                            <TextBlock Grid.Row="2" Classes="muted" Text="Region code" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding RegionText}" />
                            <TextBlock Grid.Row="3" Classes="muted" Text="Short version" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ShortVersion}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" Classes="muted" Text="Long version" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LongVersion}" TextWrapping="Wrap" />
                          </Grid>
                        </Border>
                        <Grid IsVisible="{Binding IsEditing}" ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                          <TextBlock Text="Major" VerticalAlignment="Center" />
                          <NumericUpDown Grid.Column="1" Value="{Binding Major}" Minimum="0" Maximum="99" FormatString="0" Width="140" HorizontalAlignment="Left" />
                          <TextBlock Grid.Row="1" Text="Minor" VerticalAlignment="Center" />
                          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Minor}" Minimum="0" Maximum="15" FormatString="0" Width="140" HorizontalAlignment="Left" />
                          <TextBlock Grid.Row="2" Text="Bug fix" VerticalAlignment="Center" />
                          <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding BugFix}" Minimum="0" Maximum="15" FormatString="0" Width="140" HorizontalAlignment="Left" />
                          <TextBlock Grid.Row="3" Text="Stage" VerticalAlignment="Center" />
                          <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static vm:VersionForm.Stages}" SelectedItem="{Binding Stage}" Width="140" />
                          <TextBlock Grid.Row="4" Text="Non-release" VerticalAlignment="Center" />
                          <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding NonRelease}" Minimum="0" Maximum="99" FormatString="0" Width="140" HorizontalAlignment="Left" />
                          <TextBlock Grid.Row="5" Text="Region code" VerticalAlignment="Center" />
                          <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding Region}" Minimum="-32768" Maximum="32767" FormatString="0" Width="140" HorizontalAlignment="Left" />
                          <TextBlock Grid.Row="6" Text="Short version" VerticalAlignment="Center" />
                          <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ShortVersion}" />
                          <TextBlock Grid.Row="7" Text="Long version" VerticalAlignment="Center" />
                          <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding LongVersion}" />
                        </Grid>
                      </Panel>
                    </DataTemplate>
                    <!-- The window and dialog form (boards/window-alert.md, E4): property cards, text read only and inputs while
                         editing; the bounds on a screen on the right. -->
                    <DataTemplate DataType="vm:WindowForm">
                      <Grid x:Name="WindowCards" ColumnDefinitions="*,Auto">
                        <ScrollViewer>
                          <StackPanel Classes="cards">
                            <Border Classes="card">
                              <StackPanel>
                                <TextBlock Classes="card-title" Text="Bounds" />
                                <Border Classes="card-line">
                                  <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Top, left" />
                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding TopLeftText}" IsVisible="{Binding !IsEditing}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsEditing}">
                                      <NumericUpDown Value="{Binding Top}" FormatString="0" Classes="coord" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Top" />
                                      <NumericUpDown Value="{Binding Left}" FormatString="0" Classes="coord" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Left" />
                                    </StackPanel>
                                  </Grid>
                                </Border>
                                <Border Classes="card-line">
                                  <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Bottom, right" />
                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding BottomRightText}" IsVisible="{Binding !IsEditing}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsEditing}">
                                      <NumericUpDown Value="{Binding Bottom}" FormatString="0" Classes="coord" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Bottom" />
                                      <NumericUpDown Value="{Binding Right}" FormatString="0" Classes="coord" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Right" />
                                    </StackPanel>
                                  </Grid>
                                </Border>
                                <Border Classes="card-line last">
                                  <Grid Classes="card-row last" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Size" />
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" />
                                  </Grid>
                                </Border>
                              </StackPanel>
                            </Border>
                            <Border Classes="card">
                              <StackPanel>
                                <TextBlock Classes="card-title" Text="Window" />
                                <Border Classes="card-line">
                                  <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Title" />
                                    <TextBlock Grid.Column="1" Text="{Binding TitleText}" IsVisible="{Binding !IsEditing}" />
                                    <TextBox Grid.Column="1" Text="{Binding Title}" MaxWidth="320" HorizontalAlignment="Left" MinWidth="200" IsVisible="{Binding IsEditing}" />
                                  </Grid>
                                </Border>
                                <Border Classes="card-line">
                                  <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Definition" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
                                      <TextBlock Text="{Binding DefinitionName}" />
                                      <TextBlock Classes="mono muted" Text="{Binding DefinitionCode}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Definitions}" SelectedItem="{Binding SelectedDefinition}" MinWidth="220" IsVisible="{Binding IsEditing}" />
                                  </Grid>
                                </Border>
                                <Border Classes="card-line" IsVisible="{Binding IsDialog}">
                                  <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Item list" />
                                    <Button Grid.Column="1" Classes="link" Content="{Binding ItemsText}" IsVisible="{Binding !IsEditing}"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).FormEditing.ShowItemListCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding ItemsId}" FormatString="0" Classes="coord" HorizontalAlignment="Left" Minimum="-32768" Maximum="32767" IsVisible="{Binding IsEditing}" />
                                  </Grid>
                                </Border>
                                <Border Classes="card-line">
                                  <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Visible" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsEditing}">
                                      <Ellipse Classes="dot" Classes.on="{Binding Visible}" />
                                      <TextBlock Text="{Binding VisibleText}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding Visible}" IsVisible="{Binding IsEditing}" AutomationProperties.Name="Visible" />
                                  </Grid>
                                </Border>
                                <Border Classes="card-line">
                                  <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Close box" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsEditing}">
                                      <Ellipse Classes="dot" Classes.on="{Binding GoAway}" />
                                      <TextBlock Text="{Binding GoAwayText}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding GoAway}" IsVisible="{Binding IsEditing}" AutomationProperties.Name="Close box" />
                                  </Grid>
                                </Border>
                                <Border Classes="card-line">
                                  <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Reference constant" />
                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding RefConText}" IsVisible="{Binding !IsEditing}" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding RefCon}" FormatString="0" Classes="coord wide" HorizontalAlignment="Left" Minimum="-2147483648" Maximum="2147483647" IsVisible="{Binding IsEditing}" />
                                  </Grid>
                                </Border>
                                <Border Classes="card-line last">
                                  <Grid Classes="card-row form-row last" ColumnDefinitions="150,*">
                                    <TextBlock Classes="label" Text="Auto-position" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
                                      <TextBlock Text="{Binding PositionName}" />
                                      <TextBlock Classes="mono muted" Text="{Binding PositionCode}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditing}">
                                      <CheckBox IsChecked="{Binding HasPosition}" AutomationProperties.Name="Positioning word" />
                                      <ComboBox ItemsSource="{x:Static vm:CardForm.Positions}" SelectedItem="{Binding SelectedPosition}" MinWidth="260" IsEnabled="{Binding HasPosition}" />
                                    </StackPanel>
                                  </Grid>
                                </Border>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Column="1" Classes="screen-panel" IsVisible="{Binding !IsDialog}">
                          <StackPanel Spacing="8">
                            <TextBlock Classes="caption" Text="{Binding ScreenTitle}" />
                            <views:ScreenBoundsView Top="{Binding Top}" Left="{Binding Left}" Bottom="{Binding Bottom}" Right="{Binding Right}"
                                                    Definition="{Binding Definition}" ScreenWidth="{Binding SelectedScreen.Width}" ScreenHeight="{Binding SelectedScreen.Height}"
                                                    HorizontalAlignment="Left" />
                            <ComboBox ItemsSource="{x:Static vm:WindowForm.Screens}" SelectedItem="{Binding SelectedScreen}" MinWidth="200" AutomationProperties.Name="Screen" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </DataTemplate>
                    <!-- The alert form (E4): a card, then the stages table; selecting a stage redraws the preview with its
                         default button. -->
                    <DataTemplate DataType="vm:AlertForm">
                      <ScrollViewer>
                        <StackPanel x:Name="AlertCards" Classes="cards">
                          <Border Classes="card">
                            <StackPanel>
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Bounds" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
                                    <TextBlock Classes="mono" Text="{Binding BoundsText}" />
                                    <TextBlock Classes="muted" Text="{Binding SizeText}" />
                                  </StackPanel>
                                  <WrapPanel Grid.Column="1" ItemSpacing="6" LineSpacing="6" Margin="0,6" IsVisible="{Binding IsEditing}">
                                    <NumericUpDown Value="{Binding Top}" FormatString="0" Classes="coord" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Top" />
                                    <NumericUpDown Value="{Binding Left}" FormatString="0" Classes="coord" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Left" />
                                    <NumericUpDown Value="{Binding Bottom}" FormatString="0" Classes="coord" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Bottom" />
                                    <NumericUpDown Value="{Binding Right}" FormatString="0" Classes="coord" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Right" />
                                  </WrapPanel>
                                </Grid>
                              </Border>
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Item list" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
                                    <Button Classes="link" Content="{Binding ItemsText}"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).FormEditing.ShowItemListCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                                    <TextBlock Classes="muted" Text="{Binding ItemCountText}" VerticalAlignment="Center" />
                                  </StackPanel>
                                  <NumericUpDown Grid.Column="1" Value="{Binding ItemsId}" FormatString="0" Classes="coord" HorizontalAlignment="Left" Minimum="-32768" Maximum="32767" IsVisible="{Binding IsEditing}" />
                                </Grid>
                              </Border>
                              <Border Classes="card-line last">
                                <Grid Classes="card-row form-row last" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Auto-position" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
                                    <TextBlock Text="{Binding PositionName}" />
                                    <TextBlock Classes="mono muted" Text="{Binding PositionCode}" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditing}">
                                    <CheckBox IsChecked="{Binding HasPosition}" AutomationProperties.Name="Positioning word" />
                                    <ComboBox ItemsSource="{x:Static vm:CardForm.Positions}" SelectedItem="{Binding SelectedPosition}" MinWidth="260" IsEnabled="{Binding HasPosition}" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </StackPanel>
                          </Border>
                          <Border Classes="card">
                            <StackPanel>
                              <TextBlock Classes="card-title" Text="Stages" />
                              <TextBlock Classes="muted card-note" Text="What happens the 1st to 4th time the alert is shown in a row" />
                              <Grid Classes="card-columns" ColumnDefinitions="70,*,90,120">
                                <TextBlock Classes="caption" Text="STAGE" />
                                <TextBlock Grid.Column="1" Classes="caption" Text="DEFAULT BUTTON" />
                                <TextBlock Grid.Column="2" Classes="caption" Text="DRAWN" />
                                <TextBlock Grid.Column="3" Classes="caption" Text="SOUND" />
                              </Grid>
                              <!-- The stages: table rows (a click selects one, through the host's row selection). -->
                              <ItemsControl x:Name="AlertStages" ItemsSource="{Binding Stages}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="vm:AlertStage">
                                    <Border Classes="table-row form-row" Classes.selected="{Binding IsSelected}">
                                      <Panel>
                                        <Border Classes="bar" />
                                        <Grid Classes="stage-row" ColumnDefinitions="70,*,90,120">
                                          <TextBlock Text="{Binding Ordinal}" />
                                          <TextBlock Grid.Column="1" Text="{Binding DefaultText}"
                                                     IsVisible="{Binding !$parent[ItemsControl].((vm:AlertForm)DataContext).IsEditing, FallbackValue=True}" />
                                          <ComboBox Grid.Column="1" ItemsSource="{Binding DefaultChoices}" SelectedIndex="{Binding DefaultIndex}" MinWidth="180"
                                                    IsVisible="{Binding $parent[ItemsControl].((vm:AlertForm)DataContext).IsEditing, FallbackValue=False}" AutomationProperties.Name="Default button" />
                                          <TextBlock Grid.Column="2" Text="{Binding DrawnText}"
                                                     IsVisible="{Binding !$parent[ItemsControl].((vm:AlertForm)DataContext).IsEditing, FallbackValue=True}" />
                                          <CheckBox Grid.Column="2" IsChecked="{Binding Drawn}"
                                                    IsVisible="{Binding $parent[ItemsControl].((vm:AlertForm)DataContext).IsEditing, FallbackValue=False}" AutomationProperties.Name="Drawn" />
                                          <TextBlock Grid.Column="3" Text="{Binding SoundName}"
                                                     IsVisible="{Binding !$parent[ItemsControl].((vm:AlertForm)DataContext).IsEditing, FallbackValue=True}" />
                                          <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:AlertStage.Sounds}" SelectedIndex="{Binding SoundIndex}" MinWidth="110"
                                                    IsVisible="{Binding $parent[ItemsControl].((vm:AlertForm)DataContext).IsEditing, FallbackValue=False}" AutomationProperties.Name="Sound" />
                                        </Grid>
                                      </Panel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock x:Name="StageNote" Classes="muted card-note" Text="{Binding StageNote}" TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </ScrollViewer>
                    </DataTemplate>
                    <!-- The dialog item list form (boards/dialog-item-list.md, E3): a table read only, inputs while editing; the
                         preview on the right (the dialog that uses the list, live from the values), its outlined item the
                         selected row, a click on an item selecting its row. -->
                    <DataTemplate DataType="vm:DialogItemsForm">
                      <Grid x:Name="ItemListForm" Classes="menu-form ditl-form" Classes.editing="{Binding IsEditing}" ColumnDefinitions="*,Auto">
                        <Border Grid.Column="1" Classes="preview-panel ditl-preview">
                          <DockPanel>
                            <Border DockPanel.Dock="Top" Classes="preview-header">
                              <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Classes="muted" Text="1× · Mac OS 8/9" />
                                <TextBlock x:Name="ItemListPreviewTitle" Classes="strong"
                                           Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).FormEditing.FormPreviewTitle, FallbackValue=Preview}" />
                              </DockPanel>
                            </Border>
                            <TextBlock DockPanel.Dock="Top" Classes="muted preview-note"
                                       Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).FormLivePreview.FormDialogNote, FallbackValue={x:Null}}" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" AllowAutoHide="False" Background="{DynamicResource CmCheckerboard}">
                              <views:DialogView x:Name="ItemListPreview" Dialog="{Binding $parent[Window].((vm:MainViewModel)DataContext).FormLivePreview.FormDialog, FallbackValue={x:Null}}"
                                                SelectedIndex="{Binding PreviewIndex, Mode=TwoWay}" Scale="1" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            </ScrollViewer>
                          </DockPanel>
                        </Border>
                        <ScrollViewer Padding="18,12" HorizontalScrollBarVisibility="Disabled">
                          <StackPanel Classes="menu-table" Classes.editing="{Binding IsEditing}">
                            <Grid Classes="menu-columns read-only" ColumnDefinitions="24,96,*,132,56">
                              <TextBlock Classes="caption" Text="#" />
                              <TextBlock Grid.Column="1" Classes="caption" Text="KIND" />
                              <TextBlock Grid.Column="2" Classes="caption" Text="TEXT OR RESOURCE" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="3" Classes="caption" Text="TOP, LEFT, BOTTOM, RIGHT" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="4" Classes="caption" Text="ENABLED" />
                            </Grid>
                            <Grid Classes="menu-columns editing" ColumnDefinitions="24,136,*,160,24,24">
                              <TextBlock Classes="caption" Text="#" />
                              <TextBlock Grid.Column="1" Classes="caption" Text="KIND" />
                              <TextBlock x:Name="ItemTextCaption" Grid.Column="2" Classes="caption" Text="TEXT OR RESOURCE ID" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="3" Classes="caption" Text="TOP, LEFT, BOTTOM, RIGHT" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="4" Classes="caption" Text="ON" />
                            </Grid>
                            <ItemsControl x:Name="ItemRows" ItemsSource="{Binding Items}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:DialogItemRow">
                                  <Border Classes="table-row ditl-row form-row" Classes.selected="{Binding IsSelected}">
                                    <Panel>
                                      <Border Classes="bar" />
                                      <Grid Classes="read-only" ColumnDefinitions="24,96,*,132,56">
                                        <TextBlock Classes="muted mono" Text="{Binding Number}" />
                                        <TextBlock Grid.Column="1" Text="{Binding KindName}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Content}" Classes.muted="{Binding HasNoContent}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Classes="mono" Text="{Binding BoundsText}" />
                                        <TextBlock Grid.Column="4" Text="{Binding EnabledText}" Classes.muted="{Binding IsDimmed}" />
                                      </Grid>
                                      <Grid Classes="editing" ColumnDefinitions="24,136,*,160,24,24">
                                        <TextBlock Classes="muted mono" Text="{Binding Number}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:DialogItemRow.Kinds}" SelectedItem="{Binding Kind}" AutomationProperties.Name="Kind" />
                                        <TextBox x:Name="ItemText" Grid.Column="2" Text="{Binding Text}" IsVisible="{Binding HasText}" AutomationProperties.Name="Text" />
                                        <NumericUpDown Grid.Column="2" Classes="mono" Value="{Binding ResourceId}" FormatString="0" ShowButtonSpinner="False"
                                                       Minimum="-32768" Maximum="32767" IsVisible="{Binding HasResource}" AutomationProperties.Name="Resource ID" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                                          <TextBox x:Name="TopBox" Classes="mono bound" Text="{Binding TopText}" AutomationProperties.Name="Top" />
                                          <TextBox x:Name="LeftBox" Classes="mono bound" Text="{Binding LeftText}" AutomationProperties.Name="Left" />
                                          <TextBox x:Name="BottomBox" Classes="mono bound" Text="{Binding BottomText}" AutomationProperties.Name="Bottom" />
                                          <TextBox x:Name="RightBox" Classes="mono bound" Text="{Binding RightText}" AutomationProperties.Name="Right" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="4" IsChecked="{Binding Enabled}" AutomationProperties.Name="Enabled" />
                                        <Button Grid.Column="5" Classes="flat row-tool remove" Content="×" ToolTip.Tip="Remove" AutomationProperties.Name="Remove"
                                                Command="{Binding $parent[ItemsControl].((vm:DialogItemsForm)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                                      </Grid>
                                    </Panel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Classes="editing" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                              <Button Content="Add item" Command="{Binding AddCommand}" />
                            </StackPanel>
                          </StackPanel>
                        </ScrollViewer>
                      </Grid>
                    </DataTemplate>
                    <!-- The menu form (boards/read-then-edit.md, E2): a summary and a table read only, inputs while
                         editing; the live preview on the right, its highlighted item the selected row. -->
                    <DataTemplate DataType="vm:MenuForm">
                      <Grid x:Name="MenuForm" Classes="menu-form menu-edit-form" Classes.editing="{Binding IsEditing}" ColumnDefinitions="*,Auto">
                        <Border Grid.Column="1" Classes="preview-panel menu-preview">
                          <DockPanel>
                            <Border DockPanel.Dock="Top" Classes="preview-header">
                              <WrapPanel>
                                <TextBlock x:Name="PreviewTitle" Classes="strong" Margin="0,0,10,0" TextWrapping="Wrap"
                                           Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).FormEditing.FormPreviewTitle, FallbackValue=Preview}" />
                                <TextBlock Classes="muted" Text="2× · Mac OS 8/9" />
                              </WrapPanel>
                            </Border>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" AllowAutoHide="False" Background="{DynamicResource CmCheckerboard}">
                              <views:MenuView x:Name="MenuPreview" Menu="{Binding Preview}" SelectedIndex="{Binding PreviewIndex, Mode=TwoWay}" Scale="2"
                                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                            </ScrollViewer>
                          </DockPanel>
                        </Border>
                        <ScrollViewer Padding="18,12">
                          <StackPanel Spacing="12">
                            <WrapPanel Classes="menu-summary" IsVisible="{Binding !IsEditing}">
                              <TextBlock Classes="muted" Text="Menu title" />
                              <TextBlock Classes="value" Text="{Binding Title}" />
                              <TextBlock Classes="muted" Text="Enabled" />
                              <TextBlock Classes="value" Text="{Binding EnabledText}" />
                              <TextBlock Classes="muted" Text="Menu ID" />
                              <TextBlock Classes="value mono" Text="{Binding IdText}" />
                              <TextBlock Classes="muted" Text="MDEF" />
                              <TextBlock Classes="value mono" Text="{Binding DefinitionText}" />
                            </WrapPanel>
                            <WrapPanel Classes="menu-fields" IsVisible="{Binding IsEditing}">
                              <StackPanel>
                                <TextBlock Classes="muted" Text="Title" />
                                <TextBox Text="{Binding Title}" Width="130" AutomationProperties.Name="Menu title" />
                              </StackPanel>
                              <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" />
                              <StackPanel>
                                <TextBlock Classes="muted" Text="ID" />
                                <NumericUpDown Classes="mono" Value="{Binding Id}" FormatString="0" Width="68" ShowButtonSpinner="False"
                                               Minimum="-32768" Maximum="32767" AutomationProperties.Name="Menu ID" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Classes="muted" Text="MDEF" />
                                <NumericUpDown Classes="mono" Value="{Binding Definition}" FormatString="0" Width="68" ShowButtonSpinner="False"
                                               Minimum="-32768" Maximum="32767" AutomationProperties.Name="MDEF" />
                              </StackPanel>
                            </WrapPanel>
                            <StackPanel Classes="menu-table" Classes.editing="{Binding IsEditing}">
                              <Grid Classes="menu-columns read-only" ColumnDefinitions="28,*,52,84,40,120,60">
                                <TextBlock Classes="caption" Text="#" />
                                <TextBlock Grid.Column="1" Classes="caption" Text="TEXT" />
                                <TextBlock Grid.Column="2" Classes="caption" Text="⌘ KEY" />
                                <TextBlock Grid.Column="3" Classes="caption" Text="MARK" />
                                <TextBlock Grid.Column="4" Classes="caption" Text="ICON" />
                                <TextBlock Grid.Column="5" Classes="caption" Text="STYLE" />
                                <TextBlock Grid.Column="6" Classes="caption" Text="ENABLED" />
                              </Grid>
                              <Grid Classes="menu-columns editing" ColumnDefinitions="28,*,40,130,40,126,28,28">
                                <TextBlock x:Name="MenuTextCaption" Grid.Column="1" Classes="caption" Text="TEXT" />
                                <TextBlock Grid.Column="2" Classes="caption" Text="⌘ KEY" />
                                <TextBlock Grid.Column="3" Classes="caption" Text="MARK" />
                                <TextBlock Grid.Column="4" Classes="caption" Text="ICON" />
                                <TextBlock Grid.Column="5" Classes="caption" Text="STYLE" />
                                <TextBlock Grid.Column="6" Classes="caption" Text="ON" />
                              </Grid>
                              <ItemsControl x:Name="MenuRows" ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="vm:MenuItemRow">
                                    <Border Classes="table-row form-row" Classes.selected="{Binding IsSelected}" Classes.dimmed="{Binding IsDimmed}"
                                            Classes.divider="{Binding IsDivider}">
                                      <Panel>
                                        <Border Classes="bar" />
                                        <Grid Classes="read-only" ColumnDefinitions="28,*,52,84,40,120,60">
                                          <TextBlock Classes="muted mono" Text="{Binding Number}" />
                                          <TextBlock Grid.Column="1" Classes="item-text" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                          <StackPanel Grid.Column="1" Classes="divider-mark" Orientation="Horizontal" Spacing="8">
                                            <Border Classes="rule" />
                                            <TextBlock Classes="muted" Text="divider" />
                                          </StackPanel>
                                          <TextBlock Grid.Column="2" Classes="mono cell" Text="{Binding KeyText}" />
                                          <TextBlock Grid.Column="3" Classes="cell" Text="{Binding MarkText}" />
                                          <TextBlock Grid.Column="4" Classes="mono cell" Text="{Binding IconText}" />
                                          <TextBlock Grid.Column="5" Classes="cell" Text="{Binding StyleText}" TextTrimming="CharacterEllipsis" />
                                          <TextBlock Grid.Column="6" Classes="cell" Text="{Binding EnabledText}" />
                                        </Grid>
                                        <Grid Classes="editing" ColumnDefinitions="28,*,40,130,40,126,28,28">
                                          <StackPanel Classes="move">
                                            <!-- Chevron icons, not glyphs (boards/read-then-edit.md); Alt+Up and Alt+Down move the selected row. -->
                                            <Button Classes="flat row-tool" ToolTip.Tip="Move up (Alt+Up)" AutomationProperties.Name="Move up"
                                                    Command="{Binding $parent[ItemsControl].((vm:MenuForm)DataContext).MoveUpCommand}" CommandParameter="{Binding}">
                                              <PathIcon Classes="row-chevron" Data="M1,6.5 L5,2.5 L9,6.5 L7.6,7.9 L5,5.3 L2.4,7.9 Z" />
                                            </Button>
                                            <Button Classes="flat row-tool" ToolTip.Tip="Move down (Alt+Down)" AutomationProperties.Name="Move down"
                                                    Command="{Binding $parent[ItemsControl].((vm:MenuForm)DataContext).MoveDownCommand}" CommandParameter="{Binding}">
                                              <PathIcon Classes="row-chevron" Data="M1,3.5 L5,7.5 L9,3.5 L7.6,2.1 L5,4.7 L2.4,2.1 Z" />
                                            </Button>
                                          </StackPanel>
                                          <TextBox x:Name="MenuItemText" Grid.Column="1" Text="{Binding Text}" AutomationProperties.Name="Text" />
                                          <TextBox Grid.Column="2" Classes="mono key" Classes.conflict="{Binding HasKeyConflict}" Text="{Binding Key}"
                                                   HorizontalContentAlignment="Center" AutomationProperties.Name="Command key" />
                                          <!-- The marks in words; the list adds each one's Mac character code. Other… shows a code field. -->
                                          <Grid Grid.Column="3" ColumnDefinitions="*,Auto">
                                            <ComboBox Classes="mark" ItemsSource="{Binding MarkChoices}" SelectedItem="{Binding MarkChoice}" AutomationProperties.Name="Mark"
                                                      HorizontalAlignment="Stretch">
                                              <ComboBox.ItemTemplate>
                                                <DataTemplate DataType="vm:MarkChoice">
                                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Label}" />
                                                    <TextBlock Classes="mono muted" Text="{Binding Code}" />
                                                  </StackPanel>
                                                </DataTemplate>
                                              </ComboBox.ItemTemplate>
                                              <ComboBox.SelectionBoxItemTemplate>
                                                <DataTemplate DataType="vm:MarkChoice">
                                                  <TextBlock Text="{Binding ShortLabel}" />
                                                </DataTemplate>
                                              </ComboBox.SelectionBoxItemTemplate>
                                            </ComboBox>
                                            <TextBox Grid.Column="1" Classes="mono mark-code" Width="40" Margin="4,0,0,0" Text="{Binding MarkCode}"
                                                     IsVisible="{Binding IsOtherMark}" PlaceholderText="$2A" AutomationProperties.Name="Mark code" />
                                          </Grid>
                                          <NumericUpDown Grid.Column="4" Classes="mono" Value="{Binding Icon}" FormatString="0" ShowButtonSpinner="False"
                                                         Minimum="0" Maximum="255" AutomationProperties.Name="Icon" />
                                          <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2">
                                            <ToggleButton Classes="style-bit" Content="B" FontWeight="Bold" IsChecked="{Binding Bold}" ToolTip.Tip="Bold" />
                                            <ToggleButton Classes="style-bit" Content="I" FontStyle="Italic" IsChecked="{Binding Italic}" ToolTip.Tip="Italic" />
                                            <ToggleButton Classes="style-bit" ToolTip.Tip="Underline" IsChecked="{Binding Underline}">
                                              <TextBlock Text="U" TextDecorations="Underline" />
                                            </ToggleButton>
                                            <Button Classes="style-bit more" Classes.on="{Binding HasMoreStyles}" Content="More" ToolTip.Tip="Outline, Shadow, Condense, Extend">
                                              <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                  <StackPanel Spacing="4">
                                                    <CheckBox Content="Outline" IsChecked="{Binding Outline}" />
                                                    <CheckBox Content="Shadow" IsChecked="{Binding Shadow}" />
                                                    <CheckBox Content="Condense" IsChecked="{Binding Condense}" />
                                                    <CheckBox Content="Extend" IsChecked="{Binding Extend}" />
                                                  </StackPanel>
                                                </Flyout>
                                              </Button.Flyout>
                                            </Button>
                                          </StackPanel>
                                          <CheckBox Grid.Column="6" IsChecked="{Binding Enabled}" AutomationProperties.Name="Enabled" />
                                          <Button Grid.Column="7" Classes="flat row-tool remove" Content="×" ToolTip.Tip="Remove" AutomationProperties.Name="Remove"
                                                  Command="{Binding $parent[ItemsControl].((vm:MenuForm)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                      </Panel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <StackPanel Classes="editing" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Content="Add item" Command="{Binding AddCommand}" />
                                <Button Content="Add divider" Command="{Binding AddDividerCommand}" />
                              </StackPanel>
                            </StackPanel>
                          </StackPanel>
                        </ScrollViewer>
                      </Grid>
                    </DataTemplate>
                    <!-- The control form (E4): property cards like a window's. -->
                    <DataTemplate DataType="vm:ControlForm">
                      <ScrollViewer>
                        <StackPanel x:Name="ControlCards" Classes="cards">
                          <Border Classes="card">
                            <StackPanel>
                              <TextBlock Classes="card-title" Text="Bounds" />
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Top, left" />
                                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding TopLeftText}" IsVisible="{Binding !IsEditing}" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsEditing}">
                                    <NumericUpDown Value="{Binding Top}" FormatString="0" Classes="coord" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Top" />
                                    <NumericUpDown Value="{Binding Left}" FormatString="0" Classes="coord" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Left" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Bottom, right" />
                                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding BottomRightText}" IsVisible="{Binding !IsEditing}" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsEditing}">
                                    <NumericUpDown Value="{Binding Bottom}" FormatString="0" Classes="coord" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Bottom" />
                                    <NumericUpDown Value="{Binding Right}" FormatString="0" Classes="coord" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Right" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                              <Border Classes="card-line last">
                                <Grid Classes="card-row last" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Size" />
                                  <TextBlock Grid.Column="1" Text="{Binding SizeText}" />
                                </Grid>
                              </Border>
                            </StackPanel>
                          </Border>
                          <Border Classes="card">
                            <StackPanel>
                              <TextBlock Classes="card-title" Text="Control" />
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Title" />
                                  <TextBlock Grid.Column="1" Text="{Binding TitleText}" IsVisible="{Binding !IsEditing}" />
                                  <TextBox Grid.Column="1" Text="{Binding Title}" MinWidth="200" MaxWidth="320" HorizontalAlignment="Left" IsVisible="{Binding IsEditing}" />
                                </Grid>
                              </Border>
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Definition" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
                                    <TextBlock Text="{Binding DefinitionName}" />
                                    <TextBlock Classes="mono muted" Text="{Binding DefinitionCode}" />
                                  </StackPanel>
                                  <ComboBox Grid.Column="1" ItemsSource="{Binding Definitions}" SelectedItem="{Binding SelectedDefinition}" MinWidth="240" IsVisible="{Binding IsEditing}" />
                                </Grid>
                              </Border>
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Value" />
                                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding ValueText}" IsVisible="{Binding !IsEditing}" />
                                  <NumericUpDown Grid.Column="1" Value="{Binding Value}" FormatString="0" Classes="coord" HorizontalAlignment="Left" Minimum="-32768" Maximum="32767" IsVisible="{Binding IsEditing}" />
                                </Grid>
                              </Border>
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Minimum, maximum" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsEditing}">
                                    <TextBlock Classes="mono" Text="{Binding MinimumText}" />
                                    <TextBlock Classes="mono" Text="–" />
                                    <TextBlock Classes="mono" Text="{Binding MaximumText}" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsEditing}">
                                    <NumericUpDown Value="{Binding Minimum}" FormatString="0" Classes="coord" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Minimum" />
                                    <NumericUpDown Value="{Binding Maximum}" FormatString="0" Classes="coord" Minimum="-32768" Maximum="32767" AutomationProperties.Name="Maximum" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                              <Border Classes="card-line">
                                <Grid Classes="card-row form-row" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Visible" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsEditing}">
                                    <Ellipse Classes="dot" Classes.on="{Binding Visible}" />
                                    <TextBlock Text="{Binding VisibleText}" />
                                  </StackPanel>
                                  <CheckBox Grid.Column="1" IsChecked="{Binding Visible}" IsVisible="{Binding IsEditing}" AutomationProperties.Name="Visible" />
                                </Grid>
                              </Border>
                              <Border Classes="card-line last">
                                <Grid Classes="card-row form-row last" ColumnDefinitions="150,*">
                                  <TextBlock Classes="label" Text="Reference constant" />
                                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding RefConText}" IsVisible="{Binding !IsEditing}" />
                                  <NumericUpDown Grid.Column="1" Value="{Binding RefCon}" FormatString="0" Classes="coord wide" HorizontalAlignment="Left" Minimum="-2147483648" Maximum="2147483647" IsVisible="{Binding IsEditing}" />
                                </Grid>
                              </Border>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </ScrollViewer>
                    </DataTemplate>
                    <!-- The template form (boards/template-form.md, E6): the note banner, the fields in a card, each list as a
                         heading and item cards (a list inside an item as a compact table); the template panel on the right. -->
                    <DataTemplate DataType="vm:TemplateForm">
                      <Grid x:Name="TemplateCards" ColumnDefinitions="*,Auto">
                        <DockPanel>
                          <Border x:Name="TemplateNote" DockPanel.Dock="Top" Classes="note-banner" IsVisible="{Binding HasNote}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <views:SeverityIcon Severity="Warning" Width="14" Height="14" VerticalAlignment="Top" />
                              <TextBlock Text="{Binding Note}" TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <Border Classes="card">
                              <ItemsControl ItemsSource="{Binding Fields}" Margin="0,4" />
                            </Border>
                          </ScrollViewer>
                        </DockPanel>
                        <Border Grid.Column="1" Classes="template-panel">
                          <StackPanel Spacing="8">
                            <TextBlock Classes="caption" Text="TEMPLATE" />
                            <TextBlock Text="{Binding Source}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted note" Text="{x:Static vm:TemplateForm.SourceRule}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Outline}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TemplateOutlineLine">
                                  <Grid ColumnDefinitions="*,Auto" Margin="{Binding Indent, Converter={x:Static views:TemplateViews.Indent}}">
                                    <TextBlock Classes="outline" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Classes="outline muted" Text="{Binding Type}" Margin="8,0,0,0" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="muted note" Text="“Edit with template” off: the resource opens in Hex only." TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </DataTemplate>
                    <DataTemplate DataType="vm:TemplateScalarRow">
                      <Border Classes="card-line">
                        <Grid Classes="card-row form-row template-field" ColumnDefinitions="180,*,Auto">
                          <TextBlock Classes="label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                          <!-- Dock panels, not stack panels: a long value (a hex field) wraps within the column instead of
                               running under the type code. -->
                          <DockPanel Grid.Column="1" IsVisible="{Binding !IsEditing}">
                            <TextBlock DockPanel.Dock="Left" Classes="value" Classes.code="{Binding IsCode}" Text="{Binding DisplayText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <TextBlock Classes="muted count-note" Text="{Binding CountNote}" IsVisible="{Binding IsReadOnly}" Margin="8,0,0,0" />
                          </DockPanel>
                          <DockPanel Grid.Column="1" IsVisible="{Binding IsEditing}">
                            <Panel DockPanel.Dock="Left">
                              <TextBox Text="{Binding Text}" IsVisible="{Binding IsEditableText}" MinWidth="160" HorizontalAlignment="Left" TextWrapping="Wrap" AutomationProperties.Name="{Binding Label}" />
                              <CheckBox IsChecked="{Binding Flag}" IsVisible="{Binding IsFlag}" AutomationProperties.Name="{Binding Label}" />
                              <TextBlock Classes="value" Text="{Binding DisplayText}" IsVisible="{Binding IsReadOnly}" VerticalAlignment="Center" />
                            </Panel>
                            <TextBlock Classes="muted count-note" Text="{Binding CountNote}" IsVisible="{Binding IsReadOnly}" Margin="8,0,0,0" />
                          </DockPanel>
                          <TextBlock Grid.Column="2" Classes="type-code" Text="{Binding Type}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                    <DataTemplate DataType="vm:TemplateListRow">
                      <StackPanel Classes="template-list" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="list-heading" Text="{Binding Heading}" />
                          <TextBlock Classes="muted" Text="{Binding Summary}" VerticalAlignment="Center" />
                          <Button Content="{Binding AddLabel}" Command="{Binding AddCommand}" IsVisible="{Binding IsEditing}" />
                        </StackPanel>
                        <!-- Top-level lists: a card per item. -->
                        <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding !IsCompact}" />
                        <!-- A list inside an item: a compact table. -->
                        <StackPanel Classes="compact-table" IsVisible="{Binding IsCompact}">
                          <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <TextBlock Classes="caption table-cell" Text="{Binding}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="vm:TemplateItemRow">
                                <StackPanel Classes="form-row" Orientation="Horizontal">
                                  <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                      </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="vm:TemplateRow">
                                        <Panel Classes="table-cell">
                                          <TextBlock Text="{Binding $parent[Panel].((vm:TemplateScalarRow)DataContext).DisplayText, FallbackValue={x:Null}}"
                                                     IsVisible="{Binding !IsEditing}" />
                                          <TextBox Text="{Binding $parent[Panel].((vm:TemplateScalarRow)DataContext).Text, FallbackValue={x:Null}}"
                                                   IsVisible="{Binding IsEditing}" MinWidth="0" Width="104" />
                                        </Panel>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <Button Classes="link danger" Content="Remove" Command="{Binding List.RemoveCommand}" CommandParameter="{Binding}"
                                          IsVisible="{Binding List.IsEditing}" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="vm:TemplateItemRow">
                      <Border Classes="card item-card">
                        <StackPanel>
                          <Border Classes="item-header form-row">
                            <DockPanel>
                              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" IsVisible="{Binding List.IsEditing}">
                                <Button Classes="link" Content="Insert before" Command="{Binding List.InsertCommand}" CommandParameter="{Binding}" />
                                <Button Classes="link danger" Content="Remove" Command="{Binding List.RemoveCommand}" CommandParameter="{Binding}" />
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="muted" Text="{Binding Title}" />
                                <TextBlock Classes="item-key" Text="{Binding KeyText}" />
                                <TextBlock Classes="muted" Text="{Binding ItemSummary}" />
                              </StackPanel>
                            </DockPanel>
                          </Border>
                          <ItemsControl ItemsSource="{Binding Fields}" Margin="0,2" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ContentControl.DataTemplates>
                </ContentControl>
                </DockPanel>
                </Border>
              </DockPanel>
            </Panel>
          </TabItem>

          <TabItem Header="Hex" IsVisible="{Binding HasHex}">
            <!-- The hex view (boards/hex.md, E7): the resource's bytes in a grid, edited in place with Edit Hex (Ctrl+H) or
                 Edit Bytes; while editing, the byte inspector on the right and the footer with the mode switch, status,
                 Discard and Apply. -->
            <DockPanel x:Name="HexPane">
              <Border DockPanel.Dock="Top" Classes="hex-bar">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding EditActions.GoToError}" Classes="error" VerticalAlignment="Center"
                               IsVisible="{Binding EditActions.GoToError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="Go to" Classes="muted" VerticalAlignment="Center" />
                    <TextBox x:Name="GoToBox" Classes="go-to" PlaceholderText="0x0000" Text="{Binding EditActions.GoToText}" IsEnabled="{Binding EditActions.IsHexEditing}"
                             AutomationProperties.Name="Go to offset">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding EditActions.GoToCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                  </StackPanel>
                  <Panel HorizontalAlignment="Left">
                    <Button Content="Edit Bytes" Command="{Binding EditActions.BeginHexEditCommand}" IsVisible="{Binding !EditActions.IsHexEditing}" />
                    <Border Classes="editing-badge" IsVisible="{Binding EditActions.IsHexEditing}" VerticalAlignment="Center">
                      <TextBlock Text="Editing bytes" />
                    </Border>
                  </Panel>
                </DockPanel>
              </Border>
              <!-- Find (the hex board's follow-up): hex bytes or Mac OS Roman text; Enter finds the next, Shift+Enter the
                   previous; the match is selected or put under the cursor and highlighted. -->
              <Border x:Name="HexFindBar" DockPanel.Dock="Top" Classes="hex-find">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Find" Classes="muted" VerticalAlignment="Center" />
                  <ListBox x:Name="FindModeChoice" Classes="segmented" ItemsSource="{x:Static vm:HexFind.FindModes}"
                           SelectedIndex="{Binding HexFind.FindModeIndex, Mode=TwoWay}" AutomationProperties.Name="Find hex or text" />
                  <TextBox x:Name="FindBox" Classes="go-to find" PlaceholderText="Bytes or text" Text="{Binding HexFind.FindText}" AutomationProperties.Name="Find">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding HexFind.FindNextCommand}" />
                      <KeyBinding Gesture="Shift+Enter" Command="{Binding HexFind.FindPreviousCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <Button Content="Previous" Command="{Binding HexFind.FindPreviousCommand}" ToolTip.Tip="Shift+F3" />
                  <Button Content="Next" Command="{Binding HexFind.FindNextCommand}" ToolTip.Tip="F3" />
                  <TextBlock x:Name="FindStatusText" Text="{Binding HexFind.FindStatus}" Classes="muted" Classes.error="{Binding HexFind.FindFailed}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border x:Name="HexFooter" DockPanel.Dock="Bottom" Classes="host-footer" IsVisible="{Binding EditActions.IsHexEditing}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="Discard" Command="{Binding EditActions.DiscardHexEditCommand}" />
                    <Button Classes="accent" Content="Apply" Command="{Binding EditActions.ApplyHexEditCommand}" />
                  </StackPanel>
                  <ListBox x:Name="HexMode" DockPanel.Dock="Left" Classes="segmented" ItemsSource="{x:Static vm:HexEditor.Modes}"
                           SelectedIndex="{Binding EditActions.HexEdit.ModeIndex, Mode=TwoWay, FallbackValue=0}" AutomationProperties.Name="Overwrite or insert" />
                  <TextBlock Classes="hex-status" Text="{Binding EditActions.HexEdit.Status, FallbackValue={x:Null}}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </Border>
              <Border x:Name="HexInspector" DockPanel.Dock="Right" Classes="hex-inspector" IsVisible="{Binding EditActions.HexInspection, Converter={x:Static ObjectConverters.IsNotNull}}">
                <!-- Rows without spacing so the readings fit under the Find bar at 1200 × 780; "In this resource" scrolls. -->
                <!-- 10 on the right: the overlay scroll bar never covers the text. -->
                <ScrollViewer x:Name="HexInspectorScroll" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                <StackPanel Spacing="4">
                  <TextBlock Classes="caption" Text="{Binding EditActions.HexInspection.Heading, FallbackValue={x:Null}}" />
                  <ItemsControl ItemsSource="{Binding EditActions.HexInspection.Rows, FallbackValue={x:Null}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:HexReading">
                        <Grid ColumnDefinitions="72,*">
                          <TextBlock Text="{Binding Label}" Classes="muted" />
                          <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Spacing="4" Margin="0,12,0,0"
                              IsVisible="{Binding EditActions.HexInspection.Meaning, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                    <TextBlock Classes="caption" Text="IN THIS RESOURCE" />
                    <TextBlock Text="{Binding EditActions.HexInspection.Meaning.Text, FallbackValue={x:Null}}" TextWrapping="Wrap" />
                    <TextBlock Classes="mono" Text="{Binding EditActions.HexInspection.Meaning.Value, StringFormat='= {0}', FallbackValue={x:Null}}"
                               IsVisible="{Binding EditActions.HexInspection.Meaning.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
                  </StackPanel>
                </StackPanel>
                </ScrollViewer>
              </Border>
              <!-- As the read-then-edit host (E1): a 3 px CmAccent line over the values while editing. -->
              <Border x:Name="HexEditLine" DockPanel.Dock="Top" Height="3" Background="{DynamicResource CmAccent}" IsVisible="{Binding EditActions.IsHexEditing}" />
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Classes="hex-header">
                <TextBlock Classes="hex-offset" Text="Offset" />
                <ItemsControl ItemsSource="{x:Static vm:HexLines.HeaderCells}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:HexCell">
                      <Border Classes="hex-cell" Classes.group-end="{Binding IsGroupEnd}">
                        <TextBlock Text="{Binding Hex}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="hex-text" Text="Mac OS Roman" />
              </StackPanel>
              <ListBox x:Name="HexList" Classes="hex pane" Focusable="True" ItemsSource="{Binding HexLines, TargetNullValue={x:Static vm:HexLines.None}}" FontFamily="{StaticResource CmFontMono}" FontSize="13">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:HexLine">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Classes="hex-offset" Text="{Binding DisplayOffset}" />
                      <ItemsControl ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:HexCell">
                            <Border Classes="hex-cell" Classes.group-end="{Binding IsGroupEnd}" Classes.zero="{Binding IsZero}"
                                    Classes.in-field="{Binding IsInField}" Classes.selected="{Binding IsSelected}" Classes.match="{Binding IsMatch}"
                                    Classes.changed="{Binding IsChanged}" Classes.cursor="{Binding IsCursor}">
                              <TextBlock Text="{Binding Hex}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl ItemsSource="{Binding Cells}" Margin="12,0,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:HexCell">
                            <Border Classes="hex-char" Classes.in-field="{Binding IsInField}" Classes.selected="{Binding IsSelected}" Classes.match="{Binding IsMatch}"
                                    Classes.changed="{Binding IsChanged}" Classes.cursor="{Binding IsCursor}">
                              <TextBlock Text="{Binding Character}" Classes.muted="{Binding IsPlaceholder}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>
        </TabControl>
        </DockPanel>

        <!-- The empty state (boards/empty-state.md, S5): over the inspector while nothing is open. -->
        <Border x:Name="EmptyState" Grid.Column="2" Classes="empty-state" IsVisible="{Binding EmptyState.IsEmpty}">
          <ScrollViewer>
            <StackPanel Width="640" HorizontalAlignment="Center" Margin="0,40" Spacing="24">
              <Border x:Name="DropZone" Classes="drop-zone" Classes.active="{Binding EmptyState.IsDropTarget}">
                <Panel>
                  <Rectangle Classes="dash" />
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Spacing="14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                      <Image RenderOptions.BitmapInterpolationMode="None" Width="48" Height="48" Source="{Binding Source={x:Static vm:TreeIconKind.HardDisk}, Converter={x:Static views:TreeIcons.IconConverter}}" />
                      <Image RenderOptions.BitmapInterpolationMode="None" Width="48" Height="48" Source="{Binding Source={x:Static vm:TreeIconKind.Floppy}, Converter={x:Static views:TreeIcons.IconConverter}}" />
                      <Image RenderOptions.BitmapInterpolationMode="None" Width="48" Height="48" Source="{Binding Source={x:Static vm:TreeIconKind.Parcel}, Converter={x:Static views:TreeIcons.IconConverter}}" />
                      <Image RenderOptions.BitmapInterpolationMode="None" Width="48" Height="48" Source="{Binding Source={x:Static vm:TreeIconKind.Application}, Converter={x:Static views:TreeIcons.IconConverter}}" />
                    </StackPanel>
                    <TextBlock Classes="empty-title" Text="Drop a Mac file, disk image or archive here" />
                    <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                               Text="HFS and HFS+ volume images, archives, MacBinary, BinHex, AppleSingle and AppleDouble files, or a file with its resource fork. ClassicMac shows everything inside, down to single resources." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                      <Button Classes="accent" Content="Open…" Command="{Binding OpenCommand}" />
                      <TextBlock Classes="mono muted" Text="Ctrl+O" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Panel>
              </Border>
              <StackPanel x:Name="RecentList" Spacing="8" IsVisible="{Binding EmptyState.HasRecentFiles}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="flat link" Content="Clear list" Command="{Binding EmptyState.ClearRecentCommand}" />
                  <TextBlock Classes="caption" Text="RECENT" VerticalAlignment="Center" />
                </DockPanel>
                <Border Classes="recent-list">
                  <ItemsControl ItemsSource="{Binding EmptyState.RecentFiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:RecentFile">
                        <Button Classes="flat recent" Command="{Binding #EmptyState.((vm:MainViewModel)DataContext).EmptyState.OpenRecentCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="{Binding Path}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image RenderOptions.BitmapInterpolationMode="None" Width="16" Height="16" Source="{Binding IconKind, Converter={x:Static views:TreeIcons.IconConverter}}" />
                            <TextBlock Text="{Binding Name}" Classes.muted="{Binding !Exists}" VerticalAlignment="Center" />
                            <TextBlock Classes="muted" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" MaxWidth="380" VerticalAlignment="Center" />
                            <TextBlock Classes="muted" Text="Not found" IsVisible="{Binding !Exists}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- The drag handle: a 6 px strip with a 36 x 2 grip; hidden while the panel is collapsed. -->
      <GridSplitter Grid.Row="1" Classes="handle" ResizeDirection="Rows" IsVisible="{Binding DiagnosticsPanel.IsExpanded}"
                    AutomationProperties.Name="Resize the diagnostics" />

      <!-- The diagnostics panel (design/boards/diagnostics.md): header bar, column headers, rows grouped by file. -->
      <DockPanel Grid.Row="2" DataContext="{Binding DiagnosticsPanel}" x:DataType="vm:DiagnosticsPanel">
        <Border DockPanel.Dock="Top" Classes="chrome diagnostics-header" Classes.collapsed="{Binding !IsExpanded}"
                Height="{DynamicResource CmPanelHeader}" Padding="4,0,8,0" BorderBrush="{DynamicResource CmBorder}">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Left" Classes="flat" IsChecked="{Binding IsExpanded, Mode=TwoWay}" VerticalAlignment="Center"
                          ToolTip.Tip="Show or hide the diagnostics (Ctrl+Shift+D)" AutomationProperties.Name="Diagnostics">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Classes="chevron" Width="10" Height="10" Data="M2,4 L5,7 L8,4" />
                <TextBlock Text="Diagnostics" FontWeight="{DynamicResource CmFontWeightStrong}" />
              </StackPanel>
            </ToggleButton>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0" VerticalAlignment="Center">
              <Border Classes="badge error" IsVisible="{Binding HasErrors}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <views:SeverityIcon Severity="Error" Width="12" Height="12" />
                  <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding IsExpanded}" />
                  <TextBlock Text="{Binding ErrorCount}" IsVisible="{Binding !IsExpanded}" />
                </StackPanel>
              </Border>
              <Border Classes="badge warning" IsVisible="{Binding HasWarnings}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <views:SeverityIcon Severity="Warning" Width="12" Height="12" />
                  <TextBlock Text="{Binding WarningText}" IsVisible="{Binding IsExpanded}" />
                  <TextBlock Text="{Binding WarningCount}" IsVisible="{Binding !IsExpanded}" />
                </StackPanel>
              </Border>
              <!-- Collapsed, only the error and warning numbers show. -->
              <Border Classes="badge info">
                <Border.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsExpanded" />
                    <Binding Path="HasInfos" />
                  </MultiBinding>
                </Border.IsVisible>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <views:SeverityIcon Severity="Info" Width="12" Height="12" />
                  <TextBlock Text="{Binding InfoText}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsExpanded}">
              <TextBox Width="200" Height="26" MinHeight="0" Padding="8,3" PlaceholderText="Filter messages" Text="{Binding Search, Mode=TwoWay}"
                       AutomationProperties.Name="Filter messages" />
              <ListBox Classes="segmented" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}" VerticalAlignment="Center">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:DiagnosticFilter">
                    <TextBlock Text="{Binding Converter={x:Static views:DiagnosticsLabels.Filter}}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <ToggleButton Classes="flat outlined" Content="By file" IsChecked="{Binding ByFile, Mode=TwoWay}" />
            </StackPanel>
            <!-- Collapsed with nothing open: "Nothing opened yet" (boards/empty-state.md). -->
            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Classes="muted" Text="{Binding Placeholder}">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="!IsExpanded" />
                  <Binding Path="Placeholder" Converter="{x:Static ObjectConverters.IsNotNull}" />
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <!-- Collapsed: the latest problem. -->
            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" Classes="muted">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="!IsExpanded" />
                  <Binding Path="HasLatest" />
                </MultiBinding>
              </TextBlock.IsVisible>
              <Run Text="Latest: " /><Run Text="{Binding Latest.Code, FallbackValue={x:Null}}" Foreground="{DynamicResource CmError}"
                   FontFamily="{DynamicResource CmFontMono}" /><Run Text=" " /><Run Text="{Binding LatestPlace}" />
            </TextBlock>
          </DockPanel>
        </Border>

        <!-- Column headers. -->
        <Border DockPanel.Dock="Top" Classes="pane" Height="26" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CmDivider}"
                IsVisible="{Binding IsExpanded}">
          <Grid ColumnDefinitions="110,260,210,*,90" Classes.grouped="{Binding ByFile}" Classes="diagnostic-columns">
            <Button Classes="flat" Padding="0" VerticalAlignment="Center" Command="{Binding SortBySeverityCommand}"
                    ToolTip.Tip="Sort by severity" AutomationProperties.Name="Sort by severity">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="caption" Text="SEVERITY" />
                <TextBlock Classes="caption" Text="{Binding Sort, Converter={x:Static views:DiagnosticsLabels.Sort}}" />
              </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Classes="caption" Text="SOURCE" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="caption" Text="CODE" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Classes="caption" Text="MESSAGE" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <ListBox x:Name="DiagnosticList" Classes="pane diagnostics" Classes.grouped="{Binding ByFile}" IsVisible="{Binding IsExpanded}"
                 ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:DiagnosticGroup">
              <Border Classes="sidebar diagnostic-group">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <PathIcon Classes="chevron" Classes.collapsed="{Binding !IsExpanded}" Width="10" Height="10" Data="M2,4 L5,7 L8,4" />
                  <Image Width="16" Height="16" RenderOptions.BitmapInterpolationMode="None" Source="{Binding Kind, Converter={x:Static views:TreeIcons.KindConverter}}" />
                  <TextBlock Text="{Binding Path}" FontWeight="{DynamicResource CmFontWeightStrong}" />
                  <TextBlock Text="{Binding Counts}" Classes="muted" />
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:DiagnosticEntry">
              <Border Classes="diagnostic-row">
                <Grid ColumnDefinitions="110,260,210,*,90" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <views:SeverityIcon Severity="{Binding Diagnostic.Severity}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Severity}" FontWeight="{DynamicResource CmFontWeightStrong}"
                               Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}" Classes.info="{Binding IsInfo}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Source}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="2" Classes="mono muted" Text="{Binding Code}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="3" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                  <!-- On the selected row only (style), for an entry with a node. -->
                  <Panel Grid.Column="4" IsVisible="{Binding HasNode}">
                    <Button Classes="link show-item" Content="Show item" HorizontalAlignment="Right"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowItemCommand, FallbackValue={x:Null}}"
                            CommandParameter="{Binding}" ToolTip.Tip="Select it in the tree" />
                  </Panel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
