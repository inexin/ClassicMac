<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Packed inside the ClassicMac.Formats package (src/ClassicMac.Formats), not on its own. -->
    <IsPackable>false</IsPackable>
    <!-- Its symbols travel inside the DLL: a package that carries other projects' assemblies has no symbol package. -->
    <DebugType>embedded</DebugType>
    <Description>Classic Mac OS files as the Mac saw them (name, Finder info, dates, data and resource forks) and every container that carries them, through any nesting: AppleSingle, AppleDouble, MacBinary, BinHex, Basilisk II folders; StuffIt, Compact Pro, DiskDoubler, PackIt, LHA, zip and tar archives; Disk Copy, NDIF, DART and UDIF images, partition maps and CDs; HFS, HFS Plus, MFS, ISO 9660 and FAT file systems. Writes the wrappers and HFS volumes, and checks and repairs HFS and HFS Plus volumes (First Aid).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassicMac.Core\ClassicMac.Core.csproj" />
    <ProjectReference Include="..\ClassicMac.Resources\ClassicMac.Resources.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClassicMac.Files.Tests" />
    <!-- HfsBuilder (linked into these) orders catalog records with HfsCatalogKeys.CompareCatalogKeys. -->
    <InternalsVisibleTo Include="ClassicMac.App.Tests" />
    <InternalsVisibleTo Include="ClassicMac.Cli.Tests" />
    <!-- tools/Fuzz links HfsPlusBuilder (its seeds), which writes B-trees with the internal writers. -->
    <InternalsVisibleTo Include="Fuzz" />
  </ItemGroup>

</Project>
