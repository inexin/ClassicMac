<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ClassicMac.Files</PackageId>
    <Description>Classic Mac OS files as the Mac saw them (name, Finder info, dates, data and resource forks) and the single-file containers that carry them: AppleSingle, AppleDouble, MacBinary, BinHex and Basilisk II shared folders.</Description>
    <PackageTags>macintosh;classic-mac;finder-info;macbinary;binhex;appledouble;applesingle</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassicMac.Core\ClassicMac.Core.csproj" />
    <ProjectReference Include="..\ClassicMac.Resources\ClassicMac.Resources.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClassicMac.Files.Tests" />
  </ItemGroup>

</Project>
