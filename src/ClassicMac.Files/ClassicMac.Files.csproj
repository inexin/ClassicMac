<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ClassicMac.Files</PackageId>
    <Description>Classic Mac OS files as the Mac saw them (name, Finder info, dates, data and resource forks) and the containers that carry them: AppleSingle, AppleDouble, MacBinary, BinHex, StuffIt, zip, tar and Basilisk II shared folders.</Description>
    <PackageTags>macintosh;classic-mac;finder-info;macbinary;binhex;stuffit;zip;tar;appledouble;applesingle</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassicMac.Core\ClassicMac.Core.csproj" />
    <ProjectReference Include="..\ClassicMac.Resources\ClassicMac.Resources.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClassicMac.Files.Tests" />
    <!-- HfsBuilder (linked into these) orders catalog records with HfsCatalogKeys.CompareCatalogKeys. -->
    <InternalsVisibleTo Include="ClassicMac.App.Tests" />
    <InternalsVisibleTo Include="ClassicMac.Cli.Tests" />
    <!-- tools/Fuzz links HfsPlusBuilder (its seeds), which writes B-trees with the internal writers. -->
    <InternalsVisibleTo Include="Fuzz" />
  </ItemGroup>

</Project>
