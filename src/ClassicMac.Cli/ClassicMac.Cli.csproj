<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>classicmac</ToolCommandName>
    <AssemblyName>classicmac</AssemblyName>
    <PackageId>ClassicMac.Cli</PackageId>
    <Description>Command-line tool for classic Mac OS files, whatever they are wrapped in: list, unpack, extract resources into modern files with a manifest, convert documents, disassemble code, rebuild resource forks, browse and edit disk images by Mac path, check and repair HFS volumes; also an MCP server and a DOS-like shell.</Description>
    <PackageTags>macintosh;classic-mac;resource-fork;rsrc;cli;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassicMac.Files\ClassicMac.Files.csproj" />
    <ProjectReference Include="..\ClassicMac.Resources\ClassicMac.Resources.csproj" />
    <ProjectReference Include="..\ClassicMac.Resources.Decoders\ClassicMac.Resources.Decoders.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClassicMac.Cli.Tests" />
  </ItemGroup>

</Project>
