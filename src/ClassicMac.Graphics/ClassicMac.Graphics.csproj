<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ClassicMac.Graphics</PackageId>
    <Description>The base of the ClassicMac graphics stack: the RGBA bitmap, colours and rectangles, PixMap layouts and their unpacking, the standard colour tables, PackBits, and MacPaint documents. No dependencies.</Description>
    <PackageTags>macintosh;classic-mac;quickdraw;pixmap;macpaint;image</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassicMac.Core\ClassicMac.Core.csproj" />
  </ItemGroup>

  <!-- Until the renderer has a public drawing API (the merge's stage 3), the layers above share internals. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ClassicMac.QuickTime" />
    <InternalsVisibleTo Include="ClassicMac.QuickDraw" />
    <InternalsVisibleTo Include="ClassicMac.Pict" />
    <InternalsVisibleTo Include="ClassicMac.ImageSharp" />
    <InternalsVisibleTo Include="ClassicMac.SkiaSharp" />
    <InternalsVisibleTo Include="ClassicMac.Resources.Decoders" />
    <InternalsVisibleTo Include="ClassicMac.Pict.Tests" />
  </ItemGroup>

</Project>
