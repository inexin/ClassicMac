<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ClassicMac.Graphics</PackageId>
    <Description>Classic Mac OS graphics that draw exactly the pixels a Macintosh draws: a software QuickDraw (Mac OS 9 or the 68k ROM: regions, shapes, patterns, transfer modes, CopyBits scaling, text, 1-16 bit screen depths), the PICT reader and writer, QuickTime still images and their codecs, QTIF and MacPaint files, and the Font Manager's resources (NFNT, FONT, FOND, fctb, sfnt). No dependencies beyond ClassicMac.Core.</Description>
    <PackageTags>macintosh;classic-mac;quickdraw;pict;quicktime;macpaint;font;image;decoder;encoder</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassicMac.Core\ClassicMac.Core.csproj" />
  </ItemGroup>

  <!-- Until the renderer has a public drawing API, the decoders and the adapters share its internals. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ClassicMac.ImageSharp" />
    <InternalsVisibleTo Include="ClassicMac.SkiaSharp" />
    <InternalsVisibleTo Include="ClassicMac.Resources.Decoders" />
    <InternalsVisibleTo Include="ClassicMac.Graphics.Tests" />
  </ItemGroup>

</Project>
